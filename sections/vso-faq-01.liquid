<div class="vso-node section-{{ section_id }}-container color-{{ color_scheme }} gradient vso-faq-{{ section_id }} vso-hidden">
  <div class="section-{{ section_id }}-content">
    <div class="versio-faq">
      {% if heading != blank %}
        <div class="versio-faq__title">
          {% if heading_custom %}
            <{{ heading_as }}>{{ heading }}</{{ heading_as }}>
          {% else %}
            <{{ heading_as }} style="color: rgb({{ fg_color_rgb }});">{{ heading }}</{{ heading_as }}>
          {% endif %}
        </div>
      {% endif %}

      <div class="versio-faq__grid">
        <div class="versio-faq__column">
          {%- for block in section.blocks -%}
            {% assign item_index = forloop.index0 | modulo: 2 %}
            {% if item_index == 0 %}
              <div class="versio-faq__item" {{ block.shopify_attributes }} id="faq-item-{{ block.id }}">
                <div class="versio-faq__question" tabindex="0" role="button" aria-expanded="false" aria-controls="faq-answer-{{ block.id }}" style="color: rgb({{ fg_color_rgb }});">
                  <{{ question_as }}>{{ block.settings.question }}</{{ question_as }}>
                  <div class="versio-faq__toggle" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 5V19M5 12H19" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                </div>
                <div class="versio-faq__answer" id="faq-answer-{{ block.id }}">
                  <{{ answer_as }} class="versio-faq__answer-content" style="color: rgb({{ fg_color_rgb }});">
                    {{ block.settings.answer }}
                  </{{ answer_as }}>
                </div>
              </div>
            {% endif %}
          {%- endfor -%}
        </div>

        <div class="versio-faq__column">
          {%- for block in section.blocks -%}
            {% assign item_index = forloop.index0 | modulo: 2 %}
            {% if item_index == 1 %}
              <div class="versio-faq__item" {{ block.shopify_attributes }} id="faq-item-{{ block.id }}">
                <div class="versio-faq__question" tabindex="0" role="button" aria-expanded="false" aria-controls="faq-answer-{{ block.id }}" style="color: rgb({{ fg_color_rgb }});">
                  <{{ question_as }}>{{ block.settings.question }}</{{ question_as }}>
                  <div class="versio-faq__toggle" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 5V19M5 12H19" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                </div>
                <div class="versio-faq__answer" id="faq-answer-{{ block.id }}">
                  <{{ answer_as }} class="versio-faq__answer-content" style="color: rgb({{ fg_color_rgb }});">
                    {{ block.settings.answer }}
                  </{{ answer_as }}>
                </div>
              </div>
            {% endif %}
          {%- endfor -%}
        </div>
      </div>

      <div class="versio-faq__grid--mobile">
        {%- for block in section.blocks -%}
          <div class="versio-faq__item" {{ block.shopify_attributes }} id="faq-item-mobile-{{ block.id }}">
            <div class="versio-faq__question" tabindex="0" role="button" aria-expanded="false" aria-controls="faq-answer-mobile-{{ block.id }}" style="color: rgb({{ fg_color_rgb }});">
              <{{ question_as }}>{{ block.settings.question }}</{{ question_as }}>
              <div class="versio-faq__toggle" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 5V19M5 12H19" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </div>
            <div class="versio-faq__answer" id="faq-answer-mobile-{{ block.id }}">
              <{{ answer_as }} class="versio-faq__answer-content" style="color: rgb({{ fg_color_rgb }});">
                {{ block.settings.answer }}
              </{{ answer_as }}>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const accordionItems = document.querySelectorAll('.vso-faq-{{ section_id }} .versio-faq__item');

    function closeAllItems() {
      accordionItems.forEach(item => {
        const answer = item.querySelector('.versio-faq__answer');
        const question = item.querySelector('.versio-faq__question');
        const svg = question.querySelector('.versio-faq__toggle svg');

        item.classList.remove('active');
        question.setAttribute('aria-expanded', 'false');
        answer.style.height = '0px';

        if (svg) {
          svg.innerHTML = '<path d="M12 5V19M5 12H19" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/>';
        }
      });
    }

    function toggleItem(item) {
      const isActive = item.classList.contains('active');
      const answer = item.querySelector('.versio-faq__answer');
      const question = item.querySelector('.versio-faq__question');
      const svg = question.querySelector('.versio-faq__toggle svg');

      if (isActive) {
        item.classList.remove('active');
        question.setAttribute('aria-expanded', 'false');
        answer.style.height = '0px';
        if (svg) {
          svg.innerHTML = '<path d="M12 5V19M5 12H19" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/>';
        }
      } else {
        closeAllItems();
        item.classList.add('active');
        question.setAttribute('aria-expanded', 'true');
        answer.style.height = answer.scrollHeight + 'px';
        if (svg) {
          svg.innerHTML = '<path d="M5 12H19" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/>';
        }
      }
    }

    accordionItems.forEach(item => {
      const question = item.querySelector('.versio-faq__question');
      if (question) {
        question.addEventListener('click', function() { toggleItem(item); });
        question.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            toggleItem(item);
          }
        });
      }
    });
  });
</script>

{% schema %}
{
  "name": "VSO - FAQ 01",
  "class": "section versio-section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },

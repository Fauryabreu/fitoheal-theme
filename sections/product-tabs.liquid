<style>
  .fh-pt { background-color: {{ section.settings.bg_color }}; padding: clamp(3rem, 6vw, 5rem) 0; }
  .fh-pt__layout {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 3rem;
    align-items: start;
  }
  .fh-pt__sidebar { position: sticky; top: 120px; }
  .fh-pt__sidebar-title {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--color-text-dark);
    line-height: 1.25;
    margin: 0 0 1rem;
  }
  .fh-pt__sidebar-desc {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0 0 1.5rem;
  }
  .fh-tabs-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin-bottom: 2rem;
    border-bottom: 2px solid var(--color-border);
  }
  .fh-tab-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.625rem 1.25rem;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
    transition: color 200ms, border-color 200ms;
    text-transform: capitalize;
    white-space: nowrap;
    min-height: 44px;
  }
  .fh-tab-btn.is-active,
  .fh-tab-btn:hover {
    color: var(--color-brand-primary);
    border-bottom-color: var(--color-brand-primary);
    font-weight: 600;
  }
  .fh-tab-panel { display: none; }
  .fh-tab-panel.is-active {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  /* Card */
  .fh-pc-link {
    display: block;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }
  .fh-pc {
    background: var(--color-white);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 220ms ease-out, box-shadow 220ms ease-out;
    height: 100%;
  }
  .fh-pc-link:hover .fh-pc { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  .fh-pc__img-wrap {
    position: relative;
    background: #f6fbf8;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 200px;
    overflow: hidden;
  }
  .fh-pc__img-wrap img {
    width: 100%;
    height: 200px;
    object-fit: contain;
    display: block;
  }
  .fh-pc__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: rgba(116,198,157,0.2);
    color: var(--color-brand-primary);
    border: 1px solid rgba(116,198,157,0.4);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 999px;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .fh-pc__body {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    flex: 1;
  }
  .fh-pc__name {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-dark);
    margin: 0;
    line-height: 1.3;
  }
  .fh-pc__desc {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
    flex: 1;
  }
  .fh-pc__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }
  .fh-pc__price {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-brand-primary);
  }
  .fh-pc__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-brand-medium);
    text-decoration: none;
    white-space: nowrap;
  }
  .fh-pc-link:hover .fh-pc__link { text-decoration: underline; }
  /* Mobile */
  @media (max-width: 768px) {
    .fh-pt { overflow-x: hidden; }
    .fh-pt__layout { display: block; }
    .fh-pt__sidebar { position: static; margin-bottom: 1.5rem; }
    .fh-pt__sidebar-title { font-size: 1.375rem; line-height: 1.2; }
    .fh-pt__sidebar-desc { font-size: 0.875rem; }
    .fh-tabs-nav {
      flex-wrap: wrap;
      overflow-x: visible;
      white-space: normal;
      border-bottom: none;
      gap: 0.5rem;
      margin-bottom: 1.25rem;
      padding-bottom: 0;
    }
    .fh-tab-btn {
      border: 1px solid var(--color-border);
      border-radius: 100px;
      border-bottom-color: var(--color-border);
      margin-bottom: 0;
      font-size: 0.8125rem;
      padding: 0.5rem 1rem;
      white-space: nowrap;
    }
    .fh-tab-btn.is-active {
      background: var(--color-brand-primary);
      color: #fff;
      border-color: var(--color-brand-primary);
    }
    .fh-tab-panel.is-active { grid-template-columns: 1fr; gap: 16px; }
    .fh-pc__img-wrap { height: auto; aspect-ratio: 1 / 1; }
    .fh-pc__img-wrap img { height: 100%; object-fit: cover; }
    .fh-pc__body { padding: 0.875rem; }
    .fh-pc__footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: auto;
      padding-top: 0.625rem;
      gap: 0.5rem;
    }
    .fh-pc__price { font-size: 0.9375rem; font-weight: 700; white-space: nowrap; }
    .fh-pc__link { font-size: 0.8125rem; white-space: nowrap; }
  }
</style>

<section id="shopify-section-{{ section.id }}" class="fh-pt">
  <div class="page-width">
    <div class="fh-pt__layout">

      <!-- Sidebar -->
      <aside class="fh-pt__sidebar">
        {%- if section.settings.titulo != blank -%}
          <h2 class="fh-pt__sidebar-title">{{ section.settings.titulo }}</h2>
        {%- endif -%}
        {%- if section.settings.descripcion != blank -%}
          <p class="fh-pt__sidebar-desc">{{ section.settings.descripcion }}</p>
        {%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_link | default: '#' }}" class="fh-btn fh-btn--outline">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
      </aside>

      <!-- Tabs -->
      <div>
        <!-- Tab nav -->
        <div class="fh-tabs-nav" role="tablist">
          {%- for block in section.blocks -%}
            {%- if block.type == 'tab' -%}
              <button
                id="fh-tab-{{ block.id }}"
                class="fh-tab-btn{% if forloop.first %} is-active{% endif %}"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-controls="fh-tp-{{ block.id }}"
                data-tab="{{ block.id }}"
                {{ block.shopify_attributes }}
              >{{ block.settings.label }}</button>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <!-- Tab panels -->
        {%- for block in section.blocks -%}
          {%- if block.type == 'tab' -%}
            <div
              id="fh-tp-{{ block.id }}"
              class="fh-tab-panel{% if forloop.first %} is-active{% endif %}"
              role="tabpanel"
              aria-labelledby="fh-tab-{{ block.id }}"
            >
              {%- assign tab_products = block.settings.product_1, block.settings.product_2, block.settings.product_3 -%}
              {%- for prod in tab_products -%}
                {%- if prod != blank -%}
                  <a href="{{ prod.url }}" class="fh-pc-link">
                    <div class="fh-pc">
                      <div class="fh-pc__img-wrap">
                        {%- if prod.featured_image -%}
                          <img
                            src="{{ prod.featured_image | image_url: width: 400 }}"
                            alt="{{ prod.title | escape }}"
                            loading="lazy"
                            width="400"
                            height="400"
                          >
                        {%- else -%}
                          {{ 'product-1' | placeholder_svg_tag }}
                        {%- endif -%}
                        {%- if block.settings.badge != blank -%}
                          <span class="fh-pc__badge">{{ block.settings.badge }}</span>
                        {%- endif -%}
                      </div>
                      <div class="fh-pc__body">
                        <h4 class="fh-pc__name">{{ prod.title }}</h4>
                        {%- if prod.description != blank -%}
                          <p class="fh-pc__desc">{{ prod.description | strip_html | truncate: 90 }}</p>
                        {%- endif -%}
                        <div class="fh-pc__footer">
                          <span class="fh-pc__price">{{ prod.price_min | money }}</span>
                          <span class="fh-pc__link">Ver producto →</span>
                        </div>
                      </div>
                    </div>
                  </a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

    </div>
  </div>
</section>

<script>
(function(){
  var wrap = document.getElementById('shopify-section-{{ section.id }}');
  if (!wrap) return;
  var btns   = wrap.querySelectorAll('.fh-tab-btn');
  var panels = wrap.querySelectorAll('.fh-tab-panel');
  btns.forEach(function(btn){
    btn.addEventListener('click', function(){
      btns.forEach(function(b){ b.classList.remove('is-active'); b.setAttribute('aria-selected','false'); });
      panels.forEach(function(p){ p.classList.remove('is-active'); });
      btn.classList.add('is-active');
      btn.setAttribute('aria-selected','true');
      var panel = wrap.querySelector('#fh-tp-' + btn.dataset.tab);
      if (panel) panel.classList.add('is-active');
    });
  });
})();
</script>

{% schema %}
{
  "name": "Product Tabs",
  "tag": "section",
  "settings": [
    { "type": "color",    "id": "bg_color",    "label": "Fondo",           "default": "#FAFDF8" },
    { "type": "header",   "content": "Sidebar" },
    { "type": "text",     "id": "titulo",      "label": "Título sidebar",  "default": "Soluciones liposomales para cada objetivo" },
    { "type": "textarea", "id": "descripcion", "label": "Descripción",     "default": "Tecnología liposomal de alta absorción que favorece el aprovechamiento de los nutrientes y acompaña tu bienestar día a día." },
    { "type": "text",     "id": "cta_label",   "label": "Texto botón CTA", "default": "Conoce nuestra línea" },
    { "type": "url",      "id": "cta_link",    "label": "Link CTA" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab de productos",
      "settings": [
        { "type": "text",    "id": "label",     "label": "Nombre del tab",  "default": "descanso" },
        { "type": "product", "id": "product_1", "label": "Producto 1" },
        { "type": "product", "id": "product_2", "label": "Producto 2" },
        { "type": "product", "id": "product_3", "label": "Producto 3" },
        { "type": "text",    "id": "badge",     "label": "Badge en cards",  "default": "Alta absorción X5" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Product Tabs",
      "blocks": [
        { "type": "tab", "settings": { "label": "descanso",    "badge": "Alta absorción X5" } },
        { "type": "tab", "settings": { "label": "digestión",   "badge": "Alta absorción X5" } },
        { "type": "tab", "settings": { "label": "enfoque",     "badge": "Alta absorción X5" } },
        { "type": "tab", "settings": { "label": "metabolismo", "badge": "Alta absorción X5" } }
      ]
    }
  ]
}
{% endschema %}

<section id="shopify-section-{{ section.id }}" class="fh-product-tabs" style="background-color:{{ section.settings.bg_color }};">
  <div class="page-width">
    <div class="fh-product-tabs__layout">

      <!-- Sidebar izquierda -->
      <aside class="fh-product-tabs__sidebar">
        {% if section.settings.titulo != blank %}
          <h2 class="fh-product-tabs__sidebar-title">{{ section.settings.titulo }}</h2>
        {% endif %}
        {% if section.settings.descripcion != blank %}
          <p class="fh-product-tabs__sidebar-desc">{{ section.settings.descripcion }}</p>
        {% endif %}
        {% if section.settings.cta_label != blank %}
          <a href="{{ section.settings.cta_link | default: '#' }}" class="fh-btn fh-btn--outline">{{ section.settings.cta_label }}</a>
        {% endif %}
      </aside>

      <!-- Contenido derecha -->
      <div>
        <!-- Tabs nav -->
        {% assign tab_blocks = section.blocks | where: 'type', 'tab' %}
        {% if tab_blocks.size > 0 %}
          <div class="fh-tabs-nav" role="tablist">
            {% for block in tab_blocks %}
              <button
                class="fh-tab-btn{% if forloop.first %} is-active{% endif %}"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-controls="fh-tab-panel-{{ block.id }}"
                id="fh-tab-{{ block.id }}"
                data-tab="{{ block.id }}"
                {{ block.shopify_attributes }}
              >{{ block.settings.label }}</button>
            {% endfor %}
          </div>

          <!-- Tab panels -->
          {% for tab_block in tab_blocks %}
            <div
              id="fh-tab-panel-{{ tab_block.id }}"
              class="fh-tab-panel{% if forloop.first %} is-active{% endif %}"
              role="tabpanel"
              aria-labelledby="fh-tab-{{ tab_block.id }}"
            >
              {% comment %} Productos de colección asignada {% endcomment %}
              {% if tab_block.settings.collection != blank %}
                {% assign col = collections[tab_block.settings.collection] %}
                {% assign limit_n = tab_block.settings.limit | default: 3 %}
                {% for product in col.products limit: limit_n %}
                  <article class="fh-product-card">
                    <a href="{{ product.url }}" class="fh-product-card__img">
                      {% if product.featured_image %}
                        {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.title }}
                      {% else %}
                        {{ 'product-1' | placeholder_svg_tag }}
                      {% endif %}
                      {% if tab_block.settings.badge != blank %}
                        <span class="fh-product-card__badge">{{ tab_block.settings.badge }}</span>
                      {% endif %}
                    </a>
                    <div class="fh-product-card__body">
                      <p class="fh-product-card__name">{{ product.title }}</p>
                      {% if product.description != blank %}
                        <p class="fh-product-card__desc">{{ product.description | strip_html | truncate: 90 }}</p>
                      {% endif %}
                      <div class="fh-product-card__rating">
                        <span class="fh-product-card__stars">★★★★★</span>
                        <span class="fh-product-card__review-count">({{ product.metafields.reviews.rating_count | default: '—' }})</span>
                      </div>
                      <div class="fh-product-card__footer">
                        <span class="fh-product-card__price">Desde {{ product.price | money }}</span>
                        <a href="{{ product.url }}" class="fh-product-card__link">Ver producto →</a>
                      </div>
                    </div>
                  </article>
                {% endfor %}
              {% endif %}

              {% comment %} Productos manuales: blocks tipo 'product' con tab_id == tab_block.id {% endcomment %}
              {% for prod_block in section.blocks %}
                {% if prod_block.type == 'product' and prod_block.settings.tab_id == tab_block.id %}
                  {% assign prod = prod_block.settings.product %}
                  {% if prod != blank %}
                    <article class="fh-product-card" {{ prod_block.shopify_attributes }}>
                      <a href="{{ prod.url }}" class="fh-product-card__img">
                        {% if prod.featured_image %}
                          {{ prod.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: prod.title }}
                        {% else %}
                          {{ 'product-1' | placeholder_svg_tag }}
                        {% endif %}
                        {% if prod_block.settings.badge != blank %}
                          <span class="fh-product-card__badge">{{ prod_block.settings.badge }}</span>
                        {% endif %}
                      </a>
                      <div class="fh-product-card__body">
                        <p class="fh-product-card__name">{{ prod.title }}</p>
                        {% if prod.description != blank %}
                          <p class="fh-product-card__desc">{{ prod.description | strip_html | truncate: 90 }}</p>
                        {% endif %}
                        <div class="fh-product-card__rating">
                          <span class="fh-product-card__stars">★★★★★</span>
                          {% if prod_block.settings.review_count != blank %}
                            <span class="fh-product-card__review-count">({{ prod_block.settings.review_count }})</span>
                          {% endif %}
                        </div>
                        <div class="fh-product-card__footer">
                          <span class="fh-product-card__price">Desde {{ prod.price | money }}</span>
                          <a href="{{ prod.url }}" class="fh-product-card__link">Ver producto →</a>
                        </div>
                      </div>
                    </article>
                  {% endif %}
                {% endif %}
              {% endfor %}
            </div>
          {% endfor %}
        {% endif %}
      </div>

    </div>
  </div>
</section>

<script>
(function(){
  var wrap = document.getElementById('shopify-section-{{ section.id }}');
  if (!wrap) return;
  var btns   = wrap.querySelectorAll('.fh-tab-btn');
  var panels = wrap.querySelectorAll('.fh-tab-panel');
  btns.forEach(function(btn){
    btn.addEventListener('click', function(){
      btns.forEach(function(b){ b.classList.remove('is-active'); b.setAttribute('aria-selected','false'); });
      panels.forEach(function(p){ p.classList.remove('is-active'); });
      btn.classList.add('is-active');
      btn.setAttribute('aria-selected','true');
      var panel = document.getElementById('fh-tab-panel-' + btn.dataset.tab);
      if (panel) panel.classList.add('is-active');
    });
  });
})();
</script>

{% schema %}
{
  "name": "Product Tabs",
  "tag": "section",
  "settings": [
    { "type": "color",    "id": "bg_color",    "label": "Fondo",           "default": "#FAFDF8" },
    { "type": "header",   "content": "Sidebar" },
    { "type": "text",     "id": "titulo",      "label": "Título sidebar",  "default": "Soluciones liposomales para cada objetivo" },
    { "type": "textarea", "id": "descripcion", "label": "Descripción",     "default": "Tecnología liposomal de alta absorción que favorece el aprovechamiento de los nutrientes y acompaña tu bienestar día a día." },
    { "type": "text",     "id": "cta_label",   "label": "Texto botón CTA", "default": "Conoce nuestra línea" },
    { "type": "url",      "id": "cta_link",    "label": "Link CTA" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text",       "id": "label",      "label": "Nombre del tab",       "default": "descanso" },
        { "type": "collection", "id": "collection", "label": "Colección (opcional)" },
        { "type": "range",      "id": "limit",      "label": "Máx. productos",       "min": 1, "max": 6, "step": 1, "default": 3 },
        { "type": "text",       "id": "badge",      "label": "Badge en tarjetas",    "default": "Alta absorción X5" }
      ]
    },
    {
      "type": "product",
      "name": "Producto manual",
      "settings": [
        { "type": "text",    "id": "tab_id",       "label": "ID del tab (copia del bloque tab)" },
        { "type": "product", "id": "product",      "label": "Producto" },
        { "type": "text",    "id": "badge",        "label": "Badge",            "default": "Alta absorción X5" },
        { "type": "text",    "id": "review_count", "label": "N° reseñas (ej. 50)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Tabs",
      "blocks": [
        { "type": "tab", "settings": { "label": "descanso",   "badge": "Alta absorción X5" } },
        { "type": "tab", "settings": { "label": "digestión",  "badge": "Alta absorción X5" } },
        { "type": "tab", "settings": { "label": "enfoque",    "badge": "Alta absorción X5" } },
        { "type": "tab", "settings": { "label": "metabolismo","badge": "Alta absorción X5" } }
      ]
    }
  ]
}
{% endschema %}

<section id="shopify-section-{{ section.id }}" class="fh-product-tabs" style="background-color:{{ section.settings.bg_color }};">
  <div class="page-width">
    <div class="fh-product-tabs__layout">

      <!-- Sidebar izquierda -->
      <aside class="fh-product-tabs__sidebar">
        {% if section.settings.titulo != blank %}
          <h2 class="fh-product-tabs__sidebar-title">{{ section.settings.titulo }}</h2>
        {% endif %}
        {% if section.settings.descripcion != blank %}
          <p class="fh-product-tabs__sidebar-desc">{{ section.settings.descripcion }}</p>
        {% endif %}
        {% if section.settings.cta_label != blank %}
          <a href="{{ section.settings.cta_link | default: '#' }}" class="fh-btn fh-btn--outline">{{ section.settings.cta_label }}</a>
        {% endif %}
      </aside>

      <!-- Contenido derecha -->
      <div>
        {%- assign tab_vals   = 'descanso,digestion,enfoque,metabolismo' | split: ',' -%}
        {%- assign tab_labels = 'descanso,digestión,enfoque,metabolismo' | split: ',' -%}

        <!-- Tabs nav -->
        <div class="fh-tabs-nav" role="tablist">
          {% for tval in tab_vals %}
            {%- assign tlabel = tab_labels[forloop.index0] -%}
            <button
              class="fh-tab-btn{% if forloop.first %} is-active{% endif %}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="fh-tab-panel-{{ tval }}"
              id="fh-tab-{{ tval }}"
              data-tab="{{ tval }}"
            >{{ tlabel }}</button>
          {% endfor %}
        </div>

        <!-- Tab panels -->
        {% for tval in tab_vals %}
          <div
            id="fh-tab-panel-{{ tval }}"
            class="fh-tab-panel{% if forloop.first %} is-active{% endif %}"
            role="tabpanel"
            aria-labelledby="fh-tab-{{ tval }}"
          >
            {% for block in section.blocks %}
              {% if block.type == 'product' and block.settings.tab == tval %}
                {%- assign prod = block.settings.product -%}
                {% if prod != blank %}
                  <article class="fh-product-card" {{ block.shopify_attributes }}>
                    <a href="{{ prod.url }}" class="fh-product-card__img">
                      {% if prod.featured_image %}
                        {{ prod.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: prod.title }}
                      {% else %}
                        {{ 'product-1' | placeholder_svg_tag }}
                      {% endif %}
                      {% if block.settings.badge != blank %}
                        <span class="fh-product-card__badge">{{ block.settings.badge }}</span>
                      {% endif %}
                    </a>
                    <div class="fh-product-card__body">
                      <p class="fh-product-card__name">{{ prod.title }}</p>
                      {% if prod.description != blank %}
                        <p class="fh-product-card__desc">{{ prod.description | strip_html | truncate: 90 }}</p>
                      {% endif %}
                      <div class="fh-product-card__rating">
                        <span class="fh-product-card__stars">★★★★★</span>
                        <span class="fh-product-card__review-count">({{ prod.metafields.reviews.rating_count | default: '—' }})</span>
                      </div>
                      <div class="fh-product-card__footer">
                        <span class="fh-product-card__price">Desde {{ prod.price | money }}</span>
                        <a href="{{ prod.url }}" class="fh-product-card__link">Ver producto →</a>
                      </div>
                    </div>
                  </article>
                {% else %}
                  <!-- Placeholder si producto no asignado aún -->
                  <article class="fh-product-card fh-product-card--placeholder" {{ block.shopify_attributes }}>
                    <div class="fh-product-card__img">{{ 'product-1' | placeholder_svg_tag }}</div>
                    <div class="fh-product-card__body">
                      <p class="fh-product-card__name">Selecciona un producto en el editor</p>
                      {% if block.settings.badge != blank %}
                        <span class="fh-product-card__badge" style="position:static;margin-bottom:0.5rem;">{{ block.settings.badge }}</span>
                      {% endif %}
                    </div>
                  </article>
                {% endif %}
              {% endif %}
            {% endfor %}
          </div>
        {% endfor %}

      </div>
    </div>
  </div>
</section>

<script>
(function(){
  var wrap = document.getElementById('shopify-section-{{ section.id }}');
  if (!wrap) return;
  var btns   = wrap.querySelectorAll('.fh-tab-btn');
  var panels = wrap.querySelectorAll('.fh-tab-panel');
  btns.forEach(function(btn){
    btn.addEventListener('click', function(){
      btns.forEach(function(b){ b.classList.remove('is-active'); b.setAttribute('aria-selected','false'); });
      panels.forEach(function(p){ p.classList.remove('is-active'); });
      btn.classList.add('is-active');
      btn.setAttribute('aria-selected','true');
      var panel = document.getElementById('fh-tab-panel-' + btn.dataset.tab);
      if (panel) panel.classList.add('is-active');
    });
  });
})();
</script>

{% schema %}
{
  "name": "Product Tabs",
  "tag": "section",
  "settings": [
    { "type": "color",    "id": "bg_color",    "label": "Fondo",           "default": "#FAFDF8" },
    { "type": "header",   "content": "Sidebar" },
    { "type": "text",     "id": "titulo",      "label": "Título sidebar",  "default": "Soluciones liposomales para cada objetivo" },
    { "type": "textarea", "id": "descripcion", "label": "Descripción",     "default": "Tecnología liposomal de alta absorción que favorece el aprovechamiento de los nutrientes y acompaña tu bienestar día a día." },
    { "type": "text",     "id": "cta_label",   "label": "Texto botón CTA", "default": "Conoce nuestra línea" },
    { "type": "url",      "id": "cta_link",    "label": "Link CTA" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Producto",
      "settings": [
        {
          "type": "select",
          "id": "tab",
          "label": "Tab",
          "options": [
            { "value": "descanso",    "label": "Descanso" },
            { "value": "digestion",   "label": "Digestión" },
            { "value": "enfoque",     "label": "Enfoque" },
            { "value": "metabolismo", "label": "Metabolismo" }
          ],
          "default": "descanso"
        },
        { "type": "product", "id": "product", "label": "Producto" },
        { "type": "text",    "id": "badge",   "label": "Badge",   "default": "Alta absorción X5" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Product Tabs",
      "blocks": [
        { "type": "product", "settings": { "tab": "descanso",    "badge": "Alta absorción X5" } },
        { "type": "product", "settings": { "tab": "descanso",    "badge": "Alta absorción X5" } },
        { "type": "product", "settings": { "tab": "digestion",   "badge": "Alta absorción X5" } },
        { "type": "product", "settings": { "tab": "digestion",   "badge": "Alta absorción X5" } },
        { "type": "product", "settings": { "tab": "enfoque",     "badge": "Alta absorción X5" } },
        { "type": "product", "settings": { "tab": "enfoque",     "badge": "Alta absorción X5" } },
        { "type": "product", "settings": { "tab": "metabolismo", "badge": "Alta absorción X5" } },
        { "type": "product", "settings": { "tab": "metabolismo", "badge": "Alta absorción X5" } }
      ]
    }
  ]
}
{% endschema %}

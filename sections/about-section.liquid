<section id="shopify-section-{{ section.id }}" class="fh-about" style="background-color:{{ section.settings.bg_color }};">
  <div class="page-width">
    <div class="fh-about__grid{% if section.settings.imagen_pos == 'right' %} fh-about__grid--img-right{% endif %}">

      <!-- Texto -->
      <div class="fh-about__content">
        {% if section.settings.titulo != blank %}
          <h2 class="fh-about__title">{{ section.settings.titulo }}</h2>
        {% endif %}
        {% if section.settings.descripcion != blank %}
          <div class="fh-about__desc">{{ section.settings.descripcion }}</div>
        {% endif %}
        {% if section.settings.cta_label != blank %}
          <a href="{{ section.settings.cta_link | default: '#' }}" class="fh-btn fh-btn--outline" style="width:fit-content;">
            {{ section.settings.cta_label }}
          </a>
        {% endif %}
      </div>

      <!-- Imagen -->
      <div class="fh-about__img">
        {% if section.settings.imagen != blank %}
          {{ section.settings.imagen | image_url: width: 1000 | image_tag: loading: 'lazy', alt: section.settings.titulo }}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {% endif %}
      </div>

    </div>
  </div>
</section>

<style>
  .fh-about__grid--img-right { }
  @media (min-width: 769px) {
    .fh-about__grid--img-right .fh-about__content { order: 1; }
    .fh-about__grid--img-right .fh-about__img     { order: 2; }
  }
</style>

{% schema %}
{
  "name": "About Section",
  "tag": "section",
  "settings": [
    { "type": "color",    "id": "bg_color",    "label": "Fondo",             "default": "#FAFDF8" },
    { "type": "select",   "id": "imagen_pos",  "label": "Posición imagen",
      "options": [
        { "value": "left",  "label": "Izquierda" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "right"
    },
    { "type": "header",   "content": "Contenido" },
    { "type": "text",     "id": "titulo",      "label": "Título",            "default": "Más sobre Fitoheal" },
    { "type": "richtext", "id": "descripcion", "label": "Descripción",
      "default": "<p>Somos un sistema de soluciones liposomales de alta absorción con ingredientes seleccionados y ciencia moderna para acompañarte en tus objetivos sin restricciones impuestas.</p><p>Creados para integrarse fácilmente a tu rutina diaria y ayudarte a sentir la mejor versión. Todos los días.</p>"
    },
    { "type": "text",         "id": "cta_label", "label": "Texto botón", "default": "Conoce nuestra historia" },
    { "type": "url",          "id": "cta_link",  "label": "Link botón" },
    { "type": "header",       "content": "Imagen" },
    { "type": "image_picker", "id": "imagen",    "label": "Imagen" }
  ],
  "presets": [{ "name": "About Section" }]
}
{% endschema %}

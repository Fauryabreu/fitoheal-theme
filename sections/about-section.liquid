<section
  id="shopify-section-{{ section.id }}"
  class="about-section section-padding"
  style="background-color: {{ section.settings.bg_color }};"
>
  <div class="page-width">
    <div class="about-section__layout{% if section.settings.image_position == 'right' %} about-section__layout--reverse{% endif %}">

      <!-- Media -->
      <div class="about-section__media">
        <div class="about-section__img-main">
          {% if section.settings.image_main != blank %}
            {{ section.settings.image_main | image_url: width: 1000 | image_tag: loading: 'lazy', alt: section.settings.title }}
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>
        {% if section.settings.image_accent != blank %}
          <div class="about-section__img-accent">
            {{ section.settings.image_accent | image_url: width: 400 | image_tag: loading: 'lazy', alt: 'Detail' }}
          </div>
        {% endif %}
      </div>

      <!-- Content -->
      <div class="about-section__content">
        {% if section.settings.eyebrow != blank %}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.title != blank %}
          <h2 class="h2">{{ section.settings.title }}</h2>
          <div class="divider"></div>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="lead" style="font-size: var(--font-size-base);">
            {{ section.settings.description }}
          </div>
        {% endif %}

        <!-- Value items from blocks -->
        {% assign value_blocks = section.blocks | where: 'type', 'value' %}
        {% if value_blocks.size > 0 %}
          <div class="about-section__values">
            {% for block in value_blocks %}
              <div class="value-item" {{ block.shopify_attributes }}>
                <div class="value-item__icon">
                  {% case block.settings.icon %}
                    {% when 'leaf' %}
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 17.25c-4.097 0-7.5-2.804-7.5-6.375A6.187 6.187 0 0112 4.5c2.485 0 4.5 2.239 4.5 4.875A4.313 4.313 0 0112 13.5c-1.243 0-2.25-.895-2.25-2 0-1.104 1.007-2 2.25-2 .83 0 1.5.597 1.5 1.333"/></svg>
                    {% when 'heart' %}
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/></svg>
                    {% when 'flask' %}
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15M14.25 3.104c.251.023.501.05.75.082M19.8 15a2.25 2.25 0 01.45 1.317l-.003.014-.006.018a2.25 2.25 0 01-2.25 1.902H5.25a2.25 2.25 0 01-2.25-1.902l-.006-.018-.003-.014A2.25 2.25 0 013.45 15M19.8 15H4.2"/></svg>
                    {% when 'globe' %}
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418"/></svg>
                    {% else %}
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                  {% endcase %}
                </div>
                <div>
                  {% if block.settings.title != blank %}
                    <p class="value-item__title">{{ block.settings.title }}</p>
                  {% endif %}
                  {% if block.settings.description != blank %}
                    <p class="value-item__desc">{{ block.settings.description }}</p>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}

        {% if section.settings.cta_label != blank %}
          <div style="margin-top: var(--spacing-xl);">
            <a href="{{ section.settings.cta_link }}" class="btn btn--primary">
              {{ section.settings.cta_label }}
            </a>
          </div>
        {% endif %}
      </div>

    </div>
  </div>
</section>

<style>
  .about-section__layout--reverse {
    direction: rtl;
  }
  .about-section__layout--reverse > * {
    direction: ltr;
  }
</style>

{% schema %}
{
  "name": "About Section",
  "tag": "section",
  "class": "about-section-wrapper",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FAFDF8"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left",  "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_main",
      "label": "Main image"
    },
    {
      "type": "image_picker",
      "id": "image_accent",
      "label": "Accent image (bottom corner)"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Nuestra historia"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Ciencia al servicio de tu bienestar"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Fitoheal nació de una pregunta simple: ¿por qué la mayoría de suplementos se desperdician antes de llegar a la célula? Nuestra respuesta fue la tecnología liposomal — un sistema de entrega que encapsula cada nutriente en una membrana lipídica idéntica a la de tus células.</p><p>El resultado: absorción real, efectos medibles, bienestar sostenible.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Conoce nuestra misión"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf",  "label": "Leaf" },
            { "value": "heart", "label": "Heart" },
            { "value": "flask", "label": "Flask" },
            { "value": "globe", "label": "Globe" },
            { "value": "check", "label": "Check" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Ingredientes de calidad farmacéutica"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Cada lote pasa por triple control de pureza antes de llegar a ti."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "About Section",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "icon": "flask",
            "title": "Calidad farmacéutica",
            "description": "Triple control de pureza en cada lote producido."
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "leaf",
            "title": "Origen natural",
            "description": "Fuentes vegetales certificadas, sin GMO ni pesticidas."
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "globe",
            "title": "Compromiso sostenible",
            "description": "Embalaje 100% reciclable y huella de carbono compensada."
          }
        }
      ]
    }
  ]
}
{% endschema %}

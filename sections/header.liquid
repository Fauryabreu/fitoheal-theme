<header class="fh-header" id="shopify-section-{{ section.id }}">
  <div class="page-width">
    <div class="fh-header__inner">

      <!-- Logo -->
      <a href="{{ routes.root_url }}" class="fh-header__logo" aria-label="{{ shop.name }}">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: height: 72 | image_tag: loading: 'eager', fetchpriority: 'high', alt: shop.name }}
        {% else %}
          {{ section.settings.logo_text | default: 'fitoheal' }}
        {% endif %}
      </a>

      <!-- Desktop nav -->
      <nav class="fh-nav" aria-label="Navegación principal">
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url }}" class="fh-nav__link"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
        {% endfor %}
      </nav>

      <!-- Actions -->
      <div class="fh-header__actions">
        {% if section.settings.show_search %}
          <a href="{{ routes.search_url }}" class="fh-icon-btn" aria-label="Buscar">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/></svg>
          </a>
        {% endif %}
        {% if section.settings.show_account %}
          <a href="{{ routes.account_url }}" class="fh-icon-btn" aria-label="Mi cuenta">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0"/></svg>
          </a>
        {% endif %}
        <a href="{{ routes.cart_url }}" class="fh-icon-btn fh-cart-wrap" aria-label="Carrito ({{ cart.item_count }})">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007z"/></svg>
          {% if cart.item_count > 0 %}
            <span class="fh-cart-bubble" aria-hidden="true">{{ cart.item_count }}</span>
          {% endif %}
        </a>
        {% if section.settings.cta_label != blank %}
          <a href="{{ section.settings.cta_link | default: routes.root_url }}" class="fh-btn fh-btn--primary fh-btn--sm">
            {{ section.settings.cta_label }}
          </a>
        {% endif %}
        <button class="fh-hamburger" id="fh-hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="fh-mobile-nav">
          <span></span><span></span><span></span>
        </button>
      </div>

    </div>
  </div>
</header>

<!-- Mobile nav -->
<nav class="fh-mobile-nav" id="fh-mobile-nav" aria-hidden="true" aria-label="Menú móvil">
  <button class="fh-mobile-nav__close" id="fh-nav-close" aria-label="Cerrar menú">✕</button>
  {% for link in section.settings.menu.links %}
    <a href="{{ link.url }}" class="fh-mobile-nav__link">{{ link.title }}</a>
  {% endfor %}
  {% if section.settings.cta_label != blank %}
    <a href="{{ section.settings.cta_link }}" class="fh-btn fh-btn--primary" style="margin-top:1rem;">{{ section.settings.cta_label }}</a>
  {% endif %}
</nav>

<script>
(function(){
  var btn    = document.getElementById('fh-hamburger');
  var nav    = document.getElementById('fh-mobile-nav');
  var close  = document.getElementById('fh-nav-close');
  var header = document.querySelector('.fh-header');
  function open() { nav.classList.add('is-open'); btn.setAttribute('aria-expanded','true'); nav.setAttribute('aria-hidden','false'); document.body.style.overflow='hidden'; }
  function shut() { nav.classList.remove('is-open'); btn.setAttribute('aria-expanded','false'); nav.setAttribute('aria-hidden','true'); document.body.style.overflow=''; }
  btn.addEventListener('click', open);
  close.addEventListener('click', shut);
  nav.addEventListener('click', function(e){ if(e.target===nav) shut(); });
  window.addEventListener('scroll', function(){ header.classList.toggle('fh-header--scrolled', window.scrollY > 8); }, {passive:true});
})();
</script>

{% schema %}
{
  "name": "Header",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "logo",      "label": "Logo (imagen)" },
    { "type": "text",         "id": "logo_text",  "label": "Logo (texto fallback)", "default": "fitoheal" },
    { "type": "link_list",    "id": "menu",        "label": "Menú de navegación", "default": "main-menu" },
    { "type": "header", "content": "Acciones" },
    { "type": "checkbox", "id": "show_search",  "label": "Icono buscar",  "default": true },
    { "type": "checkbox", "id": "show_account", "label": "Icono cuenta",  "default": true },
    { "type": "text", "id": "cta_label", "label": "Texto botón CTA", "default": "Comprar ahora" },
    { "type": "url",  "id": "cta_link",  "label": "Link botón CTA" }
  ]
}
{% endschema %}

{%- liquid
  assign media_block = section.blocks | where: 'type', 'media' | first
  assign heading_block = section.blocks | where: 'type', 'heading' | first
  assign step_blocks = section.blocks | where: 'type', 'step'

  assign media_height_desktop = 620
  assign media_height_mobile = 380
  assign media_object_fit = 'cover'
  assign media_object_fit_mobile = 'cover'
  assign use_different_media_on_mobile = false
  assign media_position_mobile = 'between_heading_and_steps'
  assign media_loading = 'eager'
  assign media_preload = 'auto'

  if media_block != blank
    assign media_height_desktop = media_block.settings.media_height_desktop | default: 620
    assign media_height_mobile = media_block.settings.media_height_mobile | default: 380
    assign media_object_fit = media_block.settings.media_object_fit | default: 'cover'
    assign media_object_fit_mobile = media_block.settings.media_object_fit_mobile | default: 'cover'
    assign use_different_media_on_mobile = media_block.settings.use_different_media_on_mobile | default: false
    assign media_position_mobile = media_block.settings.media_position_mobile | default: 'between_heading_and_steps'

    if media_position_mobile == 'above_steps'
      assign media_position_mobile = 'between_heading_and_steps'
    endif

    if media_block.settings.media_lazy_load
      assign media_loading = 'lazy'
      assign media_preload = 'none'
    endif
  endif

  assign heading_color = '#101010'
  assign heading_custom_font = false
  assign heading_font = blank
  assign heading_font_size_desktop = 54
  assign heading_font_size_mobile = 38
  assign heading_font_weight = 700
  assign heading_line_height = 110
  assign heading_margin_top = 0
  assign heading_margin_bottom = 0
  assign heading_margin_top_mobile = 0
  assign heading_margin_bottom_mobile = 0
  assign heading_limit_width_desktop = true
  assign heading_max_width_desktop = 600
  assign eyebrow_color = '#7D1C2F'
  assign eyebrow_custom_font = true
  assign eyebrow_font = blank
  assign eyebrow_font_size_desktop = 18
  assign eyebrow_font_size_mobile = 14
  assign eyebrow_line_height = 130
  assign eyebrow_font_weight = 500

  if heading_block != blank
    assign heading_color = heading_block.settings.heading_color | default: '#101010'
    assign heading_custom_font = heading_block.settings.heading_custom_font | default: false
    assign heading_font = heading_block.settings.heading_font
    assign heading_font_size_desktop = heading_block.settings.heading_font_size_desktop | default: 54
    assign heading_font_size_mobile = heading_block.settings.heading_font_size_mobile | default: 38
    assign heading_font_weight = heading_block.settings.heading_font_weight | default: 700
    assign heading_line_height = heading_block.settings.heading_line_height | default: 110
    assign heading_margin_top = heading_block.settings.heading_margin_top | default: 0
    assign heading_margin_bottom = heading_block.settings.heading_margin_bottom | default: 0
    assign heading_margin_top_mobile = heading_block.settings.heading_margin_top_mobile | default: 0
    assign heading_margin_bottom_mobile = heading_block.settings.heading_margin_bottom_mobile | default: 0
    assign heading_limit_width_desktop = heading_block.settings.heading_limit_width_desktop
    assign heading_max_width_desktop = heading_block.settings.heading_max_width_desktop | default: 600
    assign eyebrow_color = heading_block.settings.eyebrow_color | default: '#7D1C2F'
    assign eyebrow_custom_font = heading_block.settings.eyebrow_custom_font
    assign eyebrow_font = heading_block.settings.eyebrow_font
    assign eyebrow_font_size_desktop = heading_block.settings.eyebrow_font_size_desktop | default: 18
    assign eyebrow_font_size_mobile = heading_block.settings.eyebrow_font_size_mobile | default: 14
    assign eyebrow_line_height = heading_block.settings.eyebrow_line_height | default: 130
    assign eyebrow_font_weight = heading_block.settings.eyebrow_font_weight | default: 500
  endif

  assign section_bg_value = section.settings.section_bg_color
  if section.settings.background_type == 'gradient'
    assign section_bg_value = section.settings.section_bg_gradient
  endif

  assign full_width_desktop = false
  if section.settings.full_width_desktop
    assign full_width_desktop = true
  endif
-%}

{%- style -%}
  .vd-l { display: none !important; }
  #shopify-section-{{ section.id }} {
    --section-border-radius: 0px;
    --section-horizontal-padding: var(--page-margin, 16px);
    background: transparent;
    margin-top: {{ section.settings.margin_top_mobile }}px;
    margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
    border-radius: var(--section-border-radius);
    overflow: hidden;
    padding: 0;
  }

  {% if section.settings.enable_advanced_settings %}
    #shopify-section-{{ section.id }} {
      --section-horizontal-padding: {{ section.settings.padding_horizontal_mobile }}px;
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      background: {{ section_bg_value }};
    }
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      {% if full_width_desktop %}
        --section-border-radius: 0px;
      {% else %}
        --section-border-radius: {{ section.settings.section_border_radius }}px;
      {% endif %}
      --section-horizontal-padding: 0px;
      margin-top: {{ section.settings.margin_top }}px;
      margin-bottom: {{ section.settings.margin_bottom }}px;
      {% if full_width_desktop %}
        background: {{ section_bg_value }};
      {% else %}
        background: transparent;
      {% endif %}
    }
  }

  {% if section.settings.enable_advanced_settings == false and full_width_desktop == false %}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} {
        --section-horizontal-padding: 40px;
      }
    }
  {% endif %}

  {% if section.settings.enable_advanced_settings == false and full_width_desktop %}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} {
        --section-container-max-width: var(--page-content-width, var(--page-width, 1440px));
        --section-outer-gutter: max(0px, calc((100vw - var(--section-container-max-width)) / 2));
        --section-horizontal-padding: max(0px, calc(var(--page-margin, 40px) - var(--section-outer-gutter)));
      }
    }
  {% endif %}

  {% if section.settings.enable_advanced_settings %}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} {
        --section-horizontal-padding: {{ section.settings.padding_horizontal }}px;
      }
    }
  {% endif %}

  #shopify-section-{{ section.id }} > .vso-hero-44__container {
    margin-left: auto;
    margin-right: auto;
    width: 100%;
    max-width: var(--page-content-width, var(--page-width, 1440px));
    {% if section.settings.enable_advanced_settings %}
      max-width: {{ section.settings.section_max_width }}rem;
    {% endif %}
    border-radius: var(--section-border-radius);
    overflow: hidden;
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    padding-left: var(--section-horizontal-padding);
    padding-right: var(--section-horizontal-padding);
  }

  {% if full_width_desktop == false %}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} > .vso-hero-44__container {
        width: calc(100% - (2 * var(--page-margin, 40px)));
      }
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} > .vso-hero-44__container {
      background: transparent;
    }
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} > .vso-hero-44__container {
      {% if full_width_desktop %}
        background: transparent;
      {% else %}
        background: {{ section_bg_value }};
      {% endif %}
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} .vso-hero-44__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ section.settings.column_gap_mobile }}px;
    align-items: stretch;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .vso-hero-44__grid {
      gap: {{ section.settings.column_gap }}px;
      {% if media_block == blank %}
        grid-template-columns: 1fr;
      {% elsif section.settings.enable_advanced_settings %}
        grid-template-columns: minmax(0, {{ section.settings.media_column_width }}%) minmax(0, calc(100% - {{ section.settings.media_column_width }}%));
      {% else %}
        grid-template-columns: minmax(0, 48%) minmax(0, 52%);
      {% endif %}
    }
  }

  #shopify-section-{{ section.id }} .vso-hero-44__grid > .vso-hero-44__content-panel {
    display: flex;
    justify-content: {% case section.settings.content_alignment_mobile %}{% when 'left' %}flex-start{% when 'right' %}flex-end{% else %}center{% endcase %};
    order: 2;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .vso-hero-44__grid > .vso-hero-44__media-panel {
    order: 1;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .vso-hero-44__grid > .vso-hero-44__content-panel {
      justify-content: {% case section.settings.content_alignment %}{% when 'left' %}flex-start{% when 'right' %}flex-end{% else %}center{% endcase %};
      align-items: {{ section.settings.content_vertical_alignment }};
      order: {% if section.settings.reverse_layout_desktop %}1{% else %}2{% endif %};
    }

    #shopify-section-{{ section.id }} .vso-hero-44__grid > .vso-hero-44__media-panel {
      order: {% if section.settings.reverse_layout_desktop %}2{% else %}1{% endif %};
    }
  }

  #shopify-section-{{ section.id }} .vso-hero-44__content {
    width: 100%;
    max-width: 100%;
    text-align: {{ section.settings.content_alignment_mobile }};
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.content_gap_mobile }}px;
    min-width: 0;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .vso-hero-44__content {
      text-align: {{ section.settings.content_alignment }};
      gap: {{ section.settings.content_gap }}px;
    }
  }

  #shopify-section-{{ section.id }} .vso-hero-44__heading {
    margin-top: {{ heading_margin_top_mobile }}px;
    margin-bottom: {{ heading_margin_bottom_mobile }}px;
    color: {{ heading_color }};
    line-height: {{ heading_line_height }}%;
  }

  #shopify-section-{{ section.id }} .vso-hero-44__heading-block {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .vso-hero-44__eyebrow {
    margin: 0 0 12px;
    color: {{ eyebrow_color }};
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .vso-hero-44__eyebrow * {
    margin: 0;
    color: {{ eyebrow_color }} !important;
  }

  {% if eyebrow_custom_font %}
    #shopify-section-{{ section.id }} .vso-hero-44__eyebrow {
      font-size: {{ eyebrow_font_size_mobile }}px;
      line-height: {{ eyebrow_line_height }}%;
      font-family: {{ eyebrow_font.family }}, {{ eyebrow_font.fallback_families }};
      font-style: {{ eyebrow_font.style }};
      {% if section.settings.enable_advanced_settings %}
        font-weight: {{ eyebrow_font_weight }};
      {% endif %}
    }

    #shopify-section-{{ section.id }} .vso-hero-44__eyebrow > * {
      font-size: {{ eyebrow_font_size_mobile }}px;
    }

    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .vso-hero-44__eyebrow {
        font-size: {{ eyebrow_font_size_desktop }}px;
      }

      #shopify-section-{{ section.id }} .vso-hero-44__eyebrow > * {
        font-size: {{ eyebrow_font_size_desktop }}px;
      }
    }
  {% endif %}

  #shopify-section-{{ section.id }} .vso-hero-44__heading > *,
  #shopify-section-{{ section.id }} .vso-hero-44__heading + p {
    color: {{ heading_color }} !important;
    margin-top: 0 !important;
    margin-bottom: 0 !important;
  }

  {% if heading_custom_font %}
    #shopify-section-{{ section.id }} .vso-hero-44__heading {
      font-size: {{ heading_font_size_mobile }}px;
      font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
      font-style: {{ heading_font.style }};
      {% if section.settings.enable_advanced_settings %}
        font-weight: {{ heading_font_weight }};
      {% endif %}
    }

    #shopify-section-{{ section.id }} .vso-hero-44__heading > * {
      font-size: {{ heading_font_size_mobile }}px;
    }

    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .vso-hero-44__heading {
        font-size: {{ heading_font_size_desktop }}px;
      }

      #shopify-section-{{ section.id }} .vso-hero-44__heading > * {
        font-size: {{ heading_font_size_desktop }}px;
      }
    }
  {% endif %}

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .vso-hero-44__heading-block {
      width: 100%;
      {% if heading_limit_width_desktop %}
        max-width: {{ heading_max_width_desktop }}px;
        {% case section.settings.content_alignment %}
          {% when 'center' %}
            margin-left: auto;
            margin-right: auto;
          {% when 'right' %}
            margin-left: auto;
        {% endcase %}
      {% endif %}
    }

    #shopify-section-{{ section.id }} .vso-hero-44__eyebrow {
      margin-bottom: 16px;
    }

    #shopify-section-{{ section.id }} .vso-hero-44__heading {
      margin-top: {{ heading_margin_top }}px;
      margin-bottom: {{ heading_margin_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} .vso-hero-44__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: {{ section.settings.step_list_gap_mobile }}px;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .vso-hero-44__steps {
      --vso-hero-44-mobile-peek: 82px;
      display: flex;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      scroll-padding-left: var(--section-horizontal-padding);
      scroll-padding-right: var(--section-horizontal-padding);
      scrollbar-width: none;
      -ms-overflow-style: none;
      touch-action: pan-x;
      width: calc(100% + (2 * var(--section-horizontal-padding)));
      max-width: none;
      box-sizing: border-box;
      padding-left: var(--section-horizontal-padding);
      padding-right: var(--section-horizontal-padding);
      margin-left: calc(var(--section-horizontal-padding) * -1);
      margin-right: calc(var(--section-horizontal-padding) * -1);
    }

    #shopify-section-{{ section.id }} .vso-hero-44__steps::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .vso-hero-44__steps.is-dragging {
      user-select: none;
    }
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .vso-hero-44__steps {
      gap: {{ section.settings.step_list_gap }}px;
    }
  }

  #shopify-section-{{ section.id }} .vso-hero-44__step {
    display: block;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .vso-hero-44__step {
      flex: 0 0 calc(100% - var(--vso-hero-44-mobile-peek) - {{ section.settings.step_list_gap_mobile }}px);
      scroll-snap-align: start;
      background: transparent;
      border: 1px solid rgba(16, 16, 16, 0.14);
      border-radius: 14px;
      padding: 18px 16px;
      box-sizing: border-box;
    }

    #shopify-section-{{ section.id }} .vso-hero-44__step:last-child {
      scroll-snap-align: end;
    }
  }

  #shopify-section-{{ section.id }} .vso-hero-44__step-label {
    margin: 0 0 8px;
    color: {{ section.settings.step_label_color }};
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .vso-hero-44__step-label * {
    margin: 0;
    color: {{ section.settings.step_label_color }} !important;
  }

  {% if section.settings.step_label_custom_font %}
    #shopify-section-{{ section.id }} .vso-hero-44__step-label {
      font-size: {{ section.settings.step_label_size_mobile }}px;
      line-height: {{ section.settings.step_label_line_height }}%;
      font-family: {{ section.settings.step_label_font.family }}, {{ section.settings.step_label_font.fallback_families }};
      font-style: {{ section.settings.step_label_font.style }};
      {% if section.settings.enable_advanced_settings %}
        font-weight: {{ section.settings.step_label_weight }};
      {% endif %}
    }

    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .vso-hero-44__step-label {
        font-size: {{ section.settings.step_label_size }}px;
      }
    }
  {% endif %}

  #shopify-section-{{ section.id }} .vso-hero-44__step-title {
    margin: 0;
    color: {{ section.settings.step_title_color }};
  }

  {% if section.settings.step_title_custom_font %}
    #shopify-section-{{ section.id }} .vso-hero-44__step-title {
      font-size: {{ section.settings.step_title_size_mobile }}px;
      line-height: {{ section.settings.step_title_line_height }}%;
      font-family: {{ section.settings.step_title_font.family }}, {{ section.settings.step_title_font.fallback_families }};
      font-style: {{ section.settings.step_title_font.style }};
      {% if section.settings.enable_advanced_settings %}
        font-weight: {{ section.settings.step_title_weight }};
      {% endif %}
    }

    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .vso-hero-44__step-title {
        font-size: {{ section.settings.step_title_size }}px;
      }
    }
  {% endif %}

  #shopify-section-{{ section.id }} .vso-hero-44__step-text {
    margin: 6px 0 0;
    color: {{ section.settings.step_text_color }};
  }

  #shopify-section-{{ section.id }} .vso-hero-44__step-body > *:first-child {
    margin-top: 0 !important;
  }

  #shopify-section-{{ section.id }} .vso-hero-44__step-body > *:last-child {
    margin-bottom: 0 !important;
  }

  #shopify-section-{{ section.id }} .vso-hero-44__step-text * {
    color: {{ section.settings.step_text_color }} !important;
  }

  {% if section.settings.step_text_custom_font %}
    #shopify-section-{{ section.id }} .vso-hero-44__step-text {
      font-size: {{ section.settings.step_text_size_mobile }}px;
      line-height: {{ section.settings.step_text_line_height }}%;
      font-family: {{ section.settings.step_text_font.family }}, {{ section.settings.step_text_font.fallback_families }};
      font-style: {{ section.settings.step_text_font.style }};
      {% if section.settings.enable_advanced_settings %}
        font-weight: {{ section.settings.step_text_weight }};
      {% endif %}
    }

    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .vso-hero-44__step-text {
        font-size: {{ section.settings.step_text_size }}px;
      }
    }
  {% endif %}

  #shopify-section-{{ section.id }} .vso-hero-44__media-panel {
    min-height: {{ media_height_mobile }}px;
    position: relative;
    overflow: hidden;
    border-radius: {{ section.settings.media_border_radius_mobile }}px;
  }

  #shopify-section-{{ section.id }} .vso-hero-44__media-panel--mobile-inline {
    display: none;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .vso-hero-44__media-panel {
      min-height: {{ media_height_desktop }}px;
      border-radius: {{ section.settings.media_border_radius }}px;
    }

    #shopify-section-{{ section.id }} .vso-hero-44__media-panel--desktop-grid {
      display: block;
    }

    #shopify-section-{{ section.id }} .vso-hero-44__media-panel--mobile-inline {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .vso-hero-44__media-panel--desktop-grid {
      display: none;
    }

    #shopify-section-{{ section.id }} .vso-hero-44__media-panel--mobile-inline {
      display: block;
    }
  }

  #shopify-section-{{ section.id }} .vso-hero-44__media-source {
    position: absolute;
    inset: 0;
  }

  #shopify-section-{{ section.id }} .vso-hero-44__media-source--mobile {
    display: none;
  }

  {% if use_different_media_on_mobile %}
    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .vso-hero-44__media-source--desktop {
        display: none;
      }

      #shopify-section-{{ section.id }} .vso-hero-44__media-source--mobile {
        display: block;
      }
    }
  {% endif %}

  #shopify-section-{{ section.id }} .vso-hero-44__media-source img,
  #shopify-section-{{ section.id }} .vso-hero-44__media-source video,
  #shopify-section-{{ section.id }} .vso-hero-44__media-source iframe,
  #shopify-section-{{ section.id }} .vso-hero-44__media-source .placeholder-svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .vso-hero-44__media-source--desktop img,
  #shopify-section-{{ section.id }} .vso-hero-44__media-source--desktop video {
    object-fit: {{ media_object_fit }};
    object-position: center center;
  }

  #shopify-section-{{ section.id }} .vso-hero-44__media-source--mobile img,
  #shopify-section-{{ section.id }} .vso-hero-44__media-source--mobile video,
  #shopify-section-{{ section.id }} .vso-hero-44__media-source--desktop img,
  #shopify-section-{{ section.id }} .vso-hero-44__media-source--desktop video {
    object-fit: {{ media_object_fit_mobile }};
    object-position: center center;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .vso-hero-44__media-source--desktop img,
    #shopify-section-{{ section.id }} .vso-hero-44__media-source--desktop video {
      object-fit: {{ media_object_fit }};
      object-position: center center;
    }
  }

  #shopify-section-{{ section.id }} .vso-node { display: none; }
  #shopify-section-{{ section.id }} .vso-node--v2 { display: block; }
{%- endstyle -%}

{%- if request.design_mode -%}
  <div class="vso-require-script">
    <div class="vso-warning">
      <div class="vso-warning__left">
        <div class="vso-warning__badge">
          <svg width="14" height="14" viewBox="0 0 20 20" fill="none">
            <path d="M10 6.75a.75.75 0 0 1 .75.75v3.5a.75.75 0 1 1-1.5 0v-3.5a.75.75 0 0 1 .75-.75Z" fill="currentColor"/>
            <path d="M11 13.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z" fill="currentColor"/>

<section
  id="shopify-section-{{ section.id }}"
  class="cta-banner"
  style="
    {% if section.settings.bg_type == 'image' and section.settings.bg_image != blank %}
      background-image: url({{ section.settings.bg_image | image_url: width: 1600 }});
      background-size: cover;
      background-position: center;
    {% elsif section.settings.bg_type == 'solid' %}
      background: {{ section.settings.bg_color }};
    {% else %}
      background: linear-gradient(135deg, {{ section.settings.gradient_from }}, {{ section.settings.gradient_to }});
    {% endif %}
  "
>
  {% if section.settings.bg_type == 'image' and section.settings.bg_image != blank %}
    <div style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(27,67,50,0.88), rgba(45,106,79,0.75)); z-index: 0;"></div>
  {% endif %}

  <div class="cta-banner__inner">
    {% if section.settings.eyebrow != blank %}
      <span class="eyebrow cta-banner__eyebrow">{{ section.settings.eyebrow }}</span>
    {% endif %}

    {% if section.settings.title != blank %}
      <h2 class="cta-banner__title">{{ section.settings.title }}</h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <p class="cta-banner__desc">{{ section.settings.description }}</p>
    {% endif %}

    <div class="cta-banner__ctas">
      {% if section.settings.cta_primary_label != blank %}
        <a href="{{ section.settings.cta_primary_link }}" class="btn btn--light btn--lg">
          {{ section.settings.cta_primary_label }}
        </a>
      {% endif %}
      {% if section.settings.cta_secondary_label != blank %}
        <a href="{{ section.settings.cta_secondary_link }}" class="btn btn--light-outline btn--lg">
          {{ section.settings.cta_secondary_label }}
        </a>
      {% endif %}
    </div>

    {% if section.settings.guarantee_text != blank %}
      <p class="cta-banner__guarantee">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width:14px;height:14px;" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
        {{ section.settings.guarantee_text }}
      </p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "CTA Banner",
  "tag": "section",
  "class": "cta-banner-section",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background type",
      "options": [
        { "value": "gradient", "label": "Gradient" },
        { "value": "solid",    "label": "Solid color" },
        { "value": "image",    "label": "Image" }
      ],
      "default": "gradient"
    },
    {
      "type": "color",
      "id": "gradient_from",
      "label": "Gradient from",
      "default": "#1B4332"
    },
    {
      "type": "color",
      "id": "gradient_to",
      "label": "Gradient to",
      "default": "#2D6A4F"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Solid color",
      "default": "#1B4332"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Empieza hoy"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title",
      "default": "<p>Tu cuerpo merece <em>absorción real</em></p>"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Únete a más de 12,000 personas que ya experimentan los beneficios de la nutrición liposomal. Primera compra con 15% de descuento."
    },
    {
      "type": "header",
      "content": "CTA Buttons"
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primary CTA",
      "default": "Comprar ahora"
    },
    {
      "type": "url",
      "id": "cta_primary_link",
      "label": "Primary CTA link"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Secondary CTA",
      "default": "Ver todos los productos"
    },
    {
      "type": "url",
      "id": "cta_secondary_link",
      "label": "Secondary CTA link"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee text",
      "default": "Garantía de satisfacción 30 días · Envío gratis · Sin compromisos"
    }
  ],
  "presets": [
    {
      "name": "CTA Banner"
    }
  ]
}
{% endschema %}

<section id="shopify-section-{{ section.id }}" class="fh-kits" style="background-color:{{ section.settings.bg_color }};">
  <div class="page-width">
    {% if section.settings.titulo != blank %}
      <h2 class="fh-kits__title">{{ section.settings.titulo }}</h2>
    {% endif %}

    <div class="fh-kits__grid">
      {% for block in section.blocks %}
        {% if block.type == 'kit' %}
          <article class="fh-kit-card" {{ block.shopify_attributes }}>
            <div class="fh-kit-card__img">
              {% if block.settings.imagen != blank %}
                {{ block.settings.imagen | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.nombre }}
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag }}
              {% endif %}
            </div>
            <div class="fh-kit-card__body">
              {% if block.settings.nombre != blank %}
                <p class="fh-kit-card__name">{{ block.settings.nombre }}</p>
              {% endif %}
              {% if block.settings.descripcion != blank %}
                <p class="fh-kit-card__desc">{{ block.settings.descripcion }}</p>
              {% endif %}
              {% if block.settings.cta_label != blank %}
                <a href="{{ block.settings.cta_link | default: '#' }}" class="fh-kit-card__link">
                  {{ block.settings.cta_label }}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" width="14" height="14"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
                </a>
              {% endif %}
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kits Section",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Fondo",  "default": "#ffffff" },
    { "type": "text",  "id": "titulo",   "label": "Título", "default": "Kits diseñados para tus objetivos" }
  ],
  "blocks": [
    {
      "type": "kit",
      "name": "Kit",
      "settings": [
        { "type": "image_picker", "id": "imagen",      "label": "Imagen del kit" },
        { "type": "text",         "id": "nombre",      "label": "Nombre",        "default": "Sueño / Estrés" },
        { "type": "textarea",     "id": "descripcion", "label": "Descripción",   "default": "Relájate, baja el estrés y mejora tu descanso." },
        { "type": "text",         "id": "cta_label",   "label": "Texto botón",   "default": "Ver kit" },
        { "type": "url",          "id": "cta_link",    "label": "Link kit" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Kits Section",
      "blocks": [
        { "type": "kit", "settings": { "nombre": "Sueño / Estrés",  "descripcion": "Relájate, baja el estrés y mejora tu descanso.", "cta_label": "Ver kit" } },
        { "type": "kit", "settings": { "nombre": "Desinflamar",      "descripcion": "Apoya la inflamación natural y el equilibrio digestivo.", "cta_label": "Ver kit" } },
        { "type": "kit", "settings": { "nombre": "Metabólico",       "descripcion": "Apoya el metabolismo de la glucosa y la inflamación.", "cta_label": "Ver kit" } },
        { "type": "kit", "settings": { "nombre": "Focus",            "descripcion": "Claridad mental, concentración y energía sostenida.", "cta_label": "Ver kit" } }
      ]
    }
  ]
}
{% endschema %}

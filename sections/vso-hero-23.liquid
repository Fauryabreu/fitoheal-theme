    { "type": "range", "id": "name_font_size_mobile", "label": "Mobile text size", "min": 12, "max": 36, "step": 1, "unit": "px", "default": 18, "visible_if": "{{ section.settings.name_custom_font }}" },
    { "type": "range", "id": "name_font_weight", "label": "Font weight", "min": 100, "max": 900, "step": 100, "default": 700, "visible_if": "{{ section.settings.name_custom_font and section.settings.enable_advanced_settings == true }}" },

    { "type": "checkbox", "id": "price_custom_font", "label": "Enable custom font settings", "default": false },
    { "type": "select", "id": "price_as", "label": "Render as", "options": [
      { "value": "h2", "label": "H2" },
      { "value": "h3", "label": "H3" },
      { "value": "h4", "label": "H4" },
      { "value": "h5", "label": "H5" },
      { "value": "p", "label": "Paragraph (p)" }
    ], "default": "p", "visible_if": "{{ section.settings.price_custom_font == false }}" },
    { "type": "font_picker", "id": "price_font", "label": "Font family", "default": "poppins_n4", "visible_if": "{{ section.settings.price_custom_font }}" },
    { "type": "range", "id": "price_font_size_desktop", "label": "Desktop text size", "min": 12, "max": 40, "step": 1, "unit": "px", "default": 18, "visible_if": "{{ section.settings.price_custom_font }}" },
    { "type": "range", "id": "price_font_size_mobile", "label": "Mobile text size", "min": 12, "max": 36, "step": 1, "unit": "px", "default": 16, "visible_if": "{{ section.settings.price_custom_font }}" },
    { "type": "range", "id": "price_font_weight", "label": "Font weight", "min": 100, "max": 900, "step": 100, "default": 600, "visible_if": "{{ section.settings.price_custom_font and section.settings.enable_advanced_settings == true }}" },

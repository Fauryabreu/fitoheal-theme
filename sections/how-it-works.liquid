<section id="shopify-section-{{ section.id }}" class="fh-hiw" style="background-color:{{ section.settings.bg_color }};">
  <div class="page-width">
    <div class="fh-hiw__grid">

      <!-- Izquierda: texto + pasos -->
      <div class="fh-hiw__content">
        {% if section.settings.titulo != blank %}
          <h2 class="fh-hiw__title">{{ section.settings.titulo }}</h2>
        {% endif %}

        <div class="fh-hiw__steps">
          {% for block in section.blocks %}
            {% if block.type == 'step' %}
              <div class="fh-step" {{ block.shopify_attributes }}>
                <div class="fh-step__num" aria-hidden="true">{{ forloop.index }}</div>
                <div>
                  {% if block.settings.titulo != blank %}
                    <p class="fh-step__title">{{ block.settings.titulo }}</p>
                  {% endif %}
                  {% if block.settings.descripcion != blank %}
                    <p class="fh-step__desc">{{ block.settings.descripcion }}</p>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        {% if section.settings.cta_label != blank %}
          <a href="{{ section.settings.cta_link | default: '#' }}" class="fh-btn fh-btn--outline" style="width:fit-content;">
            {{ section.settings.cta_label }}
          </a>
        {% endif %}
      </div>

      <!-- Derecha: imagen -->
      <div class="fh-hiw__img">
        {% if section.settings.imagen != blank %}
          {{ section.settings.imagen | image_url: width: 1000 | image_tag: loading: 'lazy', alt: section.settings.titulo }}
        {% else %}
          {{ 'lifestyle-2' | placeholder_svg_tag }}
        {% endif %}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "How It Works",
  "tag": "section",
  "settings": [
    { "type": "color",        "id": "bg_color",  "label": "Fondo",         "default": "#ffffff" },
    { "type": "text",         "id": "titulo",    "label": "Título",        "default": "Cómo funciona tu bienestar, simple." },
    { "type": "text",         "id": "cta_label", "label": "Texto botón",   "default": "Descubre tu objetivo" },
    { "type": "url",          "id": "cta_link",  "label": "Link botón" },
    { "type": "header",       "content": "Imagen" },
    { "type": "image_picker", "id": "imagen",    "label": "Imagen derecha" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "settings": [
        { "type": "text",     "id": "titulo",      "label": "Título del paso",  "default": "Elige tu objetivo" },
        { "type": "textarea", "id": "descripcion", "label": "Descripción",      "default": "Descubre el producto o kit ideal para ti." }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "How It Works",
      "blocks": [
        { "type": "step", "settings": { "titulo": "Elige tu objetivo",  "descripcion": "Descubre el producto o kit ideal para ti." } },
        { "type": "step", "settings": { "titulo": "Elige tu fórmula",   "descripcion": "Una o dos cápsulas al día según tu rutina." } },
        { "type": "step", "settings": { "titulo": "Crea tu rutina",     "descripcion": "La consistencia es la clave para sentir el cambio." } }
      ]
    }
  ]
}
{% endschema %}

<section
  id="shopify-section-{{ section.id }}"
  class="how-it-works section-padding"
  style="background-color: {{ section.settings.bg_color }};"
>
  <div class="page-width">

    <!-- Header -->
    <div class="section-header section-header--center">
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.title != blank %}
        <h2 class="h2">{{ section.settings.title }}</h2>
      {% endif %}
      <div class="divider divider--center"></div>
      {% if section.settings.subtitle != blank %}
        <p class="lead">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>

    <!-- Steps -->
    <div class="steps-grid">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'step' %}
            <div class="step-item" {{ block.shopify_attributes }}>
              <div class="step-item__number">{{ forloop.index }}</div>
              {% if block.settings.icon != blank %}
                <div class="step-item__icon" aria-hidden="true">{{ block.settings.icon }}</div>
              {% endif %}
              {% if block.settings.title != blank %}
                <h3 class="step-item__title">{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.description != blank %}
                <p class="step-item__desc">{{ block.settings.description }}</p>
              {% endif %}
            </div>
        {% endcase %}
      {% endfor %}
    </div>

    <!-- Optional comparison visual -->
    {% if section.settings.show_comparison %}
      <div style="margin-top: var(--spacing-3xl); padding: var(--spacing-xl); background: var(--color-cream); border-radius: var(--radius-xl); border: 1px solid var(--color-border);">
        <div style="display: grid; grid-template-columns: 1fr auto 1fr; gap: var(--spacing-xl); align-items: center; text-align: center;">

          <div>
            <p class="eyebrow" style="color: var(--color-text-muted); margin-bottom: var(--spacing-sm);">{{ section.settings.comparison_label_a | default: 'Suplemento estándar' }}</p>
            <div style="background: var(--color-white); border-radius: var(--radius-lg); padding: var(--spacing-lg); border: 1px solid var(--color-border);">
              <p style="font-family: var(--font-display); font-size: var(--font-size-3xl); font-weight: 600; color: var(--color-text-muted);">{{ section.settings.comparison_value_a | default: '15%' }}</p>
              <p style="font-size: var(--font-size-sm); color: var(--color-text-muted); margin-top: var(--spacing-xs);">{{ section.settings.comparison_desc_a | default: 'Absorción promedio' }}</p>
            </div>
          </div>

          <div style="font-family: var(--font-display); font-size: var(--font-size-2xl); color: var(--color-text-muted);">vs</div>

          <div>
            <p class="eyebrow" style="color: var(--color-brand-medium); margin-bottom: var(--spacing-sm);">{{ section.settings.comparison_label_b | default: 'Fitoheal Liposomal' }}</p>
            <div style="background: var(--color-brand-primary); border-radius: var(--radius-lg); padding: var(--spacing-lg);">
              <p style="font-family: var(--font-display); font-size: var(--font-size-3xl); font-weight: 600; color: var(--color-brand-light);">{{ section.settings.comparison_value_b | default: '90%+' }}</p>
              <p style="font-size: var(--font-size-sm); color: rgba(255,255,255,0.75); margin-top: var(--spacing-xs);">{{ section.settings.comparison_desc_b | default: 'Absorción liposomal' }}</p>
            </div>
          </div>

        </div>
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "How It Works",
  "tag": "section",
  "class": "how-it-works-wrapper",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Cómo funciona"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "La diferencia liposomal en 4 pasos"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Nuestra tecnología garantiza que cada nutriente llegue intacto a donde más se necesita."
    },
    {
      "type": "header",
      "content": "Absorption comparison"
    },
    {
      "type": "checkbox",
      "id": "show_comparison",
      "label": "Show comparison widget",
      "default": true
    },
    {
      "type": "text",
      "id": "comparison_label_a",
      "label": "Label A",
      "default": "Suplemento estándar"
    },
    {
      "type": "text",
      "id": "comparison_value_a",
      "label": "Value A",
      "default": "15%"
    },
    {
      "type": "text",
      "id": "comparison_desc_a",
      "label": "Description A",
      "default": "Absorción promedio"
    },
    {
      "type": "text",
      "id": "comparison_label_b",
      "label": "Label B",
      "default": "Fitoheal Liposomal"
    },
    {
      "type": "text",
      "id": "comparison_value_b",
      "label": "Value B",
      "default": "90%+"
    },
    {
      "type": "text",
      "id": "comparison_desc_b",
      "label": "Description B",
      "default": "Absorción liposomal"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji icon",
          "info": "Use an emoji or leave blank",
          "default": "🌿"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Step title",
          "default": "Seleccionamos ingredientes"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Step description",
          "default": "Solo materias primas de grado farmacéutico con certificado de origen."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "How It Works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "icon": "🌿",
            "title": "Ingredientes premium",
            "description": "Seleccionamos solo materias primas de grado farmacéutico con certificado de origen."
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "⚗️",
            "title": "Encapsulación liposomal",
            "description": "Envolvemos cada nutriente en liposomas que imitan la membrana celular."
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "🔬",
            "title": "Control de calidad",
            "description": "Triple análisis en laboratorio certificado antes de cada lote."
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "✨",
            "title": "Absorción celular",
            "description": "Los liposomas se fusionan con tus células entregando el nutriente directamente."
          }
        }
      ]
    }
  ]
}
{% endschema %}

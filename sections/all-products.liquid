<style>
  /* ── Section wrapper ── */
  .fh-ap {
    background-color: {{ section.settings.bg_color | default: 'var(--color-cream)' }};
  }

  /* ── Header hero ── */
  .fh-ap__header {
    position: relative;
    height: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    background-color: var(--color-brand-primary);
  }
  .fh-ap__header-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .fh-ap__header-overlay {
    position: absolute;
    inset: 0;
    background: rgba(27, 67, 50, 0.68);
  }
  .fh-ap__header-content {
    position: relative;
    z-index: 1;
    padding: 0 1.5rem;
    max-width: 640px;
  }
  .fh-ap__eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.75);
    margin-bottom: 0.625rem;
  }
  .fh-ap__header-title {
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 4vw, 2.5rem);
    font-weight: 600;
    color: #fff;
    line-height: 1.15;
    margin: 0 0 0.75rem;
  }
  .fh-ap__header-subtitle {
    font-family: var(--font-body);
    font-size: 1rem;
    color: rgba(255,255,255,0.82);
    line-height: 1.6;
    margin: 0 0 1.25rem;
  }

  /* ── Grid ── */
  .fh-ap__body {
    padding: clamp(3rem, 6vw, 5rem) 0;
  }
  .fh-ap__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  /* ── Card ── */
  .fh-ap-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--color-white);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    overflow: hidden;
    transition: transform 220ms ease-out, box-shadow 220ms ease-out;
  }
  .fh-ap-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  .fh-ap-card__img-wrap {
    position: relative;
    background: #f6fbf8;
    overflow: hidden;
    aspect-ratio: 1 / 1;
  }
  .fh-ap-card__img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 360ms ease;
  }
  .fh-ap-card:hover .fh-ap-card__img-wrap img {
    transform: scale(1.04);
  }
  .fh-ap-card__body {
    padding: 0.875rem 1rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .fh-ap-card__name {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-dark);
    margin: 0;
    line-height: 1.3;
  }
  .fh-ap-card__price {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-brand-primary);
  }

  /* ── Empty state ── */
  .fh-ap__empty {
    text-align: center;
    padding: 3rem 0;
    color: var(--color-text-muted);
    font-size: 1rem;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .fh-ap__grid { grid-template-columns: repeat(2, 1fr); gap: 1rem; }
    .fh-ap__header { height: 240px; }
  }
  @media (max-width: 480px) {
    .fh-ap__grid { grid-template-columns: 1fr; gap: 0.875rem; }
    .fh-ap__header { height: 200px; }
    .fh-ap__header-content { padding: 0 1rem; }
  }
</style>

<div id="shopify-section-{{ section.id }}" class="fh-ap">

  {%- comment -%} ── Header ── {%- endcomment -%}
  <div class="fh-ap__header">
    {%- if section.settings.imagen_header != blank -%}
      <img
        class="fh-ap__header-bg"
        src="{{ section.settings.imagen_header | image_url: width: 1400 }}"
        alt="{{ section.settings.titulo | escape }}"
        loading="eager"
        fetchpriority="high"
        width="1400"
        height="280"
      >
    {%- endif -%}
    <div class="fh-ap__header-overlay"></div>
    <div class="fh-ap__header-content">
      {%- if section.settings.eyebrow != blank -%}
        <span class="fh-ap__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.titulo != blank -%}
        <h2 class="fh-ap__header-title">{{ section.settings.titulo }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitulo != blank -%}
        <p class="fh-ap__header-subtitle">{{ section.settings.subtitulo }}</p>
      {%- endif -%}
      {%- if section.settings.btn_label != blank -%}
        <a href="{{ section.settings.btn_link | default: '#' }}" class="fh-btn fh-btn--white">
          {{ section.settings.btn_label }}
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ── Product grid ── {%- endcomment -%}
  <div class="fh-ap__body">
    <div class="page-width">
      {%- assign sort_by = section.settings.sort_by | default: 'manual' -%}
      {%- assign limit   = section.settings.productos_count | default: 8 -%}

      {%- if section.settings.coleccion != blank -%}
        {%- assign src_collection = section.settings.coleccion -%}
      {%- else -%}
        {%- assign src_collection = collections.all -%}
      {%- endif -%}

      {%- assign products_sorted = src_collection.products -%}

      {%- if sort_by == 'price-ascending' -%}
        {%- assign products_sorted = src_collection.products | sort: 'price' -%}
      {%- elsif sort_by == 'price-descending' -%}
        {%- assign products_sorted = src_collection.products | sort: 'price' | reverse -%}
      {%- elsif sort_by == 'created-descending' -%}
        {%- assign products_sorted = src_collection.products | sort: 'published_at' | reverse -%}
      {%- elsif sort_by == 'best-selling' -%}
        {%- assign products_sorted = src_collection.products | sort: 'best_selling' -%}
      {%- endif -%}

      {%- if products_sorted.size > 0 -%}
        <div class="fh-ap__grid">
          {%- for product in products_sorted limit: limit -%}
            <a href="{{ product.url }}" class="fh-ap-card" aria-label="{{ product.title | escape }}">
              <div class="fh-ap-card__img-wrap">
                {%- if product.featured_image -%}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    loading="lazy"
                    width="600"
                    height="600"
                  >
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'fh-ap-card__placeholder' }}
                {%- endif -%}
              </div>
              <div class="fh-ap-card__body">
                <p class="fh-ap-card__name">{{ product.title }}</p>
                <span class="fh-ap-card__price">{{ product.price_min | money }}</span>
              </div>
            </a>
          {%- endfor -%}
        </div>
      {%- else -%}
        <p class="fh-ap__empty">No hay productos disponibles.</p>
      {%- endif -%}
    </div>
  </div>

</div>

{% schema %}
{
  "name": "All Products",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Header de sección" },
    { "type": "image_picker", "id": "imagen_header",  "label": "Imagen de fondo" },
    { "type": "text",         "id": "eyebrow",        "label": "Eyebrow",         "default": "Catálogo completo" },
    { "type": "text",         "id": "titulo",         "label": "Título",           "default": "Nuestros productos" },
    { "type": "textarea",     "id": "subtitulo",      "label": "Subtítulo" },
    { "type": "text",         "id": "btn_label",      "label": "Texto botón CTA",  "default": "Ver todos los kits" },
    { "type": "url",          "id": "btn_link",       "label": "URL botón CTA" },
    { "type": "header", "content": "Productos" },
    { "type": "collection",   "id": "coleccion",      "label": "Colección" },
    {
      "type": "select",
      "id": "sort_by",
      "label": "Ordenar por",
      "default": "manual",
      "options": [
        { "value": "manual",            "label": "Orden del admin" },
        { "value": "best-selling",      "label": "Más vendidos" },
        { "value": "price-ascending",   "label": "Precio: menor a mayor" },
        { "value": "price-descending",  "label": "Precio: mayor a menor" },
        { "value": "created-descending","label": "Más recientes" }
      ]
    },
    {
      "type": "range",
      "id": "productos_count",
      "label": "Productos por página",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 8
    },
    { "type": "header", "content": "Estilo" },
    { "type": "color", "id": "bg_color", "label": "Color de fondo", "default": "#F4FBF5" }
  ],
  "presets": [
    {
      "name": "All Products"
    }
  ]
}
{% endschema %}

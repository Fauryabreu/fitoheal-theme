<style>
  /* ─────────────────────────────────────────
     ALL PRODUCTS — fh-ap-*
  ───────────────────────────────────────── */

  .fh-ap {
    background-color: {{ section.settings.bg_color }};
  }

  /* ── Header hero ── */
  .fh-ap__hero {
    position: relative;
    min-height: 320px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    background-color: #1b4332;
  }
  .fh-ap__hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .fh-ap__hero-overlay {
    position: absolute;
    inset: 0;
  }
  .fh-ap__hero-content {
    position: relative;
    z-index: 1;
    padding: 3rem 1.5rem;
    max-width: 680px;
  }
  .fh-ap__hero-eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #74c69d;
    margin-bottom: 0.75rem;
  }
  .fh-ap__hero-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    color: #fff;
    line-height: 1.1;
    margin: 0 0 1rem;
  }
  .fh-ap__hero-subtitle {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    color: rgba(255,255,255,0.78);
    line-height: 1.65;
    margin: 0 0 1.75rem;
  }
  .fh-ap__hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    color: #1b4332;
    background: #fff;
    padding: 0.75rem 1.75rem;
    border-radius: 100px;
    text-decoration: none;
    transition: background 220ms, color 220ms, transform 140ms;
  }
  .fh-ap__hero-btn:hover {
    background: #74c69d;
    color: #fff;
    transform: translateY(-2px);
  }

  /* ── Grid body ── */
  .fh-ap__body {
    padding: clamp(3rem, 6vw, 5rem) 0;
  }
  .fh-ap__grid {
    display: grid;
    grid-template-columns: repeat(var(--fh-ap-cols, 4), 1fr);
    gap: 1.5rem;
  }

  /* ── Card ── */
  .fh-ap-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: {{ section.settings.card_bg }};
    cursor: pointer;
  }
  .fh-ap-card__media {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #f6fbf8;
  }
  /* Primary image */
  .fh-ap-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 400ms ease, transform 600ms ease;
  }
  .fh-ap-card__img--primary {
    opacity: 1;
    z-index: 1;
  }
  .fh-ap-card__img--hover {
    opacity: 0;
    z-index: 2;
  }
  /* Crossfade on hover */
  .fh-ap-card:hover .fh-ap-card__img--primary {
    opacity: 0;
    transform: scale(1.04);
  }
  .fh-ap-card:hover .fh-ap-card__img--hover {
    opacity: 1;
  }
  /* Scale primary when no second image */
  .fh-ap-card:hover .fh-ap-card__img--only {
    transform: scale(1.04);
  }

  /* ── Hover button ── */
  .fh-ap-card__actions {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 3;
    padding: 0.875rem;
    transform: translateY(100%);
    transition: transform 280ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .fh-ap-card:hover .fh-ap-card__actions {
    transform: translateY(0);
  }
  .fh-ap-card__btn {
    display: block;
    width: 100%;
    position: relative;
    overflow: hidden;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-align: center;
    padding: 0.8125rem 1.25rem;
    border-radius: 6px;
    border: none;
    cursor: pointer;
    color: var(--fh-btn-text, #ffffff);
    background: transparent;
    isolation: isolate;
    transition: color 360ms ease;
  }
  /* Fill layer */
  .fh-ap-card__btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--fh-btn-bg, #1b4332);
    transform: translateX(-100%);
    transition: transform 360ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
    z-index: -1;
  }
  /* Outline layer (visible before fill) */
  .fh-ap-card__btn::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 6px;
    border: 1.5px solid var(--fh-btn-bg, #1b4332);
    opacity: 0;
    transition: opacity 280ms ease;
    pointer-events: none;
  }
  .fh-ap-card:hover .fh-ap-card__btn::before {
    transform: translateX(0);
  }
  .fh-ap-card:hover .fh-ap-card__btn::after {
    opacity: 1;
  }

  /* ── Card info ── */
  .fh-ap-card__info {
    padding: 0.875rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .fh-ap-card__name {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-dark);
    margin: 0;
    line-height: 1.3;
  }
  .fh-ap-card__price {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* ── Empty ── */
  .fh-ap__empty {
    text-align: center;
    padding: 4rem 0;
    color: var(--color-text-muted);
    font-size: 1rem;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .fh-ap__grid { --fh-ap-cols: 3; gap: 1rem; }
  }
  @media (max-width: 768px) {
    .fh-ap__grid { --fh-ap-cols: 2; gap: 0.875rem; }
    .fh-ap__hero { min-height: 260px; }
  }
  @media (max-width: 480px) {
    .fh-ap__grid { --fh-ap-cols: 2; gap: 0.75rem; }
    .fh-ap__hero { min-height: 220px; }
    .fh-ap__hero-title { font-size: 1.625rem; }
    .fh-ap-card__info { padding-top: 0.625rem; }
    .fh-ap-card__name { font-size: 0.8125rem; }
    .fh-ap-card__price { font-size: 0.75rem; }
  }
</style>

{%- liquid
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
  assign overlay_color   = section.settings.overlay_color
  assign cols            = section.settings.cols_desktop | default: 4
  assign limite          = section.settings.limite | default: 12
  assign show_price      = section.settings.show_price
  assign hover_img       = section.settings.hover_image
  assign btn_label       = section.settings.btn_label | default: 'Comprar ahora'
  assign btn_color       = section.settings.btn_color
  assign btn_text_color  = section.settings.btn_text_color

  if section.settings.coleccion != blank
    assign src = section.settings.coleccion
  else
    assign src = collections.all
  endif
-%}

<div id="shopify-section-{{ section.id }}" class="fh-ap" style="--fh-ap-cols: {{ cols }};">

  {%- comment -%}── Hero header ──{%- endcomment -%}
  {%- if section.settings.titulo != blank or section.settings.eyebrow != blank -%}
    <div class="fh-ap__hero">
      {%- if section.settings.imagen_header != blank -%}
        <img
          class="fh-ap__hero-bg"
          src="{{ section.settings.imagen_header | image_url: width: 1600 }}"
          alt="{{ section.settings.titulo | escape }}"
          loading="eager"
          fetchpriority="high"
          width="1600"
          height="320"
        >
      {%- endif -%}
      <div
        class="fh-ap__hero-overlay"
        style="background-color: {{ overlay_color }}; opacity: {{ overlay_opacity }};"
      ></div>
      <div class="fh-ap__hero-content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="fh-ap__hero-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="fh-ap__hero-title">{{ section.settings.titulo }}</h2>
        {%- if section.settings.subtitulo != blank -%}
          <p class="fh-ap__hero-subtitle">{{ section.settings.subtitulo }}</p>
        {%- endif -%}
        {%- if section.settings.header_btn_label != blank -%}
          <a href="{{ section.settings.header_btn_link | default: '#' }}" class="fh-ap__hero-btn">
            {{ section.settings.header_btn_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%}── Product grid ──{%- endcomment -%}
  <div class="fh-ap__body">
    <div class="page-width">
      {%- if src.products.size > 0 -%}
        <div class="fh-ap__grid">
          {%- for product in src.products limit: limite -%}
            <a
              href="{{ product.url }}"
              class="fh-ap-card"
              aria-label="{{ product.title | escape }}"
              style="--fh-btn-bg: {{ btn_color }}; --fh-btn-text: {{ btn_text_color }};"
            >
              <div class="fh-ap-card__media">

                {%- comment -%}Primary image{%- endcomment -%}
                {%- if product.featured_image -%}
                  <img
                    class="fh-ap-card__img fh-ap-card__img--primary"
                    src="{{ product.featured_image | image_url: width: 800 }}"
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    loading="lazy"
                    width="800"
                    height="1067"
                  >
                {%- else -%}
                  <div class="fh-ap-card__img fh-ap-card__img--primary" style="display:flex;align-items:center;justify-content:center;position:absolute;inset:0;">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {%- endif -%}

                {%- comment -%}Hover / second image{%- endcomment -%}
                {%- if hover_img and product.images[1] -%}
                  <img
                    class="fh-ap-card__img fh-ap-card__img--hover"
                    src="{{ product.images[1] | image_url: width: 800 }}"
                    alt="{{ product.images[1].alt | default: product.title | escape }}"
                    loading="lazy"
                    width="800"
                    height="1067"
                  >
                {%- elsif product.featured_image -%}
                  {%- comment -%}No second image — scale primary only{%- endcomment -%}
                {%- endif -%}

                {%- comment -%}CTA button on hover{%- endcomment -%}
                <div class="fh-ap-card__actions">
                  <span class="fh-ap-card__btn">{{ btn_label }}</span>
                </div>

              </div>

              <div class="fh-ap-card__info">
                <p class="fh-ap-card__name">{{ product.title }}</p>
                {%- if show_price -%}
                  <p class="fh-ap-card__price">{{ product.price_min | money }}</p>
                {%- endif -%}
              </div>
            </a>
          {%- endfor -%}
        </div>
      {%- else -%}
        <p class="fh-ap__empty">No hay productos disponibles.</p>
      {%- endif -%}
    </div>
  </div>

</div>

{% schema %}
{
  "name": "All Products",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Header de sección" },
    { "type": "image_picker", "id": "imagen_header",   "label": "Imagen de fondo" },
    { "type": "text",         "id": "eyebrow",         "label": "Eyebrow",              "default": "Catálogo completo" },
    { "type": "text",         "id": "titulo",          "label": "Título",               "default": "Nuestros productos" },
    { "type": "textarea",     "id": "subtitulo",       "label": "Subtítulo" },
    { "type": "text",         "id": "header_btn_label","label": "Texto botón header" },
    { "type": "url",          "id": "header_btn_link", "label": "Link botón header" },
    { "type": "color",        "id": "overlay_color",   "label": "Color overlay",        "default": "#1B4332" },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Opacidad overlay",
      "min": 0, "max": 90, "step": 5, "default": 60
    },
    { "type": "header", "content": "Grid de productos" },
    { "type": "collection", "id": "coleccion",    "label": "Colección" },
    {
      "type": "range",
      "id": "limite",
      "label": "Productos a mostrar",
      "min": 4, "max": 24, "step": 4, "default": 12
    },
    {
      "type": "range",
      "id": "cols_desktop",
      "label": "Columnas desktop",
      "min": 2, "max": 4, "step": 1, "default": 4
    },
    { "type": "color", "id": "bg_color",  "label": "Fondo sección", "default": "#FAFDF8" },
    { "type": "color", "id": "card_bg",   "label": "Fondo cards",   "default": "#FFFFFF" },
    { "type": "header", "content": "Cards" },
    { "type": "text",     "id": "btn_label",      "label": "Texto botón hover",  "default": "Comprar ahora" },
    { "type": "color",    "id": "btn_color",       "label": "Color fill botón",   "default": "#1B4332" },
    { "type": "color",    "id": "btn_text_color",  "label": "Color texto botón",  "default": "#FFFFFF" },
    { "type": "checkbox", "id": "show_price",      "label": "Mostrar precio",     "default": true },
    { "type": "checkbox", "id": "hover_image",     "label": "Segunda imagen en hover", "default": true }
  ],
  "presets": [
    { "name": "All Products" }
  ]
}
{% endschema %}

<style>
  /* ─────────────────────────────────────────
     ALL PRODUCTS — fh-ap-*
  ───────────────────────────────────────── */

  .fh-ap {
    background-color: {{ section.settings.bg_color }};
    padding: clamp(3rem, 6vw, 5rem) 0;
    overflow: hidden;
  }

  /* ── Header row ── */
  .fh-ap__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  .fh-ap__header-text {}
  .fh-ap__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    color: var(--color-brand-primary);
    line-height: 1.2;
    margin: 0;
  }
  .fh-ap__subtitle {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0.375rem 0 0;
    line-height: 1.5;
  }

  /* ── Arrow buttons ── */
  .fh-ap__arrows {
    display: flex;
    gap: 0.625rem;
    flex-shrink: 0;
  }
  .fh-ap__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1.5px solid var(--color-border);
    background: transparent;
    color: var(--color-text-dark);
    cursor: pointer;
    transition: background 200ms, color 200ms, border-color 200ms;
    flex-shrink: 0;
  }
  .fh-ap__arrow:hover {
    background: var(--color-brand-primary);
    color: #fff;
    border-color: var(--color-brand-primary);
  }
  .fh-ap__arrow svg {
    width: 18px;
    height: 18px;
    display: block;
    pointer-events: none;
  }

  /* ── Carousel track ── */
  .fh-ap__track {
    display: flex;
    gap: 1.5rem;
    overflow-x: scroll;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding-bottom: 1rem;
    cursor: grab;
    user-select: none;
  }
  .fh-ap__track::-webkit-scrollbar { display: none; }
  .fh-ap__track.is-dragging { cursor: grabbing; scroll-behavior: auto; }

  /* ── Card ── */
  .fh-ap-card {
    flex-shrink: 0;
    width: calc(25% - 1.125rem);
    scroll-snap-align: start;
    display: block;
    text-decoration: none;
    color: inherit;
    background: transparent;
    cursor: pointer;
    position: relative;
  }

  /* ── Card media ── */
  .fh-ap-card__media {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--color-cream);
  }
  .fh-ap-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    display: block;
    transition: opacity 400ms ease;
  }
  .fh-ap-card__img--primary {
    opacity: 1;
    z-index: 1;
  }
  .fh-ap-card__img--hover {
    opacity: 0;
    z-index: 2;
  }
  .fh-ap-card:hover .fh-ap-card__img--hover {
    opacity: 1;
  }

  /* ── CTA button on hover ── */
  .fh-ap-card__cta {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    opacity: 0;
    z-index: 3;
    transition: opacity 250ms ease, transform 250ms ease;
    white-space: nowrap;
    /* Fill layer */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.75rem;
    border: 1.5px solid #fff;
    border-radius: 4px;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    color: #fff;
    background: transparent;
    overflow: hidden;
    isolation: isolate;
    cursor: pointer;
    text-decoration: none;
  }
  .fh-ap-card__cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-brand-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 300ms ease;
    z-index: -1;
  }
  .fh-ap-card:hover .fh-ap-card__cta {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  .fh-ap-card__cta:hover::before {
    transform: scaleX(1);
  }

  /* ── Card info ── */
  .fh-ap-card__info {
    padding: 0.875rem 0.25rem;
  }
  .fh-ap-card__name {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-dark);
    margin: 0;
    line-height: 1.3;
  }
  .fh-ap-card__price {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0.25rem 0 0;
  }

  /* ── Empty state ── */
  .fh-ap__empty {
    text-align: center;
    padding: 4rem 0;
    color: var(--color-text-muted);
    font-size: 1rem;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .fh-ap__track { gap: 0.75rem; }
    .fh-ap-card { width: calc(33.333% - 0.5rem); }
  }
  @media (max-width: 480px) {
    .fh-ap__track { gap: 0.75rem; }
    .fh-ap-card { width: calc(50% - 0.375rem); }
    .fh-ap__subtitle { display: none; }
  }
</style>

{%- liquid
  assign limite    = section.settings.limite | default: 12
  assign btn_label = section.settings.btn_label | default: 'Comprar ahora'

  if section.settings.coleccion != blank
    assign src = section.settings.coleccion
  else
    assign src = collections.all
  endif
-%}

<section id="shopify-section-{{ section.id }}" class="fh-ap">
  <div class="page-width">

    <!-- Header -->
    <div class="fh-ap__header">
      <div class="fh-ap__header-text">
        {%- if section.settings.titulo != blank -%}
          <h2 class="fh-ap__title">{{ section.settings.titulo }}</h2>
        {%- endif -%}
        {%- if section.settings.show_subtitle and section.settings.subtitulo != blank -%}
          <p class="fh-ap__subtitle">{{ section.settings.subtitulo }}</p>
        {%- endif -%}
      </div>
      <div class="fh-ap__arrows" aria-label="Navegación carrusel">
        <button class="fh-ap__arrow fh-ap__arrow--prev" aria-label="Anterior" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 18l-6-6 6-6"/>
          </svg>
        </button>
        <button class="fh-ap__arrow fh-ap__arrow--next" aria-label="Siguiente" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 18l6-6-6-6"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Carousel -->
    {%- if src.products.size > 0 -%}
      <div class="fh-ap__track" role="list">
        {%- for product in src.products limit: limite -%}
          <a
            href="{{ product.url }}"
            class="fh-ap-card"
            role="listitem"
            aria-label="{{ product.title | escape }}"
          >
            <div class="fh-ap-card__media">

              <!-- Primary image -->
              {%- if product.featured_image -%}
                <img
                  class="fh-ap-card__img fh-ap-card__img--primary"
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="800"
                  height="1067"
                >
              {%- else -%}
                <div class="fh-ap-card__img fh-ap-card__img--primary" style="display:flex;align-items:center;justify-content:center;">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {%- endif -%}

              <!-- Hover image -->
              {%- if product.images[1] -%}
                <img
                  class="fh-ap-card__img fh-ap-card__img--hover"
                  src="{{ product.images[1] | image_url: width: 800 }}"
                  alt="{{ product.images[1].alt | default: product.title | escape }}"
                  loading="lazy"
                  width="800"
                  height="1067"
                >
              {%- endif -%}

              <!-- CTA -->
              <span class="fh-ap-card__cta">{{ btn_label }}</span>

            </div>
            <div class="fh-ap-card__info">
              <p class="fh-ap-card__name">{{ product.title }}</p>
              <p class="fh-ap-card__price">{{ product.price_min | money }}</p>
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="fh-ap__empty">No hay productos disponibles.</p>
    {%- endif -%}

  </div>
</section>

<script>
(function () {
  var section = document.getElementById('shopify-section-{{ section.id }}');
  if (!section) return;

  var track = section.querySelector('.fh-ap__track');
  var btnPrev = section.querySelector('.fh-ap__arrow--prev');
  var btnNext = section.querySelector('.fh-ap__arrow--next');
  if (!track) return;

  /* ── Arrow scroll ── */
  function getCardWidth() {
    var first = track.firstElementChild;
    if (!first) return 0;
    var style = window.getComputedStyle(track);
    var gap = parseFloat(style.columnGap || style.gap) || 0;
    return first.getBoundingClientRect().width + gap;
  }

  if (btnPrev) {
    btnPrev.addEventListener('click', function () {
      track.scrollBy({ left: -getCardWidth(), behavior: 'smooth' });
    });
  }
  if (btnNext) {
    btnNext.addEventListener('click', function () {
      track.scrollBy({ left: getCardWidth(), behavior: 'smooth' });
    });
  }

  /* ── Drag to scroll ── */
  var isDragging = false;
  var startX = 0;
  var startScroll = 0;

  track.addEventListener('mousedown', function (e) {
    isDragging = true;
    startX = e.pageX;
    startScroll = track.scrollLeft;
    track.classList.add('is-dragging');
  });

  document.addEventListener('mousemove', function (e) {
    if (!isDragging) return;
    e.preventDefault();
    var dx = e.pageX - startX;
    track.scrollLeft = startScroll - dx;
  });

  document.addEventListener('mouseup', function () {
    if (!isDragging) return;
    isDragging = false;
    track.classList.remove('is-dragging');
  });

  /* Prevent link navigation on drag */
  track.addEventListener('click', function (e) {
    if (Math.abs(track.scrollLeft - startScroll) > 5) {
      e.preventDefault();
    }
  }, true);
})();
</script>

{% schema %}
{
  "name": "All Products",
  "tag": "section",
  "settings": [
    { "type": "text",     "id": "titulo",       "label": "Título",               "default": "Nuestros productos" },
    { "type": "textarea", "id": "subtitulo",    "label": "Subtítulo" },
    { "type": "checkbox", "id": "show_subtitle","label": "Mostrar subtítulo",    "default": true },
    { "type": "header",   "content": "Productos" },
    { "type": "collection", "id": "coleccion",  "label": "Colección" },
    {
      "type": "range",
      "id": "limite",
      "label": "Productos a mostrar",
      "min": 4, "max": 24, "step": 4, "default": 12
    },
    { "type": "header", "content": "Estilo" },
    { "type": "color",  "id": "bg_color",   "label": "Fondo sección", "default": "#FAFDF8" },
    { "type": "text",   "id": "btn_label",  "label": "Texto botón cards", "default": "Comprar ahora" }
  ],
  "presets": [
    { "name": "All Products" }
  ]
}
{% endschema %}

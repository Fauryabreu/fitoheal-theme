                    {% endif %}
                  </div>
                {% endif %}

                {% if block.settings.product != blank %}
                  {%- assign prod = block.settings.product -%}
                  {%- assign product_title = block.settings.product_title_override | default: prod.title -%}
                  {%- assign price = prod.price -%}
                  {%- assign compare_at = prod.compare_at_price_max | default: prod.compare_at_price -%}
                  <a class="vso-shoppable-video__product" href="{{ prod.url }}">
                    <span class="vso-shoppable-video__product-image">
                      {% if block.settings.product_image_override != blank %}
                        {{ block.settings.product_image_override | image_url: width: 120 | image_tag: loading: 'lazy' }}
                      {% elsif prod.featured_image %}
                        {{ prod.featured_image | image_url: width: 120 | image_tag: loading: 'lazy' }}
                      {% endif %}
                    </span>
                    <span class="vso-shoppable-video__product-meta">
                      {%- assign product_title_tag = section.settings.product_title_as | default: 'p' -%}
                      <{{ product_title_tag }} class="vso-shoppable-video__product-title">{{ product_title }}</{{ product_title_tag }}>
                      {% if section.settings.show_product_price %}
                        {%- assign product_price_tag = section.settings.product_price_as | default: 'p' -%}
                        <{{ product_price_tag }} class="vso-shoppable-video__product-price">
                          <span>{{ price | money }}</span>
                          {% if compare_at and compare_at > price %}
                            <s class="vso-shoppable-video__product-compare">{{ compare_at | money }}</s>
                          {% endif %}
                        </{{ product_price_tag }}>
                      {% endif %}
                    </span>
                  </a>
                {% endif %}
              </div>
            </div>
            {% endfor %}
          {% endfor %}
        </div>
        <div class="vso-shoppable-video__nav-overlay vso-shoppable-video__nav-overlay-prev vso-shoppable-video__nav-prev">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="transform: scaleX(-1);">
            <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
            <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
            <g id="SVGRepo_iconCarrier">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M8.29289 4.29289C8.68342 3.90237 9.31658 3.90237 9.70711 4.29289L16.7071 11.2929C17.0976 11.6834 17.0976 12.3166 16.7071 12.7071L9.70711 19.7071C9.31658 20.0976 8.68342 20.0976 8.29289 19.7071C7.90237 19.3166 7.90237 18.6834 8.29289 18.2929L14.5858 12L8.29289 5.70711C7.90237 5.31658 7.90237 4.68342 8.29289 4.29289Z" fill="currentColor"></path>
            </g>
          </svg>
        </div>
        <div class="vso-shoppable-video__nav-overlay vso-shoppable-video__nav-overlay-next vso-shoppable-video__nav-next">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
            <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
            <g id="SVGRepo_iconCarrier">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M8.29289 4.29289C8.68342 3.90237 9.31658 3.90237 9.70711 4.29289L16.7071 11.2929C17.0976 11.6834 17.0976 12.3166 16.7071 12.7071L9.70711 19.7071C9.31658 20.0976 8.68342 20.0976 8.29289 19.7071C7.90237 19.3166 7.90237 18.6834 8.29289 18.2929L14.5858 12L8.29289 5.70711C7.90237 5.31658 7.90237 4.68342 8.29289 4.29289Z" fill="currentColor"></path>

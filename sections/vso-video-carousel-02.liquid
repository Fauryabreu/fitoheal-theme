          {% else %}
            {%- assign heading_tag = section.settings.heading_as | default: 'h2' -%}
            <{{ heading_tag }} class="vso-shoppable-video__heading">
              {{ section.settings.heading }}
            </{{ heading_tag }}>
          {% endif %}
        {% endif %}

        {% if section.settings.description != blank %}
          {% if section.settings.custom_description_font %}

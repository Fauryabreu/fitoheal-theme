<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>

<script defer>
document.addEventListener('DOMContentLoaded', function() {

const autoplayEnabled = {{ section.settings.video_autoplay | json }};
let globalMuted = (localStorage.getItem('vsoShoppableVideoMuted') ?? 'true') === 'true';
const PRIMER_DURATION_MS = 0; 

function primeAllVideosForThumbnails() {
}

function handleCenteredVideo() {
  const allVideos = document.querySelectorAll('video.vso-shoppable-video__video');
  allVideos.forEach(v => {
    if (!v.paused) {
      v.pause();
    }
    const container = v.closest('[data-video-container]');
    const playButton = container?.querySelector('[data-play-button]');
    if (playButton) {
      const playIcon = playButton.querySelector('.vso-shoppable-video__play-icon');
      const pauseIcon = playButton.querySelector('.vso-shoppable-video__pause-icon');
      if (playIcon && pauseIcon) {
        playIcon.style.display = 'block';
        pauseIcon.style.display = 'none';
      }
    }
  });

  if (autoplayEnabled) {
    const activeSlide = document.querySelector('.vso-shoppable-video__swiper .swiper-slide-active');
    if (activeSlide) {
      const video = activeSlide.querySelector('video.vso-shoppable-video__video');
      if (video) {
        video.muted = true;
        video.setAttribute('playsinline', 'true');
        video.play().then(() => {
          video.muted = globalMuted;
        }).catch((error) => {
          console.log('Autoplay prevented:', error);
        });
        const container = video.closest('[data-video-container]');
        const muteButton = container?.querySelector('[data-mute-button]');
        if (muteButton) {
          const volOn = muteButton.querySelector('.vso-shoppable-video__volume-on-icon');
          const volOff = muteButton.querySelector('.vso-shoppable-video__volume-off-icon');
          if (volOn && volOff) {
            if (globalMuted) { volOn.style.display = 'none'; volOff.style.display = 'block'; }
            else { volOn.style.display = 'block'; volOff.style.display = 'none'; }
          }
        }
        const playButton = container?.querySelector('[data-play-button]');
        if (playButton) {
          const playIcon = playButton.querySelector('.vso-shoppable-video__play-icon');
          const pauseIcon = playButton.querySelector('.vso-shoppable-video__pause-icon');
          if (playIcon && pauseIcon) {
            playIcon.style.display = 'none';
            pauseIcon.style.display = 'block';
          }
        }
      }
    }
  }
}

const shoppableVideoSwiper = new Swiper('.vso-shoppable-video__swiper', {
  loop: true,
  centeredSlides: true,
  slidesPerView: 3,
  spaceBetween: {{ desktop_blocks_gap }},
  grabCursor: false,
  speed: 600,
  loopAdditionalSlides: 2,

  watchSlidesProgress: true,

  navigation: {
    nextEl: '.vso-shoppable-video__nav-next',
    prevEl: '.vso-shoppable-video__nav-prev',
  },

  breakpoints: {
    0: {
      spaceBetween: {{ mobile_blocks_gap }},
      centeredSlides: true,
      slidesPerView: 1.5,
      loop: true,
    },
    750: {
      spaceBetween: {{ desktop_blocks_gap }},
      centeredSlides: true,
      slidesPerView: 5,
      loop: true,
    }
  },

  on: {
    init: function() {
      setTimeout(() => {
        handleCenteredVideo();
        updateEdgeSlides();
        positionOverlayArrows(this);
      }, 100);
    },
    slideChange: function() { updateEdgeSlides(); },
    slideChangeTransitionStart: function() { updateEdgeSlides(); },
    slideChangeTransitionEnd: function() {
      handleCenteredVideo();
      updateEdgeSlides();
    },
    setTranslate: function() { updateEdgeSlides(); },
    resize: function() {
      updateEdgeSlides();
      positionOverlayArrows(this);
    }
  }
});


function updateEdgeSlides() {
  const swiperEl = document.querySelector('.vso-shoppable-video__swiper');
  if (!swiperEl) return;

  const allSlides = swiperEl.querySelectorAll('.swiper-slide');
  allSlides.forEach(slide => slide.classList.remove('vso-edge-slide'));

  if (!window.matchMedia('(min-width: 750px)').matches) return;

}

function positionOverlayArrows(swiper) {
  if (!swiper || !swiper.el) return;
  const isDesktop = window.matchMedia('(min-width: 750px)').matches;
  const overlayPrev = swiper.el.querySelector('.vso-shoppable-video__nav-overlay-prev');
  const overlayNext = swiper.el.querySelector('.vso-shoppable-video__nav-overlay-next');
  if (!overlayPrev || !overlayNext) return;

  if (!isDesktop) {
    overlayPrev.style.display = 'none';
    overlayNext.style.display = 'none';
    return;
  }

  overlayPrev.style.display = 'flex';
  overlayNext.style.display = 'flex';

  const containerWidth = swiper.width;
  const containerHeight = swiper.height;

  const bp = swiper.params.breakpoints || {};
  const desktopParams = bp[750] || {};
  const slidesPerView = desktopParams.slidesPerView || swiper.params.slidesPerView || 5;
  const spaceBetween = (desktopParams.spaceBetween ?? swiper.params.spaceBetween ?? 0);

  const slideWidth = (containerWidth - (slidesPerView - 1) * spaceBetween) / slidesPerView;

  const leftX = slideWidth + spaceBetween;
  const rightX = 3 * (slideWidth + spaceBetween) + slideWidth;

  const inset = 10; // px

  let centerY = containerHeight / 2;
  const firstVideo = swiper.el.querySelector('.swiper-slide .vso-shoppable-video__video-container');
  if (firstVideo) {
    const sRect = swiper.el.getBoundingClientRect();
    const vRect = firstVideo.getBoundingClientRect();
    centerY = (vRect.top - sRect.top) + (vRect.height / 2);
  }

  overlayPrev.style.top = centerY + 'px';
  overlayPrev.style.left = (leftX + inset) + 'px';

  overlayNext.style.top = centerY + 'px';
  overlayNext.style.left = (rightX - inset) + 'px';
}

const videoContainers = document.querySelectorAll('[data-video-container]');
videoContainers.forEach(container => {
  const video = container.querySelector('video');
  const playButton = container.querySelector('[data-play-button]');
  const muteButton = container.querySelector('[data-mute-button]');

  if (video) {
    const playIcon = playButton ? playButton.querySelector('.vso-shoppable-video__play-icon') : null;
    const pauseIcon = playButton ? playButton.querySelector('.vso-shoppable-video__pause-icon') : null;
    const volOnIcon = muteButton ? muteButton.querySelector('.vso-shoppable-video__volume-on-icon') : null;
    const volOffIcon = muteButton ? muteButton.querySelector('.vso-shoppable-video__volume-off-icon') : null;

    video.muted = globalMuted;
    if (volOnIcon && volOffIcon) {
      if (globalMuted) { volOnIcon.style.display = 'none'; volOffIcon.style.display = 'block'; }
      else { volOnIcon.style.display = 'block'; volOffIcon.style.display = 'none'; }
    }

    const togglePlayPause = (e) => {
      e.preventDefault();
      e.stopPropagation();

      const slide = video.closest('.swiper-slide');
      if (!slide || !slide.classList.contains('swiper-slide-active')) {
        return;
      }

      if (video.paused) {
        video.play();
        if (playIcon && pauseIcon) {
          playIcon.style.display = 'none';
          pauseIcon.style.display = 'block';
        }
      } else {
        video.pause();
        if (playIcon && pauseIcon) {
          playIcon.style.display = 'block';
          pauseIcon.style.display = 'none';
        }
      }
    };

    video.addEventListener('click', togglePlayPause);

    const updateCursor = () => {
      const slide = video.closest('.swiper-slide');
      video.style.cursor = (slide && slide.classList.contains('swiper-slide-active')) ? 'pointer' : 'default';
    };
    updateCursor();

    if (shoppableVideoSwiper) {
      shoppableVideoSwiper.on('slideChange', updateCursor);
    }

    if (playButton) {
      playButton.addEventListener('click', togglePlayPause);
    }

    if (muteButton) {
      muteButton.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        globalMuted = !globalMuted;
        localStorage.setItem('vsoShoppableVideoMuted', globalMuted ? 'true' : 'false');
        document.querySelectorAll('video.vso-shoppable-video__video').forEach(v => { v.muted = globalMuted; });
        document.querySelectorAll('[data-mute-button]').forEach(btn => {
          const onI = btn.querySelector('.vso-shoppable-video__volume-on-icon');
          const offI = btn.querySelector('.vso-shoppable-video__volume-off-icon');
          if (onI && offI) {
            if (globalMuted) { onI.style.display = 'none'; offI.style.display = 'block'; }
            else { onI.style.display = 'block'; offI.style.display = 'none'; }
          }
        });
      });
    }

    if (playIcon && pauseIcon) {
      video.addEventListener('play', () => {
        playIcon.style.display = 'none';
        pauseIcon.style.display = 'block';
      });

      video.addEventListener('pause', () => {
        playIcon.style.display = 'block';
        pauseIcon.style.display = 'none';
      });
    }
  }
});
});
</script>


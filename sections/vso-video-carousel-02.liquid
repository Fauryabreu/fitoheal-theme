{% comment %}
WARNING: UNAUTHORIZED MODIFICATION PROHIBITED
This code is proprietary property of Versio Studio. Any unauthorized tampering,
alteration, or distribution of this file is strictly forbidden and will be prosecuted to the maximum extent permitted by law.
All modifications are logged.

If you require assistance or have questions regarding this code, please contact support@versio.studio.
{% endcomment %}

{%- liquid
  assign text_alignment = 'left'
  assign blocks_alignment_desktop = 'left'
  assign blocks_alignment_mobile = 'left'
  assign desktop_blocks_gap = 4
  assign mobile_blocks_gap = 4
  assign header_blocks_gap = 0
  assign full_width = section.settings.full_width
  assign content_width = section.settings.content_width

  assign image_border_radius = section.settings.block_border_radius | minus: section.settings.block_border_width
  if image_border_radius < 0
    assign image_border_radius = 0
  endif
-%}

{%- style -%}
  .vd-l { display: none !important; }
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {{ section.settings.description_font | font_face: font_display: 'swap' }}
  {{ section.settings.product_title_font | font_face: font_display: 'swap' }}
  {{ section.settings.product_price_font | font_face: font_display: 'swap' }}
  {{ section.settings.video_heading_font | font_face: font_display: 'swap' }}
  {{ section.settings.video_description_font | font_face: font_display: 'swap' }}

  {% if section.settings.custom_heading_font %}
    #ShoppableVideo-{{ section.id }} .vso-shoppable-video__heading {
      font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
      font-style: {{ section.settings.heading_font.style }};
    }
  {% endif %}

  {% if section.settings.custom_description_font %}
    #ShoppableVideo-{{ section.id }} .vso-shoppable-video__description {
      font-family: {{ section.settings.description_font.family }}, {{ section.settings.description_font.fallback_families }};
      font-style: {{ section.settings.description_font.style }};
    }
  {% endif %}

  .vso-shoppable-video {
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .vso-shoppable-video__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: {{ header_blocks_gap }}px;
    width: 100%;
    position: relative;
  }

  .vso-shoppable-video__header-content {
    max-width: 60%;
    flex: 1;
  }

  .vso-shoppable-video__heading {
    margin: 0;
    text-align: {{ text_alignment }};
  }

  {% if section.settings.custom_heading_font %}
    .vso-shoppable-video__heading {
      line-height: {{ section.settings.heading_line_height }}%;
      font-size: {{ section.settings.heading_size_desktop }}px;
      color: {{ section.settings.heading_color }};
      font-weight: {{ section.settings.heading_font_weight }};
    }
  {% endif %}

  .vso-shoppable-video__description {
    margin: 0;
    text-align: {{ text_alignment }};
    margin-top: {{ section.settings.description_top_spacing }}px;
    margin-bottom: {{ section.settings.description_bottom_spacing }}px;
  }

  {% if section.settings.custom_description_font %}
    .vso-shoppable-video__description {
      font-size: {{ section.settings.description_size_desktop }}px;
      color: {{ section.settings.description_color }};
      line-height: {{ section.settings.description_line_height }}%;
    }
  {% endif %}

  @media screen and (min-width: 750px) {
    {% if section.settings.header_alignment_desktop == 'center' %}
      .vso-shoppable-video__header {
        flex-direction: column;
        align-items: center;
        text-align: center;
      }
      .vso-shoppable-video__header-content {
        max-width: 100%;
        text-align: center;
        margin-bottom: 20px;
      }
      .vso-shoppable-video__heading,
      .vso-shoppable-video__description {
        text-align: center;
      }
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    .vso-shoppable-video__header {
      flex-direction: column;
      align-items: {% if section.settings.header_alignment_mobile == 'center' %}center{% else %}flex-start{% endif %};
      text-align: {% if section.settings.header_alignment_mobile == 'center' %}center{% else %}left{% endif %};
    }

    .vso-shoppable-video__header-content {
      max-width: 100%;
      text-align: {% if section.settings.header_alignment_mobile == 'center' %}center{% else %}left{% endif %};
      margin-bottom: 20px;
    }

    .vso-shoppable-video__heading {
      text-align: {% if section.settings.header_alignment_mobile == 'center' %}center{% else %}left{% endif %};
    }

    .vso-shoppable-video__description {
      text-align: {% if section.settings.header_alignment_mobile == 'center' %}center{% else %}left{% endif %};
    }

    .vso-shoppable-video__navigation {
      display: none;
    }

    {% unless section.settings.show_navigation_mobile %}
      .vso-shoppable-video__navigation-mobile {
        display: none;
      }
    {% endunless %}
  }

  .vso-shoppable-video__swiper {
    width: 100%;
    padding:0px !important;
    overflow: visible;
    position: relative;
  }

  @media screen and (min-width: 750px) {
    .vso-shoppable-video__swiper {
      overflow: visible;
    }

    .vso-shoppable-video__swiper .swiper-slide {
      opacity: 0.5;
      transition: opacity 0.3s ease, transform 0.3s ease;
      transform: scale(0.9);
    }

    .vso-shoppable-video__swiper .swiper-slide-active {
      opacity: 1;
      transform: scale(1);
    }

    .vso-shoppable-video__swiper .swiper-slide-prev,
    .vso-shoppable-video__swiper .swiper-slide-next {
      transform: scale(0.95);
      opacity: 1;
    }
  }

  .vso-node { display: none; }
  .vso-node--v2 { display: block; }

  .vso-shoppable-video__nav-overlay {
    position: absolute;
    display: none; 
    align-items: center;
    justify-content: center;
    z-index: 20;
    transform: translate(-50%, -50%);
    pointer-events: auto;
  }
  @media screen and (min-width: 750px) {
    .vso-shoppable-video__navigation { display: none !important; }
    .vso-shoppable-video__nav-overlay { display: flex; }
  }
  @media screen and (max-width: 749px) {
    .vso-shoppable-video__nav-overlay { display: none !important; }
  }

  .vso-shoppable-video__slide {
  }

  @media screen and (max-width: 749px) {
    .vso-shoppable-video__slide {
      width: auto;
    }
  }

  .vso-shoppable-video__block {
    display: flex;
    flex-direction: column;
    align-items: {{ blocks_alignment_desktop }};
    padding: 0;
    background-color: transparent;
    border-radius: {{ section.settings.block_border_radius }}px;
    border: none;
    text-align: {{ blocks_alignment_desktop }};
    transition: transform 0.3s ease;
    overflow: visible;
  }

  .vso-shoppable-video__video-container {
    position: relative;
    width: 100%;
    margin: 0 0 {{ section.settings.video_to_content_gap }}px 0;
    border-radius: {{ section.settings.block_border_radius }}px;
    overflow: hidden;
    background-color: transparent;
  }

  .vso-shoppable-video__video-container::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 35%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0.3) 30%, transparent 100%);
    pointer-events: none;
    z-index: 5;
  }

  .vso-shoppable-video__play-button {
    position: absolute;
    bottom: 20px;
    right: 20px;
    width: {{ section.settings.video_button_size }}px;
    height: {{ section.settings.video_button_size }}px;
    border-radius: {{ section.settings.video_button_border_radius }}px;
    background: {{ section.settings.video_button_bg_color }};
    backdrop-filter: blur(10px);
    border: {{ section.settings.video_button_border_width }}px solid {{ section.settings.video_button_border_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    z-index: 10;
  }

  .vso-shoppable-video__play-button:hover {
    transform: scale(1.05);
  }

  .vso-shoppable-video__play-icon,
  .vso-shoppable-video__pause-icon {
    width: {{ section.settings.video_button_size | times: 0.45 | round: 0 }}px;
    height: {{ section.settings.video_button_size | times: 0.45 | round: 0 }}px;
    color: {{ section.settings.video_button_icon_color }};
  }

  .vso-shoppable-video__overlay-text {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 80px;
    color: #ffffff;
    z-index: 10;
  }

  .vso-shoppable-video__mute-button {
    position: absolute;
    top: 20px;
    right: 20px;
    width: {{ section.settings.video_button_size }}px;
    height: {{ section.settings.video_button_size }}px;
    border-radius: {{ section.settings.video_button_border_radius }}px;
    background: {{ section.settings.video_button_bg_color }};
    backdrop-filter: blur(10px);
    border: {{ section.settings.video_button_border_width }}px solid {{ section.settings.video_button_border_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    z-index: 10;
  }

  .vso-shoppable-video__mute-button:hover { transform: scale(1.05); }

  .vso-shoppable-video__volume-on-icon,
  .vso-shoppable-video__volume-off-icon {
    width: {{ section.settings.video_button_size | times: 0.45 | round: 0 }}px;
    height: {{ section.settings.video_button_size | times: 0.45 | round: 0 }}px;
    color: {{ section.settings.video_button_icon_color }};
  }

  .vso-shoppable-video__video-container .vso-shoppable-video__mute-button { display: none; }
  .vso-shoppable-video__swiper .swiper-slide-active .vso-shoppable-video__mute-button { display: flex; }

  .vso-shoppable-video__overlay-heading {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 4px 0;
    display: flex;
    align-items: center;
    gap: 6px;
    color: #ffffff;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  {% if section.settings.custom_video_heading_font %}
    .vso-shoppable-video__overlay-heading {
      line-height: {{ section.settings.video_heading_line_height }}%;
      font-size: {{ section.settings.video_heading_size_desktop }}px;
      color: {{ section.settings.video_heading_color }};
      font-weight: {{ section.settings.video_heading_font_weight }};
      font-family: {{ section.settings.video_heading_font.family }}, {{ section.settings.video_heading_font.fallback_families }};
      font-style: {{ section.settings.video_heading_font.style }};
    }
  {% endif %}

  .vso-shoppable-video__verified-badge {
    width: 20px;
    height: 20px;
    color: #1DA1F2;
    flex-shrink: 0;
  }

  .vso-shoppable-video__overlay-description {
    font-size: 14px;
    font-weight: 400;
    line-height: 1.4;
    margin: 0;
    color: #ffffff;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  {% if section.settings.custom_video_description_font %}
    .vso-shoppable-video__overlay-description {
      font-size: {{ section.settings.video_description_size_desktop }}px;
      color: {{ section.settings.video_description_color }};
      line-height: {{ section.settings.video_description_line_height }}%;
      font-family: {{ section.settings.video_description_font.family }}, {{ section.settings.video_description_font.fallback_families }};
      font-style: {{ section.settings.video_description_font.style }};
    }
  {% endif %}

  .vso-shoppable-video__video {
    width: 100%;
    aspect-ratio: 9 / 16;
    object-fit: cover;
    display: block;
  }

  .vso-shoppable-video__video-placeholder {
    width: 100%;
    aspect-ratio: 9 / 16;
    object-fit: cover;
    display: block;
    background-color: #f3f4f6;
  }

  .vso-shoppable-video__product {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 12px;
    border: 1px solid {{ section.settings.product_pill_border_color }};
    background: {{ section.settings.product_pill_bg_color }};
    border-radius: {{ section.settings.product_container_border_radius }}px;
    padding: 10px;
    margin: 0;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .vso-shoppable-video__product-image {
    width: 56px;
    height: 56px;
    border-radius: {{ section.settings.product_image_border_radius }}px;
    overflow: hidden;
    flex-shrink: 0;
    display: block;
    background: #f2f2f2;
  }

  .vso-shoppable-video__product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .vso-shoppable-video__product-meta {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .vso-shoppable-video__product-title { margin: 0; }

  .vso-shoppable-video__product-price { display: flex; align-items: center; gap: 8px; margin: 0; }

  .vso-shoppable-video__product-compare {
    color: {{ section.settings.product_compare_price_color }};
    text-decoration: line-through;
    font-weight: 600;
  }

  {% if section.settings.custom_product_title_font %}
    #ShoppableVideo-{{ section.id }} .vso-shoppable-video__product-title {
      font-family: {{ section.settings.product_title_font.family }}, {{ section.settings.product_title_font.fallback_families }};
      font-style: {{ section.settings.product_title_font.style }};
      line-height: {{ section.settings.product_title_line_height }}%;
      font-size: {{ section.settings.product_title_size_desktop }}px;
      font-weight: {{ section.settings.product_title_font_weight }};
      color: {{ section.settings.product_title_color }};
    }
  {% endif %}

  {% if section.settings.custom_product_price_font %}
    #ShoppableVideo-{{ section.id }} .vso-shoppable-video__product-price {
      font-family: {{ section.settings.product_price_font.family }}, {{ section.settings.product_price_font.fallback_families }};
      font-style: {{ section.settings.product_price_font.style }};
      line-height: {{ section.settings.product_price_line_height }}%;
      font-size: {{ section.settings.product_price_size_desktop }}px;
      font-weight: {{ section.settings.product_price_font_weight }};
      color: {{ section.settings.product_price_color }};
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    .vso-shoppable-video__swiper {
      padding: 30px 0px !important;
      overflow: visible;
      width: 100%;
    }

    .vso-shoppable-video__slide {
      width: auto;
    }

    .vso-shoppable-video__swiper .swiper-slide { transition: opacity 0.3s ease, transform 0.3s ease; transform: scale(0.94); }
    .vso-shoppable-video__swiper .swiper-slide-active { transform: scale(1); }
    .vso-shoppable-video__swiper .swiper-slide-prev,
    .vso-shoppable-video__swiper .swiper-slide-next { transform: scale(0.97); }

    .section-{{ section.id }}-settings {
      overflow: hidden;
    }

    .vso-shoppable-video {
      overflow: hidden;
    }

    .section-{{ section.id }} {
      overflow: hidden;
    }

    {% if section.settings.custom_heading_font %}
      .vso-shoppable-video__heading {
        font-size: {{ section.settings.heading_size_mobile }}px;
      }
    {% endif %}

    {% if section.settings.custom_description_font %}
      .vso-shoppable-video__description {
        font-size: {{ section.settings.description_size_mobile }}px;
      }
    {% endif %}

    {% if section.settings.custom_video_heading_font %}
      .vso-shoppable-video__overlay-heading { font-size: {{ section.settings.video_heading_size_mobile }}px; }
    {% endif %}
    {% if section.settings.custom_video_description_font %}
      .vso-shoppable-video__overlay-description { font-size: {{ section.settings.video_description_size_mobile }}px; }
    {% endif %}

    .vso-shoppable-video__block {
      align-items: {{ blocks_alignment_mobile }};
      text-align: {{ blocks_alignment_mobile }};
    }

    {% if section.settings.custom_product_title_font %}
      .vso-shoppable-video__product-title { font-size: {{ section.settings.product_title_size_mobile }}px; }
    {% endif %}
    {% if section.settings.custom_product_price_font %}
      .vso-shoppable-video__product-price { font-size: {{ section.settings.product_price_size_mobile }}px; }
    {% endif %}
  }

  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    margin-top: {{ section.settings.margin_top_desktop }}px;
    margin-bottom: {{ section.settings.margin_bottom_desktop }}px;
    padding-left: {{ section.settings.padding_horizontal_desktop }}px;
    padding-right: {{ section.settings.padding_horizontal_desktop }}px;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .section-{{ section.id }}-settings {
    margin: 0 auto;
    padding-left: 0;
    padding-right: 0;
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      margin-top: {{ section.settings.margin_top_mobile }}px;
      margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
      padding-left: {{ section.settings.padding_horizontal_mobile }}px;
      padding-right: {{ section.settings.padding_horizontal_mobile }}px;
    }
  }

  .vso-shoppable-video__nav-prev,
  .vso-shoppable-video__nav-next {
    width: {{ section.settings.nav_arrow_size }}px;
    height: {{ section.settings.nav_arrow_size }}px;
    background-color: {{ section.settings.nav_arrow_bg_color }};
    border: {{ section.settings.nav_arrow_border_width }}px solid {{ section.settings.nav_arrow_border_color }};
    border-radius: 50%;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    {% if section.settings.nav_arrow_shadow_enable %}
      box-shadow: {{ section.settings.nav_arrow_shadow_color | color_modify: 'alpha', 0.24 }} 0px 3px 8px;
    {% endif %}
  }

  .vso-shoppable-video__nav-prev svg,
  .vso-shoppable-video__nav-next svg {
    width: {{ section.settings.nav_arrow_size | times: 0.4 | round: 0 }}px;
    height: {{ section.settings.nav_arrow_size | times: 0.4 | round: 0 }}px;
    color: {{ section.settings.nav_arrow_icon_color }};
    transition: color 0.3s ease;
  }

  .vso-shoppable-video__nav-prev:hover,
  .vso-shoppable-video__nav-next:hover {
    border-color: {{ section.settings.nav_arrow_border_color | color_darken: 10 }};
    {% if section.settings.nav_arrow_shadow_enable %}
      box-shadow: {{ section.settings.nav_arrow_shadow_color | color_modify: 'alpha', 0.32 }} 0px 4px 12px;
    {% endif %}
  }

  .vso-shoppable-video__nav-prev:hover svg,
  .vso-shoppable-video__nav-next:hover svg {
    color: {{ section.settings.nav_arrow_icon_color | color_darken: 20 }};
  }

  .vso-shoppable-video__nav-prev.swiper-button-disabled,
  .vso-shoppable-video__nav-next.swiper-button-disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  @media screen and (max-width: 749px) {
    .vso-shoppable-video__navigation-mobile {
      display: flex !important;
      width: 100%;
      justify-content: center;
      align-items: center;
      margin-left: 0;
      margin-right: 0;
    }
  }

  .vso-shoppable-video__nav-prev-mobile,
  .vso-shoppable-video__nav-next-mobile {
    width: {{ section.settings.nav_arrow_size }}px;
    height: {{ section.settings.nav_arrow_size }}px;
    background-color: {{ section.settings.nav_arrow_bg_color }};
    border: {{ section.settings.nav_arrow_border_width }}px solid {{ section.settings.nav_arrow_border_color }};
    border-radius: 50%;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    {% if section.settings.nav_arrow_shadow_enable %}
      box-shadow: {{ section.settings.nav_arrow_shadow_color | color_modify: 'alpha', 0.24 }} 0px 3px 8px;
    {% endif %}
  }

  .vso-shoppable-video__nav-prev-mobile svg,
  .vso-shoppable-video__nav-next-mobile svg {
    width: {{ section.settings.nav_arrow_size | times: 0.4 | round: 0 }}px;
    height: {{ section.settings.nav_arrow_size | times: 0.4 | round: 0 }}px;
    color: {{ section.settings.nav_arrow_icon_color }};
    transition: color 0.3s ease;
  }

  .vso-shoppable-video__nav-prev-mobile:hover,
  .vso-shoppable-video__nav-next-mobile:hover {
    border-color: {{ section.settings.nav_arrow_border_color | color_darken: 10 }};
    {% if section.settings.nav_arrow_shadow_enable %}
      box-shadow: {{ section.settings.nav_arrow_shadow_color | color_modify: 'alpha', 0.32 }} 0px 4px 12px;
    {% endif %}
  }

  .vso-shoppable-video__nav-prev-mobile:hover svg,
  .vso-shoppable-video__nav-next-mobile:hover svg {
    color: {{ section.settings.nav_arrow_icon_color | color_darken: 20 }};
  }

  .vso-shoppable-video__nav-prev-mobile.swiper-button-disabled,
  .vso-shoppable-video__nav-next-mobile.swiper-button-disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
{%- endstyle -%}

<style>
#shopify-section-{{ section.id }} {
  {% if section.settings.section_bg_type == 'solid' %}
    background: {{ section.settings.section_bg_color }};
  {% else %}
    background: {{ section.settings.section_bg_gradient }};
  {% endif %}
  width: 100%;
  max-width: 100%;
  position: relative;
  padding-left: 0;
  padding-right: 0;
  overflow-x: hidden;
}

@media screen and (max-width: 749px) {
  #shopify-section-{{ section.id }} {
    overflow-x: hidden;
  }
}

#shopify-section-{{ section.id }}::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 0;
  width: 100vw;
  height: 100%;
  transform: translateX(-50%);
  {% if section.settings.section_bg_type == 'solid' %}
    background: {{ section.settings.section_bg_color }};
  {% else %}
    background: {{ section.settings.section_bg_gradient }};
  {% endif %}
  z-index: -1;
}
</style>

{% unless full_width %}
<style>
  #shopify-section-{{ section.id }}.section--page-width {
    max-width: var(--page-width, 120rem);
    margin-left: auto;
    margin-right: auto;
    overflow-x: hidden;
    box-sizing: border-box;
  }
  .section-{{ section.id }}-settings {
    max-width: min({{ content_width }}rem, 100%);
    box-sizing: border-box;
  }
</style>
{% endunless %}

{%- if request.design_mode -%}
  <div class="vso-require-script">
    <div class="vso-warning">
      <div class="vso-warning__left">
        <div class="vso-warning__badge">
          <svg width="14" height="14" viewBox="0 0 20 20" fill="none">

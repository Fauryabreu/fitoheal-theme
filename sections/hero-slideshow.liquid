{% comment %}
  FITOHEAL — Hero Slideshow (solo video)
  - Video desktop + video mobile independientes por slide
  - Lazy load: solo slide activo + siguiente cargan
  - Poster image por dispositivo para LCP rápido
  - Alturas independientes desktop/mobile
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign speed = section.settings.autoplay_speed | times: 1000
-%}

<style>
  #fh-slideshow-{{ sid }} {
    position: relative;
    width: 100%;
    height: {{ section.settings.height_desktop }};
    overflow: hidden;
    background: var(--color-brand-primary);
  }
  #fh-slideshow-{{ sid }} .fh-slideshow__track {
    position: relative;
    width: 100%;
    height: 100%;
  }
  #fh-slideshow-{{ sid }} .fh-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 700ms ease, visibility 700ms;
    z-index: 1;
  }
  #fh-slideshow-{{ sid }} .fh-slide.is-active {
    opacity: 1;
    visibility: visible;
    z-index: 2;
  }
  {%- if section.settings.transition == 'slide' -%}
  #fh-slideshow-{{ sid }} .fh-slide {
    transform: translateX(40px);
    transition: opacity 600ms ease, transform 600ms ease, visibility 600ms;
  }
  #fh-slideshow-{{ sid }} .fh-slide.is-active { transform: translateX(0); }
  {%- endif -%}

  #fh-slideshow-{{ sid }} .fh-slide__media,
  #fh-slideshow-{{ sid }} .fh-slide__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #fh-slideshow-{{ sid }} .fh-slide__video--mobile { display: none; }

  #fh-slideshow-{{ sid }} .fh-slide__overlay {
    position: absolute;
    inset: 0;
    background: #000;
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 3;
  }

  #fh-slideshow-{{ sid }} .fh-slide__content {
    position: relative;
    z-index: 4;
    height: 100%;
    display: flex;
    flex-direction: column;
    max-width: var(--page-width, 1200px);
    margin-inline: auto;
    padding: clamp(2rem, 5vw, 4rem) clamp(1.25rem, 4vw, 3rem);
  }
  #fh-slideshow-{{ sid }} .fh-slide__inner { max-width: 560px; }

  /* Posiciones */
  #fh-slideshow-{{ sid }} .fh-slide__content[data-h="left"]   { align-items: flex-start; text-align: left; }
  #fh-slideshow-{{ sid }} .fh-slide__content[data-h="center"] { align-items: center; text-align: center; }
  #fh-slideshow-{{ sid }} .fh-slide__content[data-h="right"]  { align-items: flex-end; text-align: right; }
  #fh-slideshow-{{ sid }} .fh-slide__content[data-v="top"]    { justify-content: flex-start; }
  #fh-slideshow-{{ sid }} .fh-slide__content[data-v="center"] { justify-content: center; }
  #fh-slideshow-{{ sid }} .fh-slide__content[data-v="bottom"] { justify-content: flex-end; }

  #fh-slideshow-{{ sid }} .fh-slide__eyebrow {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.85);
    margin-bottom: 0.75rem;
  }
  #fh-slideshow-{{ sid }} .fh-slide__title {
    font-family: var(--font-display);
    font-size: {{ section.settings.title_size_desktop }}px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 500;
    color: #fff;
    margin-bottom: 1rem;
  }
  #fh-slideshow-{{ sid }} .fh-slide__subtitle {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: rgba(255,255,255,0.9);
    margin-bottom: 1.75rem;
  }
  #fh-slideshow-{{ sid }} .fh-slide__ctas {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  #fh-slideshow-{{ sid }} .fh-slide__content[data-h="center"] .fh-slide__ctas { justify-content: center; }
  #fh-slideshow-{{ sid }} .fh-slide__content[data-h="right"]  .fh-slide__ctas { justify-content: flex-end; }

  /* Flechas */
  #fh-slideshow-{{ sid }} .fh-slideshow__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(255,255,255,0.14);
    backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    transition: background 200ms;
  }
  #fh-slideshow-{{ sid }} .fh-slideshow__arrow:hover { background: rgba(255,255,255,0.3); }
  #fh-slideshow-{{ sid }} .fh-slideshow__arrow--prev { left: 1.25rem; }
  #fh-slideshow-{{ sid }} .fh-slideshow__arrow--next { right: 1.25rem; }

  /* Dots */
  #fh-slideshow-{{ sid }} .fh-slideshow__dots {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 5;
    display: flex;
    gap: 0.5rem;
  }
  #fh-slideshow-{{ sid }} .fh-slideshow__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255,255,255,0.4);
    transition: background 200ms, width 250ms;
  }
  #fh-slideshow-{{ sid }} .fh-slideshow__dot.is-active {
    background: #fff;
    width: 26px;
    border-radius: 100px;
  }

  @media (max-width: 767px) {
    #fh-slideshow-{{ sid }} { height: {{ section.settings.height_mobile }}; }
    #fh-slideshow-{{ sid }} .fh-slide__video--desktop { display: none; }
    #fh-slideshow-{{ sid }} .fh-slide__video--mobile { display: block; }
    #fh-slideshow-{{ sid }} .fh-slide:not(.fh-slide--has-mobile) .fh-slide__video--desktop { display: block; }
    #fh-slideshow-{{ sid }} .fh-slide__content {
      align-items: center !important;
      justify-content: flex-end !important;
      text-align: center !important;
      padding-bottom: {% if section.settings.show_dots %}4.5rem{% else %}2.5rem{% endif %};
    }
    #fh-slideshow-{{ sid }} .fh-slide__title { font-size: {{ section.settings.title_size_mobile }}px; }
    #fh-slideshow-{{ sid }} .fh-slide__ctas {
      flex-direction: column;
      width: 100%;
      justify-content: center !important;
    }
    #fh-slideshow-{{ sid }} .fh-slide__ctas .fh-btn { width: 100%; }
    #fh-slideshow-{{ sid }} .fh-slideshow__arrow { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    #fh-slideshow-{{ sid }} .fh-slide { transition: opacity 300ms; transform: none !important; }
  }
</style>

<section id="fh-slideshow-{{ sid }}"
  class="fh-slideshow"
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ speed }}">

  <div class="fh-slideshow__track">
    {%- for block in section.blocks -%}
      {%- liquid
        assign is_first = forloop.first
        assign has_mobile = false
        if block.settings.video_mobile != blank
          assign has_mobile = true
        endif
      -%}
      <div class="fh-slide{% if is_first %} is-active{% endif %}{% if has_mobile %} fh-slide--has-mobile{% endif %}"
        data-index="{{ forloop.index0 }}"
        {{ block.shopify_attributes }}>

        {%- comment -%} VIDEO DESKTOP {%- endcomment -%}
        {%- if block.settings.video_desktop != blank -%}
          <video class="fh-slide__video fh-slide__video--desktop"
            muted loop playsinline preload="none"
            {% if block.settings.poster_desktop %}poster="{{ block.settings.poster_desktop | image_url: width: 1920 }}"{% endif %}>
            {%- for source in block.settings.video_desktop.sources -%}
              <source {% if is_first %}src{% else %}data-src{% endif %}="{{ source.url }}" type="{{ source.mime_type }}">
            {%- endfor -%}
          </video>
        {%- endif -%}

        {%- comment -%} VIDEO MOBILE (independiente) {%- endcomment -%}
        {%- if has_mobile -%}
          <video class="fh-slide__video fh-slide__video--mobile"
            muted loop playsinline preload="none"
            {% if block.settings.poster_mobile %}poster="{{ block.settings.poster_mobile | image_url: width: 900 }}"{% endif %}>
            {%- for source in block.settings.video_mobile.sources -%}
              <source {% if is_first %}src{% else %}data-src{% endif %}="{{ source.url }}" type="{{ source.mime_type }}">
            {%- endfor -%}
          </video>
        {%- endif -%}

        <div class="fh-slide__overlay" aria-hidden="true"></div>

        <div class="fh-slide__content"
          data-h="{{ block.settings.text_pos_h }}"
          data-v="{{ block.settings.text_pos_v }}">
          <div class="fh-slide__inner">
            {%- if block.settings.eyebrow != blank -%}
              <p class="fh-slide__eyebrow">{{ block.settings.eyebrow }}</p>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              {%- if is_first -%}
                <h1 class="fh-slide__title">{{ block.settings.title }}</h1>
              {%- else -%}
                <h2 class="fh-slide__title">{{ block.settings.title }}</h2>
              {%- endif -%}
            {%- endif -%}
            {%- if block.settings.subtitle != blank -%}
              <p class="fh-slide__subtitle">{{ block.settings.subtitle }}</p>
            {%- endif -%}
            {%- if block.settings.btn1_text != blank or block.settings.btn2_text != blank -%}
              <div class="fh-slide__ctas">
                {%- if block.settings.btn1_text != blank -%}
                  <a href="{{ block.settings.btn1_link | default: '#' }}" class="fh-btn fh-btn--white">{{ block.settings.btn1_text }}</a>
                {%- endif -%}
                {%- if block.settings.btn2_text != blank -%}
                  <a href="{{ block.settings.btn2_link | default: '#' }}" class="fh-btn fh-btn--white-outline">{{ block.settings.btn2_text }}</a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.settings.show_arrows and section.blocks.size > 1 -%}
    <button class="fh-slideshow__arrow fh-slideshow__arrow--prev" aria-label="Slide anterior">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <button class="fh-slideshow__arrow fh-slideshow__arrow--next" aria-label="Slide siguiente">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
    </button>
  {%- endif -%}

  {%- if section.settings.show_dots and section.blocks.size > 1 -%}
    <div class="fh-slideshow__dots" role="tablist">
      {%- for block in section.blocks -%}
        <button class="fh-slideshow__dot{% if forloop.first %} is-active{% endif %}"
          data-goto="{{ forloop.index0 }}"
          aria-label="Ir al slide {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

<script>
(function () {
  var root = document.getElementById('fh-slideshow-{{ sid }}');
  if (!root) return;

  var slides = Array.prototype.slice.call(root.querySelectorAll('.fh-slide'));
  if (slides.length === 0) return;

  var dots = Array.prototype.slice.call(root.querySelectorAll('.fh-slideshow__dot'));
  var current = 0;
  var timer = null;
  var autoplay = root.dataset.autoplay === 'true';
  var speed = parseInt(root.dataset.speed, 10) || 5000;
  var isMobile = window.matchMedia('(max-width: 767px)');

  // Hidrata los <source data-src> de un slide (lazy load real)
  function hydrate(slide) {
    slide.querySelectorAll('source[data-src]').forEach(function (s) {
      s.src = s.dataset.src;
      s.removeAttribute('data-src');
      s.parentElement.load();
    });
  }

  // Devuelve el video visible según viewport
  function activeVideo(slide) {
    var mob = slide.querySelector('.fh-slide__video--mobile');
    var desk = slide.querySelector('.fh-slide__video--desktop');
    if (isMobile.matches && mob) return mob;
    return desk || mob;
  }

  function playSlide(slide) {
    hydrate(slide);
    var v = activeVideo(slide);
    if (v) {
      var p = v.play();
      if (p && p.catch) p.catch(function () {});
    }
  }

  function pauseSlide(slide) {
    slide.querySelectorAll('video').forEach(function (v) { v.pause(); });
  }

  function goTo(index) {
    if (index === current) return;
    var prev = slides[current];
    current = (index + slides.length) % slides.length;
    var next = slides[current];

    prev.classList.remove('is-active');
    next.classList.add('is-active');
    pauseSlide(prev);
    playSlide(next);

    // Pre-hidrata el siguiente en fila para transición sin corte
    hydrate(slides[(current + 1) % slides.length]);

    dots.forEach(function (d, i) {
      d.classList.toggle('is-active', i === current);
    });
  }

  function startTimer() {
    if (!autoplay || slides.length < 2) return;
    stopTimer();
    timer = setInterval(function () { goTo(current + 1); }, speed);
  }
  function stopTimer() {
    if (timer) { clearInterval(timer); timer = null; }
  }

  // Controles
  var prev = root.querySelector('.fh-slideshow__arrow--prev');
  var nxt = root.querySelector('.fh-slideshow__arrow--next');
  if (prev) prev.addEventListener('click', function () { goTo(current - 1); startTimer(); });
  if (nxt) nxt.addEventListener('click', function () { goTo(current + 1); startTimer(); });
  dots.forEach(function (d) {
    d.addEventListener('click', function () { goTo(parseInt(d.dataset.goto, 10)); startTimer(); });
  });

  // Pausa autoplay en hover (solo desktop)
  root.addEventListener('mouseenter', stopTimer);
  root.addEventListener('mouseleave', startTimer);

  // Swipe en mobile
  var touchX = null;
  root.addEventListener('touchstart', function (e) { touchX = e.touches[0].clientX; }, { passive: true });
  root.addEventListener('touchend', function (e) {
    if (touchX === null) return;
    var dx = e.changedTouches[0].clientX - touchX;
    if (Math.abs(dx) > 50) goTo(dx < 0 ? current + 1 : current - 1);
    touchX = null;
    startTimer();
  }, { passive: true });

  // Al cambiar de breakpoint, ajustar qué video reproduce
  isMobile.addEventListener('change', function () {
    pauseSlide(slides[current]);
    playSlide(slides[current]);
  });

  // Pausa todo si el hero sale de pantalla (ahorra batería/datos)
  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) { playSlide(slides[current]); startTimer(); }
        else { pauseSlide(slides[current]); stopTimer(); }
      });
    }, { threshold: 0.2 }).observe(root);
  }

  // Init: primer slide ya tiene src directo, arranca de inmediato
  playSlide(slides[0]);
  hydrate(slides[1 % slides.length]);
  startTimer();

  // Soporte theme editor de Shopify
  document.addEventListener('shopify:block:select', function (e) {
    var slide = e.target.closest ? e.target.closest('.fh-slide') : null;
    if (slide && root.contains(slide)) {
      stopTimer();
      goTo(parseInt(slide.dataset.index, 10));
    }
  });
})();
</script>

{% schema %}
{
  "name": "Hero Slideshow Video",
  "tag": "section",
  "class": "fh-slideshow-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Alturas"
    },
    {
      "type": "select",
      "id": "height_desktop",
      "label": "Altura en desktop",
      "options": [
        { "value": "55vh", "label": "Pequeña (55vh)" },
        { "value": "70vh", "label": "Mediana (70vh)" },
        { "value": "85vh", "label": "Grande (85vh)" },
        { "value": "100vh", "label": "Pantalla completa" }
      ],
      "default": "85vh"
    },
    {
      "type": "select",
      "id": "height_mobile",
      "label": "Altura en mobile",
      "options": [
        { "value": "60svh", "label": "Pequeña (60svh)" },
        { "value": "75svh", "label": "Mediana (75svh)" },
        { "value": "88svh", "label": "Grande (88svh)" },
        { "value": "100svh", "label": "Pantalla completa" }
      ],
      "default": "88svh"
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay del slider",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Velocidad del autoplay (segundos)",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 6
    },
    {
      "type": "select",
      "id": "transition",
      "label": "Transición",
      "options": [
        { "value": "fade", "label": "Fade" },
        { "value": "slide", "label": "Slide" }
      ],
      "default": "fade"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Mostrar flechas (solo desktop)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Mostrar dots",
      "default": true
    },
    {
      "type": "header",
      "content": "Estilo"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Opacidad del overlay oscuro (%)",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 30
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "label": "Tamaño del título desktop (px)",
      "min": 32,
      "max": 80,
      "step": 2,
      "default": 56
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Tamaño del título mobile (px)",
      "min": 24,
      "max": 48,
      "step": 2,
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "header",
          "content": "Video Desktop (horizontal 16:9)"
        },
        {
          "type": "video",
          "id": "video_desktop",
          "label": "Video desktop"
        },
        {
          "type": "image_picker",
          "id": "poster_desktop",
          "label": "Poster desktop (imagen mientras carga)"
        },
        {
          "type": "header",
          "content": "Video Mobile (vertical 9:16)"
        },
        {
          "type": "video",
          "id": "video_mobile",
          "label": "Video mobile",
          "info": "Si está vacío, se usa el de desktop como respaldo."
        },
        {
          "type": "image_picker",
          "id": "poster_mobile",
          "label": "Poster mobile"
        },
        {
          "type": "header",
          "content": "Contenido"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Etiqueta pequeña (eyebrow)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título"
        },
        {
          "type": "textarea",
          "id": "subtitle",
          "label": "Subtítulo"
        },
        {
          "type": "text",
          "id": "btn1_text",
          "label": "Botón primario — texto"
        },
        {
          "type": "url",
          "id": "btn1_link",
          "label": "Botón primario — link"
        },
        {
          "type": "text",
          "id": "btn2_text",
          "label": "Botón secundario — texto"
        },
        {
          "type": "url",
          "id": "btn2_link",
          "label": "Botón secundario — link"
        },
        {
          "type": "header",
          "content": "Posición del texto (desktop)"
        },
        {
          "type": "select",
          "id": "text_pos_h",
          "label": "Posición horizontal",
          "options": [
            { "value": "left", "label": "Izquierda" },
            { "value": "center", "label": "Centro" },
            { "value": "right", "label": "Derecha" }
          ],
          "default": "left"
        },
        {
          "type": "select",
          "id": "text_pos_v",
          "label": "Posición vertical",
          "options": [
            { "value": "top", "label": "Arriba" },
            { "value": "center", "label": "Centro" },
            { "value": "bottom", "label": "Abajo" }
          ],
          "default": "center"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Slideshow Video",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}

<div class="vso-hero-39__container vso-node vd-l vso-hidden">
    <div class="vso-hero-39__content">

      <div class="vso-hero-39__header">
        <div class="vso-hero-39__heading-wrapper">
          {%- for block in section.blocks -%}
            {%- if block.type == 'heading' -%}
              <div class="vso-hero-39__heading-block" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
                {% if block.settings.subheading != blank %}
                  {%- if block.settings.subheading_custom_font -%}
                    <div class="vso-hero-39__subheading">{{ block.settings.subheading }}</div>
                  {%- else -%}
                    {%- assign subheading_tag = block.settings.subheading_as | default: 'p' -%}
                    <{{ subheading_tag }} class="vso-hero-39__subheading">{{ block.settings.subheading }}</{{ subheading_tag }}>
                  {%- endif -%}
                {% endif %}

                {% if block.settings.heading != blank %}
                  {%- if block.settings.heading_custom_font -%}
                    <div class="vso-hero-39__heading">{{ block.settings.heading }}</div>
                  {%- else -%}
                    {%- assign heading_tag = block.settings.heading_as | default: 'h2' -%}
                    <{{ heading_tag }} class="vso-hero-39__heading">{{ block.settings.heading }}</{{ heading_tag }}>
                  {%- endif -%}
                {% endif %}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="vso-hero-39__tabs-wrapper">
          {%- assign tab_blocks = section.blocks | where: 'type', 'tab' -%}
          {%- for block in tab_blocks -%}
            <button
              type="button"
              class="vso-hero-39__tab-button{% if forloop.first %} active{% endif %}"
              data-tab-id="{{ block.id }}"
              data-block-id="{{ block.id }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.tab_name }}
            </button>
          {%- endfor -%}
        </div>
      </div>

      <div class="vso-hero-39__video-container">
        {%- for block in tab_blocks -%}
          {%- if block.settings.video != blank -%}
            {%- liquid
              assign video_url = block.settings.video
              if block.settings.video.sources
                assign video_url = block.settings.video.sources[0].url
              endif
            -%}
            <video
              class="vso-hero-39__video{% if forloop.first %} active{% endif %}"
              data-video-id="{{ block.id }}"
              autoplay
              loop
              muted
              playsinline
              {% if block.settings.poster != blank %}poster="{{ block.settings.poster | image_url: width: 2400 }}"{% endif %}
              {{ block.shopify_attributes }}
            >
              <source src="{{ video_url }}" type="video/mp4">
              Your browser does not support the video tag.
            </video>
          {%- endif -%}
        {%- endfor -%}
      </div>

    </div>
</div>

<script>
(function() {
  const sectionId = 'shopify-section-{{ section.id }}';
  const section = document.getElementById(sectionId);

  if (!section) return;

  const tabButtons = section.querySelectorAll('.vso-hero-39__tab-button');
  const videos = section.querySelectorAll('.vso-hero-39__video');

  tabButtons.forEach(button => {
    button.addEventListener('click', function() {
      const tabId = this.getAttribute('data-tab-id');

      tabButtons.forEach(btn => btn.classList.remove('active'));

      this.classList.add('active');

      videos.forEach(video => {
        video.classList.remove('active');
        video.pause();
      });

      const activeVideo = section.querySelector(`.vso-hero-39__video[data-video-id="${tabId}"]`);
      if (activeVideo) {
        activeVideo.classList.add('active');
        activeVideo.play().catch(err => console.log('Video play prevented:', err));
      }
    });
  });

  const firstVideo = section.querySelector('.vso-hero-39__video.active');
  if (firstVideo) {
    firstVideo.play().catch(err => console.log('Video play prevented:', err));
  }
})();
</script>

{% schema %}
{
  "name": "VSO - Hero 39",
  "tag": "section",
  "class": "section vso-node vso-node--v2 vso-hero-39",
  "settings": [
    { "type": "header", "content": "Section Settings" },
    {
      "type": "checkbox",
      "id": "enable_advanced_settings",
      "label": "Enable advanced settings",
      "default": false,
      "info": "Shows additional settings for spacing, layout, and typography."
    },
    {
      "type": "range",
      "id": "section_max_width",
      "label": "Content max width",
      "min": 60,
      "max": 200,
      "step": 2,
      "unit": "rem",
      "default": 120,
      "visible_if": "{{ section.settings.enable_advanced_settings == true }}"
    },
    {
      "type": "range",
      "id": "section_horizontal_padding",
      "label": "Desktop side spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40,
      "info": "Adds spacing on the left and right sides of this section on desktop.",
      "visible_if": "{{ section.settings.enable_advanced_settings == true }}"
    },
    {
      "type": "range",
      "id": "section_horizontal_padding_mobile",
      "label": "Mobile side spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 20,
      "info": "Adds spacing on the left and right sides of this section on mobile.",
      "visible_if": "{{ section.settings.enable_advanced_settings == true }}"
    },

    { "type": "header", "content": "Section Background" },
    {
      "type": "select",
      "id": "section_bg_type",
      "label": "Section background type",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "gradient", "label": "Gradient" }
      ],
      "default": "solid",
      "info": "Background type for the section"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section background color",

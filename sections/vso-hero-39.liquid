{%- endcomment -%}

{%- style -%}
  .vd-l { display: none !important; }
  #shopify-section-{{ section.id }} {
    --section-border-radius: {{ section.settings.section_border_radius_mobile }}px;
    --section-horizontal-padding: var(--page-margin, 16px);
    background: transparent;
    margin-top: {{ section.settings.margin_top_mobile }}px;
    margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
    border-radius: var(--section-border-radius);
    overflow: hidden;
    padding: 0;
  }

  {% if section.settings.enable_advanced_settings %}
    #shopify-section-{{ section.id }} {
      --section-horizontal-padding: {{ section.settings.section_horizontal_padding_mobile }}px;
      padding-top: {{ section.settings.section_outer_padding_top_mobile }}px;
      padding-bottom: {{ section.settings.section_outer_padding_bottom_mobile }}px;
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      {% if section.settings.section_bg_type == 'gradient' %}
        background: {{ section.settings.section_bg_gradient }};
      {% else %}
        background-color: {{ section.settings.section_bg_color }};
      {% endif %}
    }
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      {% if section.settings.full_width_desktop %}
        --section-border-radius: 0px;
      {% else %}
        --section-border-radius: {{ section.settings.section_border_radius }}px;
      {% endif %}
      --section-horizontal-padding: 0px;
      margin-top: {{ section.settings.margin_top }}px;
      margin-bottom: {{ section.settings.margin_bottom }}px;
      {% if section.settings.full_width_desktop %}
        {% if section.settings.section_bg_type == 'gradient' %}
          background: {{ section.settings.section_bg_gradient }};
        {% else %}
          background-color: {{ section.settings.section_bg_color }};
        {% endif %}
      {% else %}
        background: transparent;
      {% endif %}
    }
  }

  {% if section.settings.enable_advanced_settings == false and section.settings.full_width_desktop == false %}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} {
        --section-horizontal-padding: 40px;
      }
    }
  {% endif %}

  {% if section.settings.enable_advanced_settings == false and section.settings.full_width_desktop %}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} {
        --section-container-max-width: var(--page-content-width, var(--page-width, 1440px));
        --section-outer-gutter: max(0px, calc((100vw - var(--section-container-max-width)) / 2));
        --section-horizontal-padding: max(0px, calc(var(--page-margin, 40px) - var(--section-outer-gutter)));
      }
    }
  {% endif %}

  {% if section.settings.enable_advanced_settings %}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} {
        --section-horizontal-padding: {{ section.settings.section_horizontal_padding }}px;
        padding-top: {{ section.settings.section_outer_padding_top }}px;
        padding-bottom: {{ section.settings.section_outer_padding_bottom }}px;
      }
    }
  {% endif %}

  #shopify-section-{{ section.id }} > .vso-hero-39__container {
    margin-left: auto;
    margin-right: auto;
    width: 100%;
    max-width: var(--page-content-width, var(--page-width, 1440px));
    {% if section.settings.enable_advanced_settings %}
      max-width: {{ section.settings.section_max_width }}rem;
    {% endif %}
    border-radius: var(--section-border-radius);
    overflow: hidden;
    padding-left: var(--section-horizontal-padding);
    padding-right: var(--section-horizontal-padding);
    padding-top: {{ section.settings.section_padding_top_mobile }}px;
    padding-bottom: {{ section.settings.section_padding_bottom_mobile }}px;
    border: 0;
    {% if section.settings.enable_advanced_settings %}
      border: {{ section.settings.section_border_width_mobile }}px solid {{ section.settings.section_border_color }};
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} > .vso-hero-39__container {
      background: transparent;
    }
  }

  {% if section.settings.full_width_desktop == false %}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} > .vso-hero-39__container {
        width: calc(100% - (2 * var(--page-margin, 40px)));
      }
    }
  {% endif %}

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} > .vso-hero-39__container {
      {% if section.settings.full_width_desktop %}
        background: transparent;
      {% else %}
        {% if section.settings.section_bg_type == 'gradient' %}
          background: {{ section.settings.section_bg_gradient }};
        {% else %}
          background-color: {{ section.settings.section_bg_color }};
        {% endif %}
      {% endif %}
      padding-top: {{ section.settings.section_padding_top }}px;
      padding-bottom: {{ section.settings.section_padding_bottom }}px;
      border: 0;
      {% if section.settings.enable_advanced_settings %}
        border: {{ section.settings.section_border_width }}px solid {{ section.settings.section_border_color }};
      {% endif %}
    }
  }

  #shopify-section-{{ section.id }} .vso-hero-39__content {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.content_gap_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .vso-hero-39__content {
      gap: {{ section.settings.content_gap }}px;
    }
  }

  #shopify-section-{{ section.id }} .vso-hero-39__header {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.header_gap_mobile }}px;
    align-items: flex-start;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .vso-hero-39__header {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: {{ section.settings.header_gap }}px;
    }
  }

  #shopify-section-{{ section.id }} .vso-hero-39__heading-wrapper {
    flex: 1;
  }

  #shopify-section-{{ section.id }} .vso-hero-39__tabs-wrapper {
    display: flex;
    gap: {{ section.settings.tabs_gap }}px;
    flex-wrap: wrap;
    justify-content: {{ section.settings.tabs_alignment_mobile }};
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .vso-hero-39__tabs-wrapper {
      justify-content: flex-end;
    }
  }

  #shopify-section-{{ section.id }} .vso-hero-39__tab-button {
    padding: {{ section.settings.tab_padding_vertical_mobile }}px {{ section.settings.tab_padding_horizontal_mobile }}px;
    background-color: {{ section.settings.tab_bg_color }};
    color: {{ section.settings.tab_text_color }} !important;
    border: {{ section.settings.tab_border_width }}px solid {{ section.settings.tab_border_color }};
    border-radius: {{ section.settings.tab_border_radius }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-align: center;
    white-space: nowrap;
    font-size: {{ section.settings.tab_font_size_mobile }}px;
    {% if section.settings.tab_custom_font %}
      line-height: {{ section.settings.tab_line_height }}%;
      font-family: {{ section.settings.tab_font.family }}, {{ section.settings.tab_font.fallback_families }};
      font-style: {{ section.settings.tab_font.style }};
    {% else %}
      line-height: 1;
    {% endif %}
    {% if section.settings.enable_advanced_settings %}
      font-weight: {{ section.settings.tab_font_weight }};
    {% endif %}
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .vso-hero-39__tab-button {
      padding: {{ section.settings.tab_padding_vertical }}px {{ section.settings.tab_padding_horizontal }}px;
      font-size: {{ section.settings.tab_font_size }}px;
    }
  }

  #shopify-section-{{ section.id }} .vso-hero-39__tab-button.active {
    background-color: {{ section.settings.tab_bg_color_active }};
    color: {{ section.settings.tab_text_color_active }} !important;
    border-color: {{ section.settings.tab_border_color_active }};
  }

  #shopify-section-{{ section.id }} .vso-hero-39__video-container {
    position: relative;
    width: 100%;
    height: {{ section.settings.video_height_mobile }}px;
    border-radius: {{ section.settings.video_border_radius_mobile }}px;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0.05);
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .vso-hero-39__video-container {
      height: {{ section.settings.video_height }}px;
      border-radius: {{ section.settings.video_border_radius }}px;
    }
  }

  #shopify-section-{{ section.id }} .vso-hero-39__video {
    display: none;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .vso-hero-39__video.active {
    display: block;
  }

  {% for block in section.blocks %}
    {% if block.type == 'heading' %}
      [data-block-id="{{ block.id }}"].vso-hero-39__heading-block {
        text-align: {{ block.settings.heading_alignment_mobile }};
        margin-top: {{ block.settings.margin_top_mobile }}px;
        margin-bottom: {{ block.settings.margin_bottom_mobile }}px;
      }
      @media screen and (min-width: 750px) {
        [data-block-id="{{ block.id }}"].vso-hero-39__heading-block {
          text-align: {{ block.settings.heading_alignment }};
          margin-top: {{ block.settings.margin_top }}px;
          margin-bottom: {{ block.settings.margin_bottom }}px;
          max-width: {{ block.settings.heading_max_width }}px;
        }
      }

      [data-block-id="{{ block.id }}"] .vso-hero-39__subheading {
        color: {{ block.settings.subheading_color }};
        margin: 0 0 {{ block.settings.subheading_spacing }}px 0;
        {% if block.settings.subheading_custom_font %}
          font-size: {{ block.settings.subheading_font_size_mobile }}px;
          line-height: {{ block.settings.subheading_line_height }}%;
          font-family: {{ block.settings.subheading_font.family }}, {{ block.settings.subheading_font.fallback_families }};
          font-style: {{ block.settings.subheading_font.style }};
          {% if section.settings.enable_advanced_settings %}
            font-weight: {{ block.settings.subheading_font_weight }};
          {% endif %}
        {% endif %}
      }
      {% if block.settings.subheading_custom_font %}
        @media screen and (min-width: 750px) {
          [data-block-id="{{ block.id }}"] .vso-hero-39__subheading {
            font-size: {{ block.settings.subheading_font_size }}px;
          }
        }
      {% endif %}

      [data-block-id="{{ block.id }}"] .vso-hero-39__heading {
        {% if block.settings.heading_color_type == 'gradient' %}
          background: {{ block.settings.heading_gradient }};
          -webkit-background-clip: text;
          -webkit-text-fill-color: transparent;
          background-clip: text;
        {% else %}
          color: {{ block.settings.heading_color }};
        {% endif %}
        margin: 0;
        {% if block.settings.heading_custom_font %}
          font-size: {{ block.settings.heading_font_size_mobile }}px;
          line-height: {{ block.settings.heading_line_height }}%;
          font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
          font-style: {{ block.settings.heading_font.style }};
          {% if section.settings.enable_advanced_settings %}
            font-weight: {{ block.settings.heading_font_weight }};
          {% endif %}
        {% endif %}
      }
      {% if block.settings.heading_custom_font %}
        @media screen and (min-width: 750px) {
          [data-block-id="{{ block.id }}"] .vso-hero-39__heading {
            font-size: {{ block.settings.heading_font_size }}px;
          }
        }
      {% endif %}
    {% endif %}
  {% endfor %}

  .vso-node { display: none; }
  .vso-node--v2 { display: block; }
{%- endstyle -%}


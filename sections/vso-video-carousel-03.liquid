alteration, or distribution of this file is strictly forbidden and will be prosecuted to the maximum extent permitted by law.
All modifications are logged.

If you require assistance or have questions regarding this code, please contact support@versio.studio.
{% endcomment %}

{%- liquid
  assign text_alignment = 'left'
  assign blocks_alignment_desktop = 'left'
  assign blocks_alignment_mobile = 'left'
  assign header_blocks_gap = 0
  assign content_width = section.settings.content_width
  assign description_alignment_desktop = section.settings.description_alignment_desktop | default: section.settings.header_alignment_desktop | default: 'center'
  assign description_alignment_mobile = section.settings.description_alignment_mobile | default: section.settings.header_alignment_mobile | default: 'center'
  assign section_bg_value = section.settings.section_bg_color
  if section.settings.section_bg_type == 'gradient'
    assign section_bg_value = section.settings.section_bg_gradient
  endif

-%}

{%- style -%}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {{ section.settings.description_font | font_face: font_display: 'swap' }}

  {% if section.settings.custom_heading_font %}
    #ShoppableVideoStories-{{ section.id }} .vso-shoppable-video__heading {
      font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
      font-style: {{ section.settings.heading_font.style }};
    }
  {% endif %}

  {% if section.settings.custom_description_font %}
    #ShoppableVideoStories-{{ section.id }} .vso-shoppable-video__description {
      font-family: {{ section.settings.description_font.family }}, {{ section.settings.description_font.fallback_families }};
      font-style: {{ section.settings.description_font.style }};
    }
  {% endif %}

  .vso-shoppable-video {
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .vso-shoppable-video__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: {{ header_blocks_gap }}px;
    width: 100%;
    position: relative;
  }

  .vso-shoppable-video__header-content {
    max-width: 60%;
    flex: 1;
  }

  .vso-shoppable-video__heading {
    margin: 0;
    margin-bottom: {{ section.settings.heading_bottom_spacing }}px;
    text-align: {{ text_alignment }};
  }

  {% if section.settings.custom_heading_font %}
    .vso-shoppable-video__heading {
      line-height: {{ section.settings.heading_line_height }}%;
      font-size: {{ section.settings.heading_size_desktop }}px;
      color: {{ section.settings.heading_color }};
      font-weight: {{ section.settings.heading_font_weight }};
    }
  {% endif %}

  .vso-shoppable-video__description {
    margin: 0;
    text-align: {{ text_alignment }};
    margin-bottom: {{ section.settings.description_bottom_spacing }}px;
  }

  {% if section.settings.custom_description_font %}
    .vso-shoppable-video__description {
      font-size: {{ section.settings.description_size_desktop }}px;
      color: {{ section.settings.description_color }};
      line-height: {{ section.settings.description_line_height }}%;
    }
  {% endif %}

  @media screen and (min-width: 750px) {
    {% if section.settings.header_alignment_desktop == 'center' %}
      .vso-shoppable-video__header {
        flex-direction: column;
        align-items: center;
        text-align: center;
      }
      .vso-shoppable-video__header-content {
        max-width: 100%;
        text-align: center;
        margin-bottom: 20px;
      }
      .vso-shoppable-video__heading,
      .vso-shoppable-video__description {
        text-align: center;
      }
    {% endif %}

    .vso-shoppable-video__description {
      text-align: {{ description_alignment_desktop }};
    }
  }

  @media screen and (max-width: 749px) {
    .vso-shoppable-video__header {
      flex-direction: column;
      align-items: {% if section.settings.header_alignment_mobile == 'center' %}center{% else %}flex-start{% endif %};
      text-align: {% if section.settings.header_alignment_mobile == 'center' %}center{% else %}left{% endif %};
    }

    .vso-shoppable-video__header-content {
      max-width: 100%;
      text-align: {% if section.settings.header_alignment_mobile == 'center' %}center{% else %}left{% endif %};
      margin-bottom: 20px;
    }

    .vso-shoppable-video__heading {
      text-align: {% if section.settings.header_alignment_mobile == 'center' %}center{% else %}left{% endif %};
    }

    .vso-shoppable-video__description {
      text-align: {{ description_alignment_mobile }};
    }

    .vso-shoppable-video__navigation {
      display: none;
    }
  }

  .vso-shoppable-video__swiper {
    width: 100%;
    padding:0px !important;
    overflow: hidden;
    position: relative;
  }

  @media screen and (min-width: 750px) {
    .vso-shoppable-video__swiper {
      overflow: hidden;
    }

    .vso-shoppable-video__swiper .swiper-slide {
      opacity: 0.5;
      transition: opacity 0.3s ease, transform 0.3s ease;
      transform: scale(0.9);
    }

    .vso-shoppable-video__swiper .swiper-slide-active {
      opacity: 1;
      transform: scale(1);
    }

    .vso-shoppable-video__swiper .swiper-slide-prev,
    .vso-shoppable-video__swiper .swiper-slide-next {
      transform: scale(0.95);
      opacity: 1;
    }
  }

  .vso-shoppable-video__nav-overlay {
    position: absolute;
    display: none; 
    align-items: center;
    justify-content: center;
    z-index: 20;
    transform: translate(-50%, -50%);
    pointer-events: auto;
  }
  @media screen and (min-width: 750px) {
    .vso-shoppable-video__navigation { display: none !important; }
    .vso-shoppable-video__nav-overlay { display: flex; }
  }
  @media screen and (max-width: 749px) {
    .vso-shoppable-video__nav-overlay { display: none !important; }
  }

  .vso-shoppable-video__slide {
  }

  @media screen and (max-width: 749px) {
    .vso-shoppable-video__slide {
      width: auto;
    }
  }

  .vso-shoppable-video__block {
    display: flex;
    flex-direction: column;
    align-items: {{ blocks_alignment_desktop }};
    padding: 0;
    background-color: transparent;
    border: none;
    text-align: {{ blocks_alignment_desktop }};
    transition: transform 0.3s ease;
    overflow: visible;
  }

  .vso-shoppable-video__video-container {
    position: relative;
    width: 100%;
    margin: 0 0 {{ section.settings.video_to_content_gap }}px 0;
    border-radius: {{ section.settings.video_border_radius | default: 32 }}px;
    overflow: hidden;
    background-color: transparent;
    aspect-ratio: 3 / 4;
    transition: aspect-ratio 0.4s ease, border-radius 0.4s ease, box-shadow 0.4s ease;
  }

  .vso-shoppable-video__video-container::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 35%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0.3) 30%, transparent 100%);
    pointer-events: none;
    z-index: 5;
  }

  .vso-shoppable-video__play-button {
    position: absolute;
    bottom: 20px;
    right: 20px;
    width: {{ section.settings.video_button_size }}px;
    height: {{ section.settings.video_button_size }}px;
    border-radius: {{ section.settings.video_button_border_radius }}px;
    background: {{ section.settings.video_button_bg_color | color_modify: 'alpha', 0.25 }};
    backdrop-filter: blur(10px);
    border: {{ section.settings.video_button_border_width }}px solid {{ section.settings.video_button_border_color | color_modify: 'alpha', 0.3 }};
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    z-index: 10;
  }

  .vso-shoppable-video__play-button:hover {
    transform: scale(1.05);
  }

  .vso-shoppable-video__play-icon,
  .vso-shoppable-video__pause-icon {
    width: {{ section.settings.video_button_size | times: 0.45 | round: 0 }}px;
    height: {{ section.settings.video_button_size | times: 0.45 | round: 0 }}px;
    color: {{ section.settings.video_button_icon_color }};
  }

  .vso-shoppable-video__mute-button {
    position: absolute;
    top: 20px;
    right: 20px;
    width: {{ section.settings.video_button_size }}px;
    height: {{ section.settings.video_button_size }}px;
    border-radius: {{ section.settings.video_button_border_radius }}px;
    background: {{ section.settings.video_button_bg_color | color_modify: 'alpha', 0.25 }};
    backdrop-filter: blur(10px);
    border: {{ section.settings.video_button_border_width }}px solid {{ section.settings.video_button_border_color | color_modify: 'alpha', 0.3 }};
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    z-index: 10;
  }

  .vso-shoppable-video__mute-button:hover { transform: scale(1.05); }

  .vso-shoppable-video__volume-on-icon,
  .vso-shoppable-video__volume-off-icon {
    width: {{ section.settings.video_button_size | times: 0.45 | round: 0 }}px;
    height: {{ section.settings.video_button_size | times: 0.45 | round: 0 }}px;
    color: {{ section.settings.video_button_icon_color }};
  }

  .vso-shoppable-video__video-container .vso-shoppable-video__mute-button { display: none; }
  .vso-shoppable-video__swiper .swiper-slide-active .vso-shoppable-video__mute-button { display: flex; }


  .vso-shoppable-video__video {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    display: block;
    transition: aspect-ratio 0.4s ease;
  }

  .vso-shoppable-video__video-placeholder {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    display: block;
    background-color: #f3f4f6;
    transition: aspect-ratio 0.4s ease;
  }


  @media screen and (max-width: 749px) {
    .vso-shoppable-video__swiper {
      padding: 30px 0px !important;
      overflow: visible;
      width: 100%;
    }

    .vso-shoppable-video__slide {
      width: auto;
    }

    .vso-shoppable-video__swiper .swiper-slide { transition: opacity 0.3s ease, transform 0.3s ease; transform: scale(0.94); }
    .vso-shoppable-video__swiper .swiper-slide-active { transform: scale(1); }
    .vso-shoppable-video__swiper .swiper-slide-prev,
    .vso-shoppable-video__swiper .swiper-slide-next { transform: scale(0.97); }

    .section-{{ section.id }}-settings,
    .vso-shoppable-video,
    .section-{{ section.id }} {
      overflow: visible;
    }

    {% if section.settings.custom_heading_font %}
      .vso-shoppable-video__heading {
        font-size: {{ section.settings.heading_size_mobile }}px;
      }
    {% endif %}

    {% if section.settings.custom_description_font %}
      .vso-shoppable-video__description {
        font-size: {{ section.settings.description_size_mobile }}px;
      }
    {% endif %}

    .vso-shoppable-video__block {
      align-items: {{ blocks_alignment_mobile }};
      text-align: {{ blocks_alignment_mobile }};
    }

  }

  #shopify-section-{{ section.id }} {
    --section-border-radius: 0px;
    --section-horizontal-padding: 0px;
    background: transparent;
    margin-top: {{ section.settings.margin_top_mobile }}px;
    margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
    border-radius: var(--section-border-radius);
    overflow: hidden;
    padding: 0;
  }

  {% if section.settings.enable_advanced_settings %}
    #shopify-section-{{ section.id }} {
      --section-horizontal-padding: {{ section.settings.padding_horizontal_mobile }}px;
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      background: {{ section_bg_value }};
      overflow: visible;
    }
    #shopify-section-{{ section.id }} > .section-{{ section.id }} {
      overflow: visible;
    }
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      {% if section.settings.full_width_desktop %}
        --section-border-radius: 0px;
      {% else %}
        --section-border-radius: {{ section.settings.section_border_radius }}px;
      {% endif %}
      --section-horizontal-padding: 0px;
      margin-top: {{ section.settings.margin_top_desktop }}px;
      margin-bottom: {{ section.settings.margin_bottom_desktop }}px;
      {% if section.settings.full_width_desktop %}
        background: {{ section_bg_value }};
      {% else %}
        background: transparent;
      {% endif %}
    }
  }

  {% if section.settings.enable_advanced_settings == false and section.settings.full_width_desktop == false %}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} {
        --section-horizontal-padding: 40px;
      }
    }
  {% endif %}

  {% if section.settings.enable_advanced_settings == false and section.settings.full_width_desktop %}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} {
        --section-container-max-width: var(--page-content-width, var(--page-width, 1440px));
        --section-outer-gutter: max(0px, calc((100vw - var(--section-container-max-width)) / 2));
        --section-horizontal-padding: max(0px, calc(var(--page-margin, 40px) - var(--section-outer-gutter)));
      }
    }
  {% endif %}

  {% if section.settings.enable_advanced_settings %}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} {
        --section-horizontal-padding: {{ section.settings.padding_horizontal_desktop }}px;
      }
    }
  {% endif %}

  #shopify-section-{{ section.id }} > .section-{{ section.id }} {
    margin-left: auto;
    margin-right: auto;
    width: 100%;
    max-width: var(--page-content-width, var(--page-width, 1440px));
    box-sizing: border-box;
    border-radius: var(--section-border-radius);
    overflow: hidden;
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    padding-left: var(--section-horizontal-padding);
    padding-right: var(--section-horizontal-padding);
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} > .section-{{ section.id }} {
      background: transparent;
      overflow: visible;
    }
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} > .section-{{ section.id }} {
      {% if section.settings.full_width_desktop %}
        background: transparent;
      {% else %}
        background: {{ section_bg_value }};
      {% endif %}
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }

  .section-{{ section.id }}-settings {
    margin: 0 auto;
    width: 100%;
    padding-left: 0;
    padding-right: 0;
    box-sizing: border-box;
    max-width: 100%;
  }

  {% if section.settings.enable_advanced_settings %}
    .section-{{ section.id }}-settings {
      max-width: min({{ content_width }}rem, 100%);
    }
  {% endif %}

  .vso-shoppable-video__nav-prev,
  .vso-shoppable-video__nav-next {
    width: {{ section.settings.nav_arrow_size }}px;
    height: {{ section.settings.nav_arrow_size }}px;
    background-color: {{ section.settings.nav_arrow_bg_color }};
    border: {{ section.settings.nav_arrow_border_width }}px solid {{ section.settings.nav_arrow_border_color }};
    border-radius: 50%;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    {% if section.settings.nav_arrow_shadow_enable %}
      box-shadow: {{ section.settings.nav_arrow_shadow_color | color_modify: 'alpha', 0.24 }} 0px 3px 8px;
    {% endif %}
  }

  .vso-shoppable-video__nav-prev svg,
  .vso-shoppable-video__nav-next svg {
    width: {{ section.settings.nav_arrow_size | times: 0.4 | round: 0 }}px;
    height: {{ section.settings.nav_arrow_size | times: 0.4 | round: 0 }}px;
    color: {{ section.settings.nav_arrow_icon_color }};
    transition: color 0.3s ease;
  }

  .vso-shoppable-video__nav-prev:hover,
  .vso-shoppable-video__nav-next:hover {
    border-color: {{ section.settings.nav_arrow_border_color | color_darken: 10 }};
    {% if section.settings.nav_arrow_shadow_enable %}
      box-shadow: {{ section.settings.nav_arrow_shadow_color | color_modify: 'alpha', 0.32 }} 0px 4px 12px;
    {% endif %}
  }

  .vso-shoppable-video__nav-prev:hover svg,
  .vso-shoppable-video__nav-next:hover svg {
    color: {{ section.settings.nav_arrow_icon_color | color_darken: 20 }};
  }

  .vso-shoppable-video__nav-prev.swiper-button-disabled,
  .vso-shoppable-video__nav-next.swiper-button-disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

{%- endstyle -%}

<style>
  #ShoppableVideoStories-{{ section.id }} {
    --vso-video-card-gap: 32px;
    --vso-video-card-width: clamp(220px, 19vw, 320px);
    --vso-carousel-max-height: calc(var(--vso-video-card-width) * 16 / 9 + 5px);
  }

  @media screen and (min-width: 1200px) {
    #ShoppableVideoStories-{{ section.id }} {
      --vso-video-card-width: calc((100% - 4 * var(--vso-video-card-gap)) / 5);
    }
  }

  #ShoppableVideoStories-{{ section.id }} .vso-shoppable-video {
    align-items: center;
    text-align: center;
    gap: 24px;
  }

  #ShoppableVideoStories-{{ section.id }} .vso-shoppable-video__header {
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
  }

  #ShoppableVideoStories-{{ section.id }} .vso-shoppable-video__header-content {
    max-width: 720px;
    margin: 0 auto;
  }

  #ShoppableVideoStories-{{ section.id }} .vso-shoppable-video__description {
    margin-bottom: {{ section.settings.description_bottom_spacing }}px;
    text-align: {{ description_alignment_desktop }};
  }

  #ShoppableVideoStories-{{ section.id }} .vso-shoppable-video__heading {
    letter-spacing: 0.08em;
  }

  #ShoppableVideoStories-{{ section.id }} .vso-shoppable-video__navigation {
    display: none !important;
  }

  #ShoppableVideoStories-{{ section.id }} .vso-shoppable-video__carousel-wrap {
    position: relative;
    width: 100%;
    min-width: 0;
  }

  #ShoppableVideoStories-{{ section.id }} .vso-shoppable-video__swiper {
    width: 100%;
    padding: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    max-width: 100%;
    margin-left: auto;
    margin-right: auto;
    min-height: var(--vso-carousel-max-height);
  }

  #ShoppableVideoStories-{{ section.id }} .vso-shoppable-video__swiper .swiper-wrapper {
    align-items: center;
  }

  #ShoppableVideoStories-{{ section.id }} .vso-shoppable-video__slide {
    min-height: var(--vso-carousel-max-height);
    display: flex;
    justify-content: center;
    align-items: center;
  }

  #ShoppableVideoStories-{{ section.id }} .vso-shoppable-video__swiper .swiper-slide {
    opacity: 1;
    transform: none;
    width: auto;
  }

  @media screen and (min-width: 750px) {
    #ShoppableVideoStories-{{ section.id }} .vso-shoppable-video__swiper,
    #ShoppableVideoStories-{{ section.id }} .vso-shoppable-video__slide {
      height: var(--vso-carousel-max-height);
    }
  }

  #ShoppableVideoStories-{{ section.id }} .vso-shoppable-video__swiper .swiper-slide-active,
  #ShoppableVideoStories-{{ section.id }} .vso-shoppable-video__swiper .swiper-slide-prev,
  #ShoppableVideoStories-{{ section.id }} .vso-shoppable-video__swiper .swiper-slide-next {
    opacity: 1;
    transform: none;
  }

  #ShoppableVideoStories-{{ section.id }} .vso-shoppable-video__block {
    background: transparent;
    padding: 0;
    border-radius: 32px;
    box-shadow: none;
    gap: 20px;
  }

  #ShoppableVideoStories-{{ section.id }} .vso-shoppable-video__video-container {
    margin-bottom: 0;
    border-radius: {{ section.settings.video_border_radius | default: 32 }}px;
    overflow: hidden;
    box-shadow: none;
  }

  #ShoppableVideoStories-{{ section.id }} .vso-shoppable-video__video-container::after {
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.7) 100%);
    height: 45%;
  }

  #ShoppableVideoStories-{{ section.id }} .swiper-slide-active .vso-shoppable-video__video-container,
  #ShoppableVideoStories-{{ section.id }} .swiper-slide-active .vso-shoppable-video__video,
  #ShoppableVideoStories-{{ section.id }} .swiper-slide-active .vso-shoppable-video__video-placeholder {
    aspect-ratio: 9 / 16;
  }

  #ShoppableVideoStories-{{ section.id }} .swiper-slide.is-height-probe,
  #ShoppableVideoStories-{{ section.id }} .swiper-slide.is-height-probe .vso-shoppable-video__video-container,
  #ShoppableVideoStories-{{ section.id }} .swiper-slide.is-height-probe .vso-shoppable-video__video,
  #ShoppableVideoStories-{{ section.id }} .swiper-slide.is-height-probe .vso-shoppable-video__video-placeholder {
    aspect-ratio: 9 / 16 !important;
    transform: none !important;
    opacity: 1 !important;
  }

  #ShoppableVideoStories-{{ section.id }} .vso-shoppable-video__testimonial {
    max-width: {{ section.settings.testimonial_width_desktop | default: 640 }}px;
    margin: {{ section.settings.testimonial_spacing_top_desktop }}px auto 0;
    text-align: center;
    opacity: 1;
    transition: opacity 0.18s ease;
  }

  #ShoppableVideoStories-{{ section.id }} .vso-shoppable-video__testimonial.is-transitioning {
    opacity: 0;
  }

  #ShoppableVideoStories-{{ section.id }} .vso-shoppable-video__testimonial-text {
    margin: 0;
    color: #0b0b0b;
  }

  #ShoppableVideoStories-{{ section.id }} .vso-shoppable-video__testimonial-author {
    display: inline-block;
    margin-top: 8px;
  }

  {% if section.settings.custom_testimonial_text_font %}
    #ShoppableVideoStories-{{ section.id }} .vso-shoppable-video__testimonial-text {
      font-family: {{ section.settings.testimonial_text_font.family }}, {{ section.settings.testimonial_text_font.fallback_families }};
      font-style: {{ section.settings.testimonial_text_font.style }};
      font-weight: {{ section.settings.testimonial_text_font_weight }};
      font-size: {{ section.settings.testimonial_text_size_desktop }}px;
      line-height: {{ section.settings.testimonial_text_line_height }}%;
      color: {{ section.settings.testimonial_text_color }};
    }
  {% endif %}

  {% if section.settings.custom_testimonial_author_font %}
    #ShoppableVideoStories-{{ section.id }} .vso-shoppable-video__testimonial-author {
      font-family: {{ section.settings.testimonial_author_font.family }}, {{ section.settings.testimonial_author_font.fallback_families }};
      font-style: {{ section.settings.testimonial_author_font.style }};

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>

<script defer>
const initShoppableVideoStories{{ section.id | replace: '-', '' }} = () => {
  const STORE_KEY = '__vsoShoppableVideoStories';
  const store = window[STORE_KEY] = window[STORE_KEY] || {};
  if (typeof store['{{ section.id }}'] === 'function') {
    store['{{ section.id }}']();
  }
  store['{{ section.id }}'] = () => {};
  const globalListeners = [];
  const addGlobalListener = (target, event, handler, options) => {
    target.addEventListener(event, handler, options);
    globalListeners.push(() => target.removeEventListener(event, handler, options));
  };

  const sectionId = 'ShoppableVideoStories-{{ section.id }}';
  const sectionEl = document.getElementById(sectionId);
  if (!sectionEl) return;

  const swiperContainer = sectionEl.querySelector('.vso-shoppable-video__swiper');
  if (!swiperContainer) return;

  const testimonialWrapper = sectionEl.querySelector('[data-testimonial-wrapper]');
  const testimonialTextEl = sectionEl.querySelector('[data-testimonial-text]');
  const testimonialAuthorEl = sectionEl.querySelector('[data-testimonial-author]');
  const navPrev = sectionEl.querySelector('.vso-shoppable-video__nav-overlay-prev');
  const navNext = sectionEl.querySelector('.vso-shoppable-video__nav-overlay-next');
  const autoplayEnabled = {{ section.settings.video_autoplay | json }};
  let globalMuted = (localStorage.getItem('vsoShoppableVideoMuted') ?? 'true') === 'true';
  let testimonialTimeout;
  let swiperInstance;

  const blockTestimonials = [
    {% for block in section.blocks %}
      {
        text: {{ block.settings.testimonial_text | default: '' | strip | strip_newlines | json }},
        author: {{ block.settings.testimonial_author | default: '' | strip | strip_newlines | json }}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];

  const setPlayButtonState = (button, playing) => {
    if (!button) return;
    const playIcon = button.querySelector('.vso-shoppable-video__play-icon');
    const pauseIcon = button.querySelector('.vso-shoppable-video__pause-icon');
    if (playIcon) playIcon.style.display = playing ? 'none' : 'block';
    if (pauseIcon) pauseIcon.style.display = playing ? 'block' : 'none';
  };

  const setMuteButtonState = (button, muted) => {
    if (!button) return;
    const onIcon = button.querySelector('.vso-shoppable-video__volume-on-icon');
    const offIcon = button.querySelector('.vso-shoppable-video__volume-off-icon');
    if (onIcon) onIcon.style.display = muted ? 'none' : 'block';
    if (offIcon) offIcon.style.display = muted ? 'block' : 'none';
  };

  const slidesTestimonialData = (() => {
    const seen = new Set();
    const dataSource = blockTestimonials.length
      ? blockTestimonials
      : Array.from(sectionEl.querySelectorAll('[data-slide-testimonial]')).map((slide) => ({
          text: slide.getAttribute('data-slide-testimonial') || '',
          author: slide.getAttribute('data-slide-author') || ''
        }));
    return dataSource.reduce((acc, entry) => {
      const text = entry?.text || '';
      const author = entry?.author || '';
      const key = `${text}||${author}`;
      if (seen.has(key)) return acc;
      seen.add(key);
      acc.push({ text, author });
      return acc;
    }, []);
  })();

  const getActiveSlideEl = (swiperInstance) => {
    if (!swiperInstance) return null;
    const slides = swiperInstance.slides;
    if (slides && typeof swiperInstance.activeIndex === 'number') {
      const directMatch = slides[swiperInstance.activeIndex];
      if (directMatch) return directMatch;
    }
    return swiperInstance.el?.querySelector('.swiper-slide-active') || null;
  };

  const getSlideTestimonialData = (slide) => {
    if (!slide) return null;
    const indexAttr = slide.getAttribute('data-slide-block-index');
    if (indexAttr !== null) {
      const parsedIndex = Number(indexAttr);
      if (!Number.isNaN(parsedIndex) && blockTestimonials[parsedIndex]) {
        const data = blockTestimonials[parsedIndex];
        if (data && (data.text || data.author)) {
          return { text: data.text || '', author: data.author || '' };
        }
      }
    }
    const fallbackText = slide.getAttribute('data-slide-testimonial') || '';
    const fallbackAuthor = slide.getAttribute('data-slide-author') || '';
    if (fallbackText || fallbackAuthor) {
      return { text: fallbackText, author: fallbackAuthor };
    }
    return null;
  };

  let lastTestimonialData = (() => {
    const initial = {
      text: testimonialTextEl?.innerHTML || '',
      author: testimonialAuthorEl?.textContent?.trim() || ''
    };
    if (initial.text || initial.author) return initial;
    return blockTestimonials[0] ? { ...blockTestimonials[0] } : { text: '', author: '' };
  })();

  const setStableCarouselHeight = () => {
    if (!swiperContainer) return;
    const slides = Array.from(swiperContainer.querySelectorAll('.swiper-slide'));
    if (!slides.length) return;
    const swiperWrapper = swiperContainer.querySelector('.swiper-wrapper');

    sectionEl.style.removeProperty('--vso-carousel-max-height');
    swiperContainer.style.removeProperty('min-height');
    swiperContainer.style.removeProperty('height');
    if (swiperWrapper) {
      swiperWrapper.style.removeProperty('min-height');
      swiperWrapper.style.removeProperty('height');
    }
    slides.forEach((slide) => {
      slide.style.removeProperty('min-height');
      slide.style.removeProperty('height');
    });

    let maxHeight = 0;
    slides.forEach((slide) => {
      const block = slide.querySelector('.vso-shoppable-video__block');
      if (!block) return;
      const measured = Math.ceil(block.getBoundingClientRect().height);
      if (measured > maxHeight) {
        maxHeight = measured;
      }
    });

    if (!maxHeight) return;

    const maxHeightPx = `${maxHeight}px`;
    sectionEl.style.setProperty('--vso-carousel-max-height', maxHeightPx);
    swiperContainer.style.minHeight = maxHeightPx;
    swiperContainer.style.height = maxHeightPx;
    if (swiperWrapper) {
      swiperWrapper.style.minHeight = maxHeightPx;
      swiperWrapper.style.height = maxHeightPx;
    }
    slides.forEach((slide) => {
      slide.style.minHeight = maxHeightPx;
      slide.style.height = maxHeightPx;
    });

    if (swiperInstance) {
      if (typeof swiperInstance.updateSlides === 'function') {
        swiperInstance.updateSlides();
      }
      if (typeof swiperInstance.updateSize === 'function') {
        swiperInstance.updateSize();
      }
      positionOverlayArrows(swiperInstance);
    }
  };

  const positionOverlayArrows = (swiperInstance) => {
    if (!swiperInstance || !navPrev || !navNext) return;
    const isDesktop = window.matchMedia('(min-width: 750px)').matches;
    if (!isDesktop) {
      navPrev.style.display = 'none';
      navNext.style.display = 'none';
      return;
    }

    const containerWidth = swiperInstance.width;
    const containerHeight = swiperInstance.height;
    if (!containerWidth || !containerHeight) return;

    const params = swiperInstance.params || {};
    const breakpointConfig = params.breakpoints || {};
    const viewportWidth = window.innerWidth || document.documentElement.clientWidth || 0;
    let slidesPerView = typeof params.slidesPerView === 'number' ? params.slidesPerView : 1;
    let spaceBetween = typeof params.spaceBetween === 'number' ? params.spaceBetween : 0;

    Object.keys(breakpointConfig)
      .map((bp) => Number(bp))
      .filter((bp) => !Number.isNaN(bp))
      .sort((a, b) => a - b)
      .forEach((bp) => {
        if (viewportWidth >= bp) {
          const config = breakpointConfig[bp] || {};
          if (typeof config.slidesPerView === 'number') {
            slidesPerView = config.slidesPerView;
          }
          if (typeof config.spaceBetween === 'number') {
            spaceBetween = config.spaceBetween;
          }
        }
      });

    if (slidesPerView <= 0) return;

    const slideWidth = (containerWidth - Math.max(slidesPerView - 1, 0) * spaceBetween) / slidesPerView;
    if (!slideWidth || !isFinite(slideWidth)) return;

    const inset = 10;
    const prevIndex = slidesPerView >= 2 ? 1 : 0;
    const nextIndex = slidesPerView >= 4 ? 3 : Math.max(Math.ceil(slidesPerView) - 1, 0);
    const slideStart = (index) => index * (slideWidth + spaceBetween);
    const arrowWidth = navPrev.getBoundingClientRect().width || navNext.getBoundingClientRect().width || {{ section.settings.nav_arrow_size | default: 50 }};
    const arrowOffset = arrowWidth * 0.25;
    const clampX = (value) => Math.max(-arrowWidth, Math.min(containerWidth + arrowWidth, value));

    let centerY = containerHeight / 2;
    const firstVideo = swiperInstance.el?.querySelector('.swiper-slide .vso-shoppable-video__video-container');
    if (firstVideo && swiperInstance.el) {
      const swiperRect = swiperInstance.el.getBoundingClientRect();
      const videoRect = firstVideo.getBoundingClientRect();
      centerY = (videoRect.top - swiperRect.top) + (videoRect.height / 2);
    }

    const prevLeft = clampX(slideStart(prevIndex) + inset - arrowOffset);
    const nextLeft = clampX(slideStart(nextIndex) + slideWidth - inset + arrowOffset);

    navPrev.style.display = 'flex';
    navNext.style.display = 'flex';
    navPrev.style.top = `${centerY}px`;
    navNext.style.top = `${centerY}px`;
    navPrev.style.left = `${prevLeft}px`;
    navNext.style.left = `${nextLeft}px`;
  };

  const setStableTestimonialHeight = () => {
    if (!testimonialWrapper || !slidesTestimonialData.length) return;
    const measurement = document.createElement('div');
    measurement.className = 'vso-shoppable-video__testimonial';
    measurement.style.position = 'absolute';
    measurement.style.visibility = 'hidden';
    measurement.style.pointerEvents = 'none';
    measurement.style.left = '-9999px';
    measurement.style.top = '0';
    measurement.style.width = `${testimonialWrapper.clientWidth}px`;

    const textProbe = document.createElement('div');
    textProbe.className = 'vso-shoppable-video__testimonial-text';
    const authorProbe = document.createElement('span');
    authorProbe.className = 'vso-shoppable-video__testimonial-author';
    measurement.append(textProbe, authorProbe);

    testimonialWrapper.parentNode.appendChild(measurement);

    let maxHeight = measurement.offsetHeight;
    slidesTestimonialData.forEach(({ text, author }) => {
      textProbe.innerHTML = text;
      if (author) {
        authorProbe.textContent = author;
        authorProbe.style.display = '';
      } else {
        authorProbe.textContent = '';
        authorProbe.style.display = 'none';
      }
      maxHeight = Math.max(maxHeight, measurement.offsetHeight);
    });

    measurement.remove();
    testimonialWrapper.style.minHeight = `${maxHeight}px`;
  };

  setStableTestimonialHeight();
  setStableCarouselHeight();

  let resizeTestimonialTimer;
  const handleTestimonialResize = () => {
    if (!testimonialWrapper) return;
    clearTimeout(resizeTestimonialTimer);
    resizeTestimonialTimer = setTimeout(setStableTestimonialHeight, 150);
  };
  addGlobalListener(window, 'resize', handleTestimonialResize);

  let resizeCarouselTimer;
  const scheduleCarouselHeightUpdate = () => {
    clearTimeout(resizeCarouselTimer);
    resizeCarouselTimer = setTimeout(() => {
      setStableCarouselHeight();
      if (swiperInstance) {
        positionOverlayArrows(swiperInstance);
      }
    }, 150);
  };
  addGlobalListener(window, 'resize', scheduleCarouselHeightUpdate);

  const pauseAllVideos = () => {
    sectionEl.querySelectorAll('video.vso-shoppable-video__video').forEach((video) => {
      video.pause();
      const playButton = video.closest('[data-video-container]')?.querySelector('[data-play-button]');
      setPlayButtonState(playButton, false);
    });
  };

  const playActiveVideo = (swiperInstance) => {
    if (!swiperInstance || !autoplayEnabled) return;
    const activeSlide = swiperInstance.slides[swiperInstance.activeIndex];
    if (!activeSlide) return;
    const video = activeSlide.querySelector('video.vso-shoppable-video__video');
    if (!video) return;
    video.muted = globalMuted;
    video.setAttribute('playsinline', 'true');
    video.play().then(() => {
      const container = video.closest('[data-video-container]');
      setPlayButtonState(container?.querySelector('[data-play-button]'), true);
      setMuteButtonState(container?.querySelector('[data-mute-button]'), globalMuted);
    }).catch(() => {});
  };

  const updateTestimonial = (swiperInstance, immediate = false) => {
    if (!testimonialWrapper) return;
    const activeSlide = getActiveSlideEl(swiperInstance);

    const slideData = getSlideTestimonialData(activeSlide);
    const nextData = slideData ? { ...slideData } : lastTestimonialData;

    const applyUpdate = () => {
      if (testimonialTextEl) {
        testimonialTextEl.innerHTML = nextData.text;
      }
      if (testimonialAuthorEl) {
        testimonialAuthorEl.textContent = nextData.author;
        testimonialAuthorEl.style.display = nextData.author ? '' : 'none';
      }
      lastTestimonialData = nextData;
      testimonialWrapper.classList.remove('is-transitioning');
    };

    if (immediate || !activeSlide) {
      applyUpdate();
      return;
    }

    testimonialWrapper.classList.add('is-transitioning');
    clearTimeout(testimonialTimeout);
    testimonialTimeout = setTimeout(applyUpdate, 140);
  };

  const bindVideoControls = () => {
    const containers = sectionEl.querySelectorAll('[data-video-container]');
    containers.forEach((container) => {
      const video = container.querySelector('video.vso-shoppable-video__video');
      if (!video) return;

      video.muted = globalMuted;
      setMuteButtonState(container.querySelector('[data-mute-button]'), globalMuted);

      const ensureMeasuredHeight = () => scheduleCarouselHeightUpdate();
      if (video.readyState >= 2) {
        ensureMeasuredHeight();
      } else {
        video.addEventListener('loadedmetadata', ensureMeasuredHeight, { once: true });
        video.addEventListener('loadeddata', ensureMeasuredHeight, { once: true });
      }

      const playButton = container.querySelector('[data-play-button]');
      const muteButton = container.querySelector('[data-mute-button]');

      const handleTogglePlay = (event) => {
        if (event) {
          event.preventDefault();
          event.stopPropagation();
        }
        const slide = container.closest('.swiper-slide');
        if (!slide?.classList.contains('swiper-slide-active')) {
          return;
        }
        if (video.paused) {
          video.play();
          setPlayButtonState(playButton, true);
        } else {
          video.pause();
          setPlayButtonState(playButton, false);
        }
      };

      if (playButton) {
        playButton.addEventListener('click', handleTogglePlay);
      }
      video.addEventListener('click', handleTogglePlay);

      if (muteButton) {
        muteButton.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          const nextMuted = !video.muted;
          video.muted = nextMuted;
          globalMuted = nextMuted;
          localStorage.setItem('vsoShoppableVideoMuted', nextMuted ? 'true' : 'false');
          setMuteButtonState(muteButton, nextMuted);
        });
      }

      video.addEventListener('play', () => setPlayButtonState(playButton, true));
      video.addEventListener('pause', () => setPlayButtonState(playButton, false));
    });
  };

  const totalSlides = {{ section.blocks.size }};
  const shouldLoop = true;
  const initialSlide = totalSlides >= 5 ? 2 : Math.max(0, Math.floor(totalSlides / 2));

  const swiperConfig = {
    slidesPerView: 1.2,
    spaceBetween: 16,
    centeredSlides: true,
    loop: shouldLoop,
    loopAdditionalSlides: 2,
    centeredSlidesBounds: true,
    initialSlide,
    breakpoints: {
      750: {
        slidesPerView: 3,
        spaceBetween: 24
      },
      1200: {
        slidesPerView: 5,
        spaceBetween: 32
      }
    },
    on: {
      init() {
        bindVideoControls();
        playActiveVideo(this);
        updateTestimonial(this, true);
        setStableCarouselHeight();
        positionOverlayArrows(this);
      },
      slideChangeTransitionStart() {
        pauseAllVideos();
        positionOverlayArrows(this);
      },
      slideChangeTransitionEnd() {
        playActiveVideo(this);
        positionOverlayArrows(this);
      },
      slideChange() {
        updateTestimonial(this);
        positionOverlayArrows(this);
      },
      resize() {
        positionOverlayArrows(this);
      }
    }
  };

  if (navPrev && navNext) {
    swiperConfig.navigation = {
      nextEl: navNext,
      prevEl: navPrev
    };
  }

  swiperInstance = new Swiper(swiperContainer, swiperConfig);

  const handleVisibilityChange = () => {
    if (document.hidden) {
      pauseAllVideos();
    } else {
      playActiveVideo(swiperInstance);
    }
  };
  addGlobalListener(document, 'visibilitychange', handleVisibilityChange);

  store['{{ section.id }}'] = () => {
    if (swiperInstance) {
      swiperInstance.destroy(true, true);
      swiperInstance = null;
    }
    clearTimeout(resizeTestimonialTimer);
    clearTimeout(resizeCarouselTimer);
    clearTimeout(testimonialTimeout);
    globalListeners.forEach((unbind) => unbind());
    globalListeners.length = 0;
  };
};

const cleanupShoppableVideoStories{{ section.id | replace: '-', '' }} = () => {
  const store = window.__vsoShoppableVideoStories;
  if (store && typeof store['{{ section.id }}'] === 'function') {
    store['{{ section.id }}']();
    delete store['{{ section.id }}'];
  }
};

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initShoppableVideoStories{{ section.id | replace: '-', '' }});
} else {
  initShoppableVideoStories{{ section.id | replace: '-', '' }}();
}

if (window.Shopify && Shopify.designMode) {
  document.addEventListener('shopify:section:load', (event) => {
    if (event.detail?.sectionId === '{{ section.id }}') {
      initShoppableVideoStories{{ section.id | replace: '-', '' }}();
    }
  });
  document.addEventListener('shopify:section:unload', (event) => {
    if (event.detail?.sectionId === '{{ section.id }}') {
      cleanupShoppableVideoStories{{ section.id | replace: '-', '' }}();
    }
  });
}

<section id="shopify-section-{{ section.id }}" class="fh-features" style="background: linear-gradient(135deg, #f8fffe 0%, #e8f5ee 100%);">
  <div class="page-width">
    <div class="fh-features__row">
      {% for block in section.blocks %}
        {% if block.type == 'feature' %}
          <div class="fh-feature-item" {{ block.shopify_attributes }}>
            <span class="fh-feature-item__icon" aria-hidden="true">
              {% case block.settings.icon %}

                {% when 'drop' %}
                  <!-- Droplet / absorción -->
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="#40916C" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2C12 2 5 9.5 5 14a7 7 0 0014 0C19 9.5 12 2 12 2z"/>
                  </svg>

                {% when 'capsule' %}
                  <!-- Pill / 60 cápsulas -->
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="#40916C" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="10" width="18" height="4" rx="2"/>
                    <line x1="12" y1="10" x2="12" y2="14"/>
                  </svg>

                {% when 'gluten' %}
                  <!-- Wheat tachado / gluten free -->
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="#40916C" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3v18"/>
                    <path d="M8 7c0 0 1 2 4 2s4-2 4-2"/>
                    <path d="M8 11c0 0 1 2 4 2s4-2 4-2"/>
                    <path d="M9 15c0 0 1 2 3 2s3-2 3-2"/>
                    <line x1="4" y1="4" x2="20" y2="20" stroke-width="1.5"/>
                  </svg>

                {% when 'check' %}
                  <!-- Check círculo (gluten free fallback) -->
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="#40916C" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9"/>
                    <path d="M8 12.5l2.5 2.5 5-5"/>
                  </svg>

                {% when 'calendar' %}
                  <!-- Calendar / fácil rutina -->
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="#40916C" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="5" width="18" height="16" rx="2"/>
                    <path d="M16 3v4M8 3v4M3 9h18"/>
                    <path d="M8 13h2M11 13h2M14 13h2M8 16h2M11 16h2"/>
                  </svg>

                {% when 'target' %}
                  <!-- Target / diana / bienestar por objetivo -->
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="#40916C" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9"/>
                    <circle cx="12" cy="12" r="5"/>
                    <circle cx="12" cy="12" r="1" fill="#40916C"/>
                  </svg>

                {% when 'star' %}
                  <!-- Star -->
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="#40916C" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>

                {% when 'leaf' %}
                  <!-- Leaf / ingredientes naturales -->
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="#40916C" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 8C17 8 18 13 12 17c-4 2.5-8 2-8 2s1-4 3.5-7C10 8.5 14 7 17 8z"/>
                    <path d="M7 19l4-5"/>
                  </svg>

              {% endcase %}
            </span>
            <span class="fh-feature-item__text">{{ block.settings.text }}</span>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Features Bar",
  "tag": "section",
  "settings": [],
  "blocks": [
    {
      "type": "feature",
      "name": "Beneficio",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Ícono",
          "options": [
            { "value": "drop",     "label": "Gota (absorción)" },
            { "value": "capsule",  "label": "Cápsula / píldora" },
            { "value": "gluten",   "label": "Trigo tachado (gluten free)" },
            { "value": "check",    "label": "Check círculo" },
            { "value": "calendar", "label": "Calendario" },
            { "value": "target",   "label": "Diana (objetivo)" },
            { "value": "star",     "label": "Estrella" },
            { "value": "leaf",     "label": "Hoja (natural)" }
          ],
          "default": "drop"
        },
        { "type": "text", "id": "text", "label": "Texto", "default": "Alta absorción X5" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Features Bar",
      "blocks": [
        { "type": "feature", "settings": { "icon": "drop",     "text": "Alta absorción X5" } },
        { "type": "feature", "settings": { "icon": "capsule",  "text": "60 cápsulas por frasco" } },
        { "type": "feature", "settings": { "icon": "gluten",   "text": "Gluten free" } },
        { "type": "feature", "settings": { "icon": "calendar", "text": "Fácil de incorporar a tu rutina" } },
        { "type": "feature", "settings": { "icon": "target",   "text": "Bienestar por objetivo" } }
      ]
    }
  ]
}
{% endschema %}

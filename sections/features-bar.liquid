<section id="shopify-section-{{ section.id }}" class="fh-features" style="background-color:{{ section.settings.bg_color }};">
  <div class="page-width">
    <div class="fh-features__row">
      {% for block in section.blocks %}
        {% if block.type == 'feature' %}
          <div class="fh-feature-item" {{ block.shopify_attributes }}>
            <span class="fh-feature-item__icon" aria-hidden="true">
              {% case block.settings.icon %}
                {% when 'drop' %}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3.75c0 0-6.75 6.482-6.75 11.25a6.75 6.75 0 0013.5 0C18.75 10.232 12 3.75 12 3.75z"/></svg>
                {% when 'capsule' %}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15M14.25 3.104c.251.023.501.05.75.082M19.8 15a2.25 2.25 0 01.45 1.317l-.003.014-.006.018a2.25 2.25 0 01-2.25 1.902H5.25a2.25 2.25 0 01-2.25-1.902l-.006-.018-.003-.014A2.25 2.25 0 013.45 15M19.8 15H4.2"/></svg>
                {% when 'leaf' %}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M20.893 13.393l-1.135-1.135a2.252 2.252 0 01-.421-.585l-1.08-2.16a.414.414 0 00-.663-.107.827.827 0 01-.812.21l-1.273-.363a.89.89 0 00-.738 1.595l.587.39c.59.395.674 1.23.172 1.732l-.2.2c-.212.212-.33.498-.33.796v.41c0 .409-.11.809-.32 1.158l-1.315 2.191a2.11 2.11 0 01-1.81 1.025 1.055 1.055 0 01-1.055-1.055v-1.172c0-.92-.56-1.747-1.414-2.089l-.655-.261a2.25 2.25 0 01-1.383-2.46l.007-.042a2.25 2.25 0 01.29-.787l.09-.15a2.25 2.25 0 012.37-1.048l1.178.236a1.125 1.125 0 001.302-.795l.208-.73a1.125 1.125 0 00-.578-1.315l-.665-.332-.091.091a2.25 2.25 0 01-1.591.659h-.18c-.249 0-.487.1-.662.274a.931.931 0 01-1.458-1.137l1.411-2.353a2.25 2.25 0 00.286-.76m11.928 9.869A9 9 0 008.965 3.525m11.928 9.868A9 9 0 118.965 3.525"/></svg>
                {% when 'calendar' %}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/></svg>
                {% when 'star' %}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"/></svg>
                {% when 'check' %}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              {% endcase %}
            </span>
            <span class="fh-feature-item__text">{{ block.settings.text }}</span>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Features Bar",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Fondo", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Beneficio",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Ícono",
          "options": [
            { "value": "drop",     "label": "Gota" },
            { "value": "capsule",  "label": "Cápsula" },
            { "value": "leaf",     "label": "Hoja" },
            { "value": "calendar", "label": "Calendario" },
            { "value": "star",     "label": "Estrella" },
            { "value": "check",    "label": "Check círculo" }
          ],
          "default": "drop"
        },
        { "type": "text", "id": "text", "label": "Texto", "default": "Alta absorción X5" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Features Bar",
      "blocks": [
        { "type": "feature", "settings": { "icon": "drop",     "text": "Alta absorción X5" } },
        { "type": "feature", "settings": { "icon": "capsule",  "text": "60 cápsulas por frasco" } },
        { "type": "feature", "settings": { "icon": "check",    "text": "Gluten free" } },
        { "type": "feature", "settings": { "icon": "calendar", "text": "Fácil de incorporar a tu rutina" } },
        { "type": "feature", "settings": { "icon": "star",     "text": "Bienestar por objetivo" } }
      ]
    }
  ]
}
{% endschema %}

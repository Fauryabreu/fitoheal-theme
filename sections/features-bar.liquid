<section
  id="shopify-section-{{ section.id }}"
  class="features-bar"
  style="background-color: {{ section.settings.bg_color }};"
>
  <div class="page-width">
    <div class="features-bar__grid">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'feature' %}
            <div class="feature-item" {{ block.shopify_attributes }}>
              <div class="feature-item__icon">
                {% case block.settings.icon %}
                  {% when 'leaf' %}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 17.25c-4.097 0-7.5-2.804-7.5-6.375A6.187 6.187 0 0112 4.5c2.485 0 4.5 2.239 4.5 4.875A4.313 4.313 0 0112 13.5c-1.243 0-2.25-.895-2.25-2 0-1.104 1.007-2 2.25-2 .83 0 1.5.597 1.5 1.333"/></svg>
                  {% when 'shield' %}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
                  {% when 'truck' %}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/></svg>
                  {% when 'flask' %}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15M14.25 3.104c.251.023.501.05.75.082M19.8 15a2.25 2.25 0 01.45 1.317l-.003.014-.0 .019-.006.018a2.25 2.25 0 01-2.25 1.902H5.25a2.25 2.25 0 01-2.25-1.902l-.006-.018-.0-.019-.003-.014A2.25 2.25 0 013.45 15M19.8 15H4.2"/></svg>
                  {% when 'sparkle' %}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z"/></svg>
                  {% when 'check' %}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                  {% else %}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"/></svg>
                {% endcase %}
              </div>
              <div class="feature-item__content">
                {% if block.settings.title != blank %}
                  <p class="feature-item__title">{{ block.settings.title }}</p>
                {% endif %}
                {% if block.settings.description != blank %}
                  <p class="feature-item__desc">{{ block.settings.description }}</p>
                {% endif %}
              </div>
            </div>
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Features Bar",
  "tag": "section",
  "class": "features-bar-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#1B4332"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf",    "label": "Leaf" },
            { "value": "shield",  "label": "Shield" },
            { "value": "truck",   "label": "Truck" },
            { "value": "flask",   "label": "Flask" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "check",   "label": "Check" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "100% Natural"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Ingredientes de origen natural, sin aditivos artificiales."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Features Bar",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "leaf",
            "title": "100% Natural",
            "description": "Sin colorantes, conservantes ni GMO."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "flask",
            "title": "Tecnología liposomal",
            "description": "Absorción hasta 8x superior al suplemento estándar."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "shield",
            "title": "Garantía 30 días",
            "description": "Devolución sin preguntas si no estás satisfecho."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "truck",
            "title": "Envío rápido",
            "description": "Entrega en 24–48h con seguimiento en tiempo real."
          }
        }
      ]
    }
  ]
}
{% endschema %}

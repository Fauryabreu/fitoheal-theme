{% if section.settings.show_bar %}
<div class="fh-announcement" style="background: linear-gradient(90deg, #1B4332 0%, #2D6A4F 50%, #1B4332 100%); color:{{ section.settings.text_color }};">
  <div class="page-width">
    <ul class="fh-announcement__list" role="list">
      {% for i in (1..3) %}
        {% assign text_key = 'item_' | append: i | append: '_text' %}
        {% assign link_key = 'item_' | append: i | append: '_link' %}
        {% assign text = section.settings[text_key] %}
        {% assign link = section.settings[link_key] %}
        {% if text != blank %}
          <li class="fh-announcement__item">
            {% if link != blank %}<a href="{{ link }}">{{ text }}</a>
            {% else %}{{ text }}{% endif %}
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</div>
{% endif %}

{% schema %}
{
  "name": "Announcement Bar",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "show_bar",   "label": "Mostrar barra", "default": true },
    { "type": "color",    "id": "bg_color",   "label": "Fondo",  "default": "#1B4332" },
    { "type": "color",    "id": "text_color", "label": "Texto",  "default": "#ffffff"  },
    { "type": "header",   "content": "Item 1" },
    { "type": "text", "id": "item_1_text", "label": "Texto 1", "default": "Envío gratis en pedidos superiores a $150.000" },
    { "type": "url",  "id": "item_1_link", "label": "Link 1" },
    { "type": "header",   "content": "Item 2" },
    { "type": "text", "id": "item_2_text", "label": "Texto 2", "default": "Alta absorción liposomal X5" },
    { "type": "url",  "id": "item_2_link", "label": "Link 2" },
    { "type": "header",   "content": "Item 3" },
    { "type": "text", "id": "item_3_text", "label": "Texto 3", "default": "Bienestar por objetivo, todos los días." },
    { "type": "url",  "id": "item_3_link", "label": "Link 3" }
  ],
  "presets": [{ "name": "Announcement Bar" }]
}
{% endschema %}

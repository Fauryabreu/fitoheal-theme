<section
  id="shopify-section-{{ section.id }}"
  class="fh-hero"
  style="background-color: {{ section.settings.bg_color }};"
>
  <div class="fh-hero__inner page-width">

    <!-- ── Columna izquierda: texto ── -->
    <div class="fh-hero__content">

      {% if section.settings.titulo != blank %}
        <h1 class="fh-hero__title">{{ section.settings.titulo }}</h1>
      {% endif %}

      {% if section.settings.subtitulo != blank %}
        <p class="fh-hero__subtitle">{{ section.settings.subtitulo }}</p>
      {% endif %}

      <!-- CTAs -->
      <div class="fh-hero__ctas">
        {% if section.settings.texto_btn_primario != blank %}
          <a
            href="{{ section.settings.link_btn_primario | default: '#' }}"
            class="fh-btn fh-btn--primary"
          >
            {{ section.settings.texto_btn_primario }}
          </a>
        {% endif %}
        {% if section.settings.texto_btn_secundario != blank %}
          <a
            href="{{ section.settings.link_btn_secundario | default: '#' }}"
            class="fh-btn fh-btn--outline"
          >
            {{ section.settings.texto_btn_secundario }}
          </a>
        {% endif %}
      </div>

      <!-- Trust icons -->
      <div class="fh-hero__trust" role="list">

        {% comment %} Trust 1 {% endcomment %}
        {% if section.settings.trust_1_text != blank %}
          <div class="fh-trust-item" role="listitem">
            <span class="fh-trust-item__icon" aria-hidden="true">
              <!-- Liposomal / absorción -->
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="{{ section.settings.trust_icon_color }}">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15M14.25 3.104c.251.023.501.05.75.082M19.8 15a2.25 2.25 0 01.45 1.317l-.003.014-.006.018a2.25 2.25 0 01-2.25 1.902H5.25a2.25 2.25 0 01-2.25-1.902l-.006-.018-.003-.014A2.25 2.25 0 013.45 15M19.8 15H4.2"/>
              </svg>
            </span>
            <span class="fh-trust-item__label">{{ section.settings.trust_1_text }}</span>
          </div>
        {% endif %}

        {% comment %} Trust 2 {% endcomment %}
        {% if section.settings.trust_2_text != blank %}
          <div class="fh-trust-item" role="listitem">
            <span class="fh-trust-item__icon" aria-hidden="true">
              <!-- Hoja / natural -->
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="{{ section.settings.trust_icon_color }}">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.893 13.393l-1.135-1.135a2.252 2.252 0 01-.421-.585l-1.08-2.16a.414.414 0 00-.663-.107.827.827 0 01-.812.21l-1.273-.363a.89.89 0 00-.738 1.595l.587.39c.59.395.674 1.23.172 1.732l-.2.2c-.212.212-.33.498-.33.796v.41c0 .409-.11.809-.32 1.158l-1.315 2.191a2.11 2.11 0 01-1.81 1.025 1.055 1.055 0 01-1.055-1.055v-1.172c0-.92-.56-1.747-1.414-2.089l-.655-.261a2.25 2.25 0 01-1.383-2.46l.007-.042a2.25 2.25 0 01.29-.787l.09-.15a2.25 2.25 0 012.37-1.048l1.178.236a1.125 1.125 0 001.302-.795l.208-.73a1.125 1.125 0 00-.578-1.315l-.665-.332-.091.091a2.25 2.25 0 01-1.591.659h-.18c-.249 0-.487.1-.662.274a.931.931 0 01-1.458-1.137l1.411-2.353a2.25 2.25 0 00.286-.76m11.928 9.869A9 9 0 008.965 3.525m11.928 9.868A9 9 0 118.965 3.525"/>
              </svg>
            </span>
            <span class="fh-trust-item__label">{{ section.settings.trust_2_text }}</span>
          </div>
        {% endif %}

        {% comment %} Trust 3 {% endcomment %}
        {% if section.settings.trust_3_text != blank %}
          <div class="fh-trust-item" role="listitem">
            <span class="fh-trust-item__icon" aria-hidden="true">
              <!-- Profesionales / academia -->
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="{{ section.settings.trust_icon_color }}">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5"/>
              </svg>
            </span>
            <span class="fh-trust-item__label">{{ section.settings.trust_3_text }}</span>
          </div>
        {% endif %}

        {% comment %} Trust 4 {% endcomment %}
        {% if section.settings.trust_4_text != blank %}
          <div class="fh-trust-item" role="listitem">
            <span class="fh-trust-item__icon" aria-hidden="true">
              <!-- Ubicación / Colombia -->
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="{{ section.settings.trust_icon_color }}">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
              </svg>
            </span>
            <span class="fh-trust-item__label">{{ section.settings.trust_4_text }}</span>
          </div>
        {% endif %}

      </div>
    </div>

    <!-- ── Columna derecha: imagen ── -->
    <div class="fh-hero__media">
      {% if section.settings.imagen_hero != blank %}
        {{
          section.settings.imagen_hero
          | image_url: width: 1200
          | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              alt: section.settings.titulo,
              class: 'fh-hero__img'
        }}
      {% else %}
        <div class="fh-hero__img-placeholder" aria-hidden="true">
          {{ 'product-1' | placeholder_svg_tag: 'fh-hero__placeholder-svg' }}
        </div>
      {% endif %}
    </div>

  </div>
</section>

<style>
  /* ── Hero wrapper ── */
  .fh-hero {
    overflow: hidden;
    /* Toque verde muy suave sobre el crema base */
    background-image: radial-gradient(
      ellipse 70% 60% at 85% 50%,
      rgba(116, 198, 157, 0.12) 0%,
      transparent 70%
    );
  }

  .fh-hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 620px;
    gap: 0;
  }

  /* ── Columna izquierda ── */
  .fh-hero__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.75rem;
    padding-block: clamp(3rem, 7vw, 6rem);
    padding-right: clamp(1.5rem, 4vw, 3.5rem);
  }

  .fh-hero__title {
    font-family: 'Fraunces', Georgia, serif;
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: #1B4332;
  }

  .fh-hero__subtitle {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 1rem;
    line-height: 1.7;
    color: #3D3D3D;
    max-width: 460px;
  }

  /* ── CTA buttons ── */
  .fh-hero__ctas {
    display: flex;
    gap: 0.875rem;
    flex-wrap: wrap;
  }

  .fh-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1;
    padding: 0.9rem 1.875rem;
    border-radius: 100px;
    border: 2px solid transparent;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 220ms ease, color 220ms ease,
                border-color 220ms ease, box-shadow 220ms ease,
                transform 140ms ease;
    white-space: nowrap;
  }

  .fh-btn:hover  { transform: translateY(-2px); }
  .fh-btn:active { transform: translateY(0); }

  .fh-btn--primary {
    background-color: #1B4332;
    color: #ffffff;
    border-color: #1B4332;
  }
  .fh-btn--primary:hover {
    background-color: #2D6A4F;
    border-color: #2D6A4F;
    box-shadow: 0 6px 20px rgba(27, 67, 50, 0.28);
  }

  .fh-btn--outline {
    background-color: transparent;
    color: #1B4332;
    border-color: #1B4332;
  }
  .fh-btn--outline:hover {
    background-color: #1B4332;
    color: #ffffff;
  }

  /* ── Trust icons ── */
  .fh-hero__trust {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }

  .fh-trust-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    text-align: center;
    max-width: 88px;
  }

  .fh-trust-item__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background-color: rgba(64, 145, 108, 0.1);
    flex-shrink: 0;
  }

  .fh-trust-item__icon svg {
    width: 22px;
    height: 22px;
  }

  .fh-trust-item__label {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.4;
    color: #5A5A5A;
  }

  /* ── Columna derecha: imagen ── */
  .fh-hero__media {
    position: relative;
    overflow: hidden;
    background-color: #FAFDF8;
  }

  .fh-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .fh-hero__img-placeholder,
  .fh-hero__placeholder-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* ── Responsive mobile ── */
  @media (max-width: 768px) {
    .fh-hero__inner {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto;
      min-height: unset;
    }

    /* Imagen arriba en mobile */
    .fh-hero__media {
      order: -1;
      height: 320px;
    }

    .fh-hero__content {
      padding-right: 0;
      padding-block: 2.5rem;
      gap: 1.375rem;
    }

    .fh-hero__title {
      font-size: clamp(1.875rem, 7vw, 2.5rem);
    }

    .fh-hero__trust {
      gap: 1rem;
    }

    .fh-trust-item {
      max-width: 72px;
    }
  }

  @media (max-width: 420px) {
    .fh-hero__ctas {
      flex-direction: column;
    }
    .fh-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "fh-hero-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#FAFDF8"
    },
    {
      "type": "header",
      "content": "Texto principal"
    },
    {
      "type": "text",
      "id": "titulo",
      "label": "Título",
      "default": "Bienestar liposomal para objetivos reales"
    },
    {
      "type": "textarea",
      "id": "subtitulo",
      "label": "Subtítulo",
      "default": "Fórmulas de alta absorción que apoyan tu bienestar en descanso, estrés, enfoque, digestión y metabolismo."
    },
    {
      "type": "header",
      "content": "Botón primario"
    },
    {
      "type": "text",
      "id": "texto_btn_primario",
      "label": "Texto botón primario",
      "default": "Comprar ahora"
    },
    {
      "type": "url",
      "id": "link_btn_primario",
      "label": "Link botón primario"
    },
    {
      "type": "header",
      "content": "Botón secundario"
    },
    {
      "type": "text",
      "id": "texto_btn_secundario",
      "label": "Texto botón secundario",
      "default": "Descubre los kits"
    },
    {
      "type": "url",
      "id": "link_btn_secundario",
      "label": "Link botón secundario"
    },
    {
      "type": "header",
      "content": "Imagen del producto"
    },
    {
      "type": "image_picker",
      "id": "imagen_hero",
      "label": "Imagen hero (columna derecha)"
    },
    {
      "type": "header",
      "content": "Trust icons"
    },
    {
      "type": "color",
      "id": "trust_icon_color",
      "label": "Color iconos",
      "default": "#40916C"
    },
    {
      "type": "text",
      "id": "trust_1_text",
      "label": "Trust 1",
      "default": "Liposomal alta absorción X5"
    },
    {
      "type": "text",
      "id": "trust_2_text",
      "label": "Trust 2",
      "default": "Ingredientes naturales"
    },
    {
      "type": "text",
      "id": "trust_3_text",
      "label": "Trust 3",
      "default": "Desarrollado por profesionales"
    },
    {
      "type": "text",
      "id": "trust_4_text",
      "label": "Trust 4",
      "default": "Hecho en Colombia"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}

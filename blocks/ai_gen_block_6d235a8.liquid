{% doc %}
  @prompt
    Crea un bloque Hero Slideshow de ancho completo, exclusivamente con videos:
    Slides: blocks repetibles (mínimo 5 configurables). Cada slide tiene DOS videos independientes:
    
    Video desktop: formato horizontal (16:9), con su propio picker
    Video mobile: formato vertical (9:16), con su propio picker independiente
    
    En mobile SIEMPRE se muestra el video mobile si existe; el de desktop solo como fallback si el campo mobile está vacío. Implementar con dos elementos <video> y display condicional por breakpoint (768px) — NO usar object-fit sobre un solo video.
    Comportamiento de video: autoplay, muted, loop, playsinline, sin controles. CRÍTICO para performance: solo el slide activo reproduce; los demás con preload="none" y se cargan al entrar en vista. Cada slide con campo opcional de poster image (imagen que se muestra mientras el video carga).
    Contenido por slide (todo opcional y editable): etiqueta pequeña (eyebrow), título grande, subtítulo, botón primario (texto + link), botón secundario (texto + link). Posición horizontal del texto: izquierda/centro/derecha. Alineación vertical: arriba/centro/abajo.
    Overlay: capa oscura sobre el video con opacidad ajustable 0–80% para legibilidad.
    Controles del slider: flechas mostrar/ocultar, dots mostrar/ocultar, autoplay del slider activable con velocidad ajustable 3–10 segundos, transición fade o slide, pausa al hover.
    Alturas independientes: setting de altura desktop (small/medium/large/fullscreen) y setting de altura mobile separado (small/medium/large/fullscreen). No heredar uno del otro.
    Layout mobile: texto centrado, botones apilados al 100% de ancho, tamaño de título mobile con setting propio.
    Diseño: botón primario fondo #1B4332 texto #FAFDF8, secundario outline blanco. Border-radius de botones ajustable. Títulos font serif display, cuerpo font sans. Tamaño de título desktop y mobile por separado.
    Todo editable desde el theme editor sin tocar código.
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-slideshow-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: block;
  }

  .ai-hero-slideshow-{{ ai_gen_id }}--height-small-desktop {
    height: 400px;
  }

  .ai-hero-slideshow-{{ ai_gen_id }}--height-medium-desktop {
    height: 600px;
  }

  .ai-hero-slideshow-{{ ai_gen_id }}--height-large-desktop {
    height: 800px;
  }

  .ai-hero-slideshow-{{ ai_gen_id }}--height-fullscreen-desktop {
    height: 100vh;
  }

  .ai-hero-slideshow__slides-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ai-hero-slideshow__slide-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s ease-in-out;
  }

  .ai-hero-slideshow-{{ ai_gen_id }}--transition-slide .ai-hero-slideshow__slide-{{ ai_gen_id }} {
    transform: translateX(100%);
    transition: transform 0.6s ease-in-out, opacity 0.6s ease-in-out;
  }

  .ai-hero-slideshow-{{ ai_gen_id }}--transition-slide .ai-hero-slideshow__slide-{{ ai_gen_id }}.active {
    transform: translateX(0);
  }

  .ai-hero-slideshow__slide-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
    z-index: 1;
  }

  .ai-hero-slideshow__video-container-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .ai-hero-slideshow__video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-hero-slideshow__video-desktop-{{ ai_gen_id }} {
    display: block;
  }

  .ai-hero-slideshow__video-mobile-{{ ai_gen_id }} {
    display: none;
  }

  .ai-hero-slideshow__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});
    z-index: 1;
  }

  .ai-hero-slideshow__content-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    display: flex;
    padding: 40px;
  }

  .ai-hero-slideshow__content-{{ ai_gen_id }}--align-top {
    align-items: flex-start;
  }

  .ai-hero-slideshow__content-{{ ai_gen_id }}--align-center {
    align-items: center;
  }

  .ai-hero-slideshow__content-{{ ai_gen_id }}--align-bottom {
    align-items: flex-end;
  }

  .ai-hero-slideshow__content-{{ ai_gen_id }}--justify-left {
    justify-content: flex-start;
  }

  .ai-hero-slideshow__content-{{ ai_gen_id }}--justify-center {
    justify-content: center;
  }

  .ai-hero-slideshow__content-{{ ai_gen_id }}--justify-right {
    justify-content: flex-end;
  }

  .ai-hero-slideshow__text-wrapper-{{ ai_gen_id }} {
    max-width: 800px;
    color: #FAFDF8;
  }

  .ai-hero-slideshow__eyebrow-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 16px;
  }

  .ai-hero-slideshow__title-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-size: {{ block.settings.title_size_desktop }}px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 16px;
  }

  .ai-hero-slideshow__subtitle-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-size: 18px;
    line-height: 1.6;
    margin-bottom: 24px;
  }

  .ai-hero-slideshow__buttons-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .ai-hero-slideshow__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 32px;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .ai-hero-slideshow__button-{{ ai_gen_id }}--primary {
    background-color: #1B4332;
    color: #FAFDF8;
    border: 2px solid #1B4332;
  }

  .ai-hero-slideshow__button-{{ ai_gen_id }}--primary:hover {
    background-color: #0f2a1f;
    border-color: #0f2a1f;
  }

  .ai-hero-slideshow__button-{{ ai_gen_id }}--secondary {
    background-color: transparent;
    color: #FAFDF8;
    border: 2px solid #FAFDF8;
  }

  .ai-hero-slideshow__button-{{ ai_gen_id }}--secondary:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }

  .ai-hero-slideshow__arrows-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    transform: translateY(-50%);
    z-index: 3;
    display: flex;
    justify-content: space-between;
    padding: 0 20px;
    pointer-events: none;
  }

  .ai-hero-slideshow__arrow-{{ ai_gen_id }} {
    width: 50px;
    height: 50px;
    background-color: rgba(255, 255, 255, 0.9);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    pointer-events: auto;
  }

  .ai-hero-slideshow__arrow-{{ ai_gen_id }}:hover {
    background-color: rgba(255, 255, 255, 1);
    transform: scale(1.1);
  }

  .ai-hero-slideshow__arrow-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
    fill: #121212;
  }

  .ai-hero-slideshow__dots-{{ ai_gen_id }} {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    gap: 12px;
  }

  .ai-hero-slideshow__dot-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.5);
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-hero-slideshow__dot-{{ ai_gen_id }}.active {
    background-color: rgba(255, 255, 255, 1);
    transform: scale(1.2);
  }

  @media screen and (max-width: 768px) {
    .ai-hero-slideshow-{{ ai_gen_id }}--height-small-desktop {
      height: auto;
    }

    .ai-hero-slideshow-{{ ai_gen_id }}--height-medium-desktop {
      height: auto;
    }

    .ai-hero-slideshow-{{ ai_gen_id }}--height-large-desktop {
      height: auto;
    }

    .ai-hero-slideshow-{{ ai_gen_id }}--height-fullscreen-desktop {
      height: auto;
    }

    .ai-hero-slideshow-{{ ai_gen_id }}--height-small-mobile {
      height: 400px;
    }

    .ai-hero-slideshow-{{ ai_gen_id }}--height-medium-mobile {
      height: 600px;
    }

    .ai-hero-slideshow-{{ ai_gen_id }}--height-large-mobile {
      height: 700px;
    }

    .ai-hero-slideshow-{{ ai_gen_id }}--height-fullscreen-mobile {
      height: 100vh;
    }

    .ai-hero-slideshow__video-desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-hero-slideshow__video-mobile-{{ ai_gen_id }} {
      display: block;
    }

    .ai-hero-slideshow__content-{{ ai_gen_id }} {
      padding: 24px;
      text-align: center;
      justify-content: center;
    }

    .ai-hero-slideshow__text-wrapper-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-hero-slideshow__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size_mobile }}px;
    }

    .ai-hero-slideshow__buttons-{{ ai_gen_id }} {
      flex-direction: column;
      width: 100%;
    }

    .ai-hero-slideshow__button-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-hero-slideshow__arrows-{{ ai_gen_id }} {
      padding: 0 10px;
    }

    .ai-hero-slideshow__arrow-{{ ai_gen_id }} {
      width: 40px;
      height: 40px;
    }

    .ai-hero-slideshow__arrow-{{ ai_gen_id }} svg {
      width: 20px;
      height: 20px;
    }
  }
{% endstyle %}

<hero-slideshow-{{ ai_gen_id }}
  class="ai-hero-slideshow-{{ ai_gen_id }} ai-hero-slideshow-{{ ai_gen_id }}--height-{{ block.settings.height_desktop }}-desktop ai-hero-slideshow-{{ ai_gen_id }}--height-{{ block.settings.height_mobile }}-mobile ai-hero-slideshow-{{ ai_gen_id }}--transition-{{ block.settings.transition_type }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-autoplay-speed="{{ block.settings.autoplay_speed | times: 1000 }}"
  data-pause-on-hover="{{ block.settings.pause_on_hover }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-hero-slideshow__slides-{{ ai_gen_id }}">
    {% for i in (1..5) %}
      {% liquid
        assign video_desktop_key = 'slide_' | append: i | append: '_video_desktop'
        assign video_mobile_key = 'slide_' | append: i | append: '_video_mobile'
        assign poster_key = 'slide_' | append: i | append: '_poster'
        assign eyebrow_key = 'slide_' | append: i | append: '_eyebrow'
        assign title_key = 'slide_' | append: i | append: '_title'
        assign subtitle_key = 'slide_' | append: i | append: '_subtitle'
        assign h_align_key = 'slide_' | append: i | append: '_h_align'
        assign v_align_key = 'slide_' | append: i | append: '_v_align'
        assign btn_primary_text_key = 'slide_' | append: i | append: '_btn_primary_text'
        assign btn_primary_link_key = 'slide_' | append: i | append: '_btn_primary_link'
        assign btn_secondary_text_key = 'slide_' | append: i | append: '_btn_secondary_text'
        assign btn_secondary_link_key = 'slide_' | append: i | append: '_btn_secondary_link'

        assign video_desktop = block.settings[video_desktop_key]
        assign video_mobile = block.settings[video_mobile_key]
        assign poster = block.settings[poster_key]
        assign eyebrow = block.settings[eyebrow_key]
        assign title = block.settings[title_key]
        assign subtitle = block.settings[subtitle_key]
        assign h_align = block.settings[h_align_key]
        assign v_align = block.settings[v_align_key]
        assign btn_primary_text = block.settings[btn_primary_text_key]
        assign btn_primary_link = block.settings[btn_primary_link_key]
        assign btn_secondary_text = block.settings[btn_secondary_text_key]
        assign btn_secondary_link = block.settings[btn_secondary_link_key]

        assign has_content = false
        if video_desktop != blank or video_mobile != blank
          assign has_content = true
        endif
      %}

      {% if has_content %}
        {% assign slide_index = forloop.index0 %}
        {% assign is_first = forloop.first %}
        
        <div 
          class="ai-hero-slideshow__slide-{{ ai_gen_id }} {% if is_first %}active{% endif %}"
          data-slide-index="{{ slide_index }}"
        >
          <div class="ai-hero-slideshow__video-container-{{ ai_gen_id }}">
            {% if video_mobile != blank %}
              <video
                class="ai-hero-slideshow__video-{{ ai_gen_id }} ai-hero-slideshow__video-mobile-{{ ai_gen_id }}"
                {% if poster %}poster="{{ poster | image_url: width: 1500 }}"{% endif %}
                muted
                loop
                playsinline
                {% if is_first %}autoplay{% else %}preload="none"{% endif %}
              >
                <source src="{{ video_mobile }}" type="video/mp4">
              </video>
            {% endif %}
            
            {% if video_desktop != blank %}
              <video
                class="ai-hero-slideshow__video-{{ ai_gen_id }} ai-hero-slideshow__video-desktop-{{ ai_gen_id }}"
                {% if poster %}poster="{{ poster | image_url: width: 2000 }}"{% endif %}
                muted
                loop
                playsinline
                {% if is_first %}autoplay{% else %}preload="none"{% endif %}
              >
                <source src="{{ video_desktop }}" type="video/mp4">
              </video>
            {% endif %}
          </div>

          <div class="ai-hero-slideshow__overlay-{{ ai_gen_id }}"></div>

          <div class="ai-hero-slideshow__content-{{ ai_gen_id }} ai-hero-slideshow__content-{{ ai_gen_id }}--align-{{ v_align }} ai-hero-slideshow__content-{{ ai_gen_id }}--justify-{{ h_align }}">
            <div class="ai-hero-slideshow__text-wrapper-{{ ai_gen_id }}">
              {% if eyebrow != blank %}
                <div class="ai-hero-slideshow__eyebrow-{{ ai_gen_id }}">
                  {{ eyebrow }}
                </div>
              {% endif %}

              {% if title != blank %}
                <h2 class="ai-hero-slideshow__title-{{ ai_gen_id }}">
                  {{ title }}
                </h2>
              {% endif %}

              {% if subtitle != blank %}
                <div class="ai-hero-slideshow__subtitle-{{ ai_gen_id }}">
                  {{ subtitle }}
                </div>
              {% endif %}

              {% if btn_primary_text != blank or btn_secondary_text != blank %}
                <div class="ai-hero-slideshow__buttons-{{ ai_gen_id }}">
                  {% if btn_primary_text != blank %}
                    <a 
                      href="{{ btn_primary_link | default: '#' }}"
                      class="ai-hero-slideshow__button-{{ ai_gen_id }} ai-hero-slideshow__button-{{ ai_gen_id }}--primary"
                    >
                      {{ btn_primary_text }}
                    </a>
                  {% endif %}

                  {% if btn_secondary_text != blank %}
                    <a 
                      href="{{ btn_secondary_link | default: '#' }}"
                      class="ai-hero-slideshow__button-{{ ai_gen_id }} ai-hero-slideshow__button-{{ ai_gen_id }}--secondary"
                    >
                      {{ btn_secondary_text }}
                    </a>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>

  {% if block.settings.show_arrows %}
    <div class="ai-hero-slideshow__arrows-{{ ai_gen_id }}">
      <button 
        class="ai-hero-slideshow__arrow-{{ ai_gen_id }} ai-hero-slideshow__arrow-prev-{{ ai_gen_id }}"
        aria-label="Diapositiva anterior"
      >
        <svg viewBox="0 0 24 24">
          <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
        </svg>
      </button>
      <button 
        class="ai-hero-slideshow__arrow-{{ ai_gen_id }} ai-hero-slideshow__arrow-next-{{ ai_gen_id }}"
        aria-label="Siguiente diapositiva"
      >
        <svg viewBox="0 0 24 24">
          <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
        </svg>
      </button>
    </div>
  {% endif %}

  {% if block.settings.show_dots %}
    <div class="ai-hero-slideshow__dots-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign video_desktop_key = 'slide_' | append: i | append: '_video_desktop'
          assign video_mobile_key = 'slide_' | append: i | append: '_video_mobile'
          assign video_desktop = block.settings[video_desktop_key]
          assign video_mobile = block.settings[video_mobile_key]
          
          assign has_content = false
          if video_desktop != blank or video_mobile != blank
            assign has_content = true
          endif
        %}
        
        {% if has_content %}
          <button 
            class="ai-hero-slideshow__dot-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
            data-slide-index="{{ forloop.index0 }}"
            aria-label="Ir a diapositiva {{ forloop.index }}"
          ></button>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</hero-slideshow-{{ ai_gen_id }}>

<script>
(function() {
  class HeroSlideshow{{ ai_gen_id }} extends HTMLElement {
    constructor() {
      super();
      this.currentSlide = 0;
      this.slides = [];
      this.videos = [];
      this.autoplayInterval = null;
      this.isTransitioning = false;
    }

    connectedCallback() {
      this.slides = Array.from(this.querySelectorAll('.ai-hero-slideshow__slide-{{ ai_gen_id }}'));
      this.videos = Array.from(this.querySelectorAll('.ai-hero-slideshow__video-{{ ai_gen_id }}'));
      this.dots = Array.from(this.querySelectorAll('.ai-hero-slideshow__dot-{{ ai_gen_id }}'));
      
      this.prevButton = this.querySelector('.ai-hero-slideshow__arrow-prev-{{ ai_gen_id }}');
      this.nextButton = this.querySelector('.ai-hero-slideshow__arrow-next-{{ ai_gen_id }}');
      
      this.autoplay = this.dataset.autoplay === 'true';
      this.autoplaySpeed = parseInt(this.dataset.autoplaySpeed) || 5000;
      this.pauseOnHover = this.dataset.pauseOnHover === 'true';

      this.setupEventListeners();
      
      if (this.autoplay && this.slides.length > 1) {
        this.startAutoplay();
      }

      this.loadCurrentSlideVideo();
    }

    setupEventListeners() {
      if (this.prevButton) {
        this.prevButton.addEventListener('click', () => this.previousSlide());
      }

      if (this.nextButton) {
        this.nextButton.addEventListener('click', () => this.nextSlide());
      }

      this.dots.forEach((dot, index) => {
        dot.addEventListener('click', () => this.goToSlide(index));
      });

      if (this.pauseOnHover && this.autoplay) {
        this.addEventListener('mouseenter', () => this.stopAutoplay());
        this.addEventListener('mouseleave', () => this.startAutoplay());
      }
    }

    loadCurrentSlideVideo() {
      const currentSlideElement = this.slides[this.currentSlide];
      if (!currentSlideElement) return;

      const videos = currentSlideElement.querySelectorAll('.ai-hero-slideshow__video-{{ ai_gen_id }}');
      videos.forEach(video => {
        if (video.readyState < 3) {
          video.load();
        }
        video.play().catch(() => {});
      });
    }

    pauseAllVideos() {
      this.videos.forEach(video => {
        video.pause();
      });
    }

    playCurrentSlideVideo() {
      const currentSlideElement = this.slides[this.currentSlide];
      if (!currentSlideElement) return;

      const videos = currentSlideElement.querySelectorAll('.ai-hero-slideshow__video-{{ ai_gen_id }}');
      videos.forEach(video => {
        video.play().catch(() => {});
      });
    }

    goToSlide(index) {
      if (this.isTransitioning || index === this.currentSlide || !this.slides[index]) return;
      
      this.isTransitioning = true;
      
      this.pauseAllVideos();

      this.slides[this.currentSlide].classList.remove('active');
      if (this.dots[this.currentSlide]) {
        this.dots[this.currentSlide].classList.remove('active');
      }

      this.currentSlide = index;

      this.slides[this.currentSlide].classList.add('active');
      if (this.dots[this.currentSlide]) {
        this.dots[this.currentSlide].classList.add('active');
      }

      this.loadCurrentSlideVideo();
      this.playCurrentSlideVideo();

      setTimeout(() => {
        this.isTransitioning = false;
      }, 600);
    }

    nextSlide() {
      const nextIndex = (this.currentSlide + 1) % this.slides.length;
      this.goToSlide(nextIndex);
    }

    previousSlide() {
      const prevIndex = (this.currentSlide - 1 + this.slides.length) % this.slides.length;
      this.goToSlide(prevIndex);
    }

    startAutoplay() {
      this.stopAutoplay();
      if (this.slides.length > 1) {
        this.autoplayInterval = setInterval(() => {
          this.nextSlide();
        }, this.autoplaySpeed);
      }
    }

    stopAutoplay() {
      if (this.autoplayInterval) {
        clearInterval(this.autoplayInterval);
        this.autoplayInterval = null;
      }
    }

    disconnectedCallback() {
      this.stopAutoplay();
      this.pauseAllVideos();
    }
  }

  customElements.define('hero-slideshow-{{ ai_gen_id }}', HeroSlideshow{{ ai_gen_id }});
})();
</script>

{% schema %}
{
  "name": "Hero slideshow video",
  "tag": null,
  "class": "hero-slideshow-block",
  "settings": [
    {
      "type": "header",
      "content": "Altura"
    },
    {
      "type": "select",
      "id": "height_desktop",
      "label": "Altura desktop",
      "options": [
        {
          "value": "small",
          "label": "Pequeña"
        },
        {
          "value": "medium",
          "label": "Mediana"
        },
        {
          "value": "large",
          "label": "Grande"
        },
        {
          "value": "fullscreen",
          "label": "Pantalla completa"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "height_mobile",
      "label": "Altura mobile",
      "options": [
        {
          "value": "small",
          "label": "Pequeña"
        },

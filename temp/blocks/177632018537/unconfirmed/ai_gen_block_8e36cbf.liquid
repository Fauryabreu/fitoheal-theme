{% doc %}
  @prompt
    Crea una sección Hero para Shopify con las siguientes especificaciones:
    
    MEDIA DE FONDO
    - Toggle en el schema para elegir entre "Imagen" o "Video" como fondo (select con opciones image/video)
    - Si es imagen: dos campos image_picker separados — "Imagen Desktop" y "Imagen Mobile" (no usar la misma imagen recortada con CSS, deben ser dos uploads independientes)
    - Si es video: campo video (Shopify video picker) o video_url para embed externo, con autoplay, loop, muted y sin controles
    - El media de fondo debe usar aspect-ratio CSS, no alto fijo en px:
      - Desktop (min-width: 750px): aspect-ratio: 1920 / 700
      - Mobile (max-width: 749px): aspect-ratio: 1080 / 1350
    - object-fit: cover en ambos casos para que no se deforme
    - Si no hay media cargado, fallback a un color de fondo sólido configurable
    
    CONTENIDO SOBRE EL MEDIA
    - Overlay opcional con opacidad configurable (range 0-100) para mejorar contraste del texto
    - Heading (richtext o texto simple)
    - Subheading/descripción (richtext)
    - Hasta 2 botones CTA, cada uno con texto, link y estilo (primary/secondary)
    - Control de alineación de texto: izquierda, centro, derecha (select)
    - Control de posición vertical del contenido: arriba, centro, abajo
    
    ESTRUCTURA TÉCNICA
    - Usar el prefijo de clases CSS fh-* (ej: fh-hero-media, fh-hero-content, fh-hero-overlay)
    - Schema completo con todos los campos editables desde el theme editor
    - Debe seguir la paleta de marca: verde oscuro #1B4332, verde medio #2D6A4F, verde claro #74C69D, crema #FAFDF8
    - Tipografía: Fraunces para el heading, DM Sans para subheading y botones
    - Mobile: el contenido debe poder leerse cómodamente dentro del espacio vertical 4:5 sin que el texto se corte
    
    NO HACER
    - No uses una sola imagen recortada por CSS para los dos breakpoints
    - No fijes alturas en px directamente, usa aspect-ratio
    - No quites la opción de fallback a color sólido si no hay media
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .fh-hero-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: block;
  }

  .fh-hero-media-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .fh-hero-media-{{ ai_gen_id }} {
      aspect-ratio: 1920 / 700;
    }
  }

  @media screen and (max-width: 749px) {
    .fh-hero-media-{{ ai_gen_id }} {
      aspect-ratio: 1080 / 1350;
    }
  }

  .fh-hero-image-{{ ai_gen_id }},
  .fh-hero-video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .fh-hero-fallback-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.fallback_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fh-hero-fallback-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
    opacity: 0.3;
  }

  .fh-hero-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});
    pointer-events: none;
  }

  .fh-hero-content-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    {% if block.settings.vertical_position == 'top' %}
      align-items: flex-start;
    {% elsif block.settings.vertical_position == 'bottom' %}
      align-items: flex-end;
    {% else %}
      align-items: center;
    {% endif %}
    justify-content: center;
    padding: 40px 20px;
  }

  @media screen and (max-width: 749px) {
    .fh-hero-content-wrapper-{{ ai_gen_id }} {
      padding: 30px 16px;
    }
  }

  .fh-hero-content-{{ ai_gen_id }} {
    max-width: 800px;
    width: 100%;
    text-align: {{ block.settings.text_alignment }};
    z-index: 1;
  }

  .fh-hero-heading-{{ ai_gen_id }} {
    font-family: 'Fraunces', serif;
    color: {{ block.settings.heading_color }};
    font-size: 56px;
    line-height: 1.2;
    margin: 0 0 20px;
    font-weight: 700;
  }

  @media screen and (max-width: 749px) {
    .fh-hero-heading-{{ ai_gen_id }} {
      font-size: 36px;
      margin: 0 0 16px;
    }
  }

  .fh-hero-subheading-{{ ai_gen_id }} {
    font-family: 'DM Sans', sans-serif;
    color: {{ block.settings.subheading_color }};
    font-size: 18px;
    line-height: 1.6;
    margin: 0 0 30px;
  }

  @media screen and (max-width: 749px) {
    .fh-hero-subheading-{{ ai_gen_id }} {
      font-size: 16px;
      margin: 0 0 24px;
    }
  }

  .fh-hero-buttons-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    {% if block.settings.text_alignment == 'center' %}
      justify-content: center;
    {% elsif block.settings.text_alignment == 'right' %}
      justify-content: flex-end;
    {% else %}
      justify-content: flex-start;
    {% endif %}
  }

  .fh-hero-button-{{ ai_gen_id }} {
    font-family: 'DM Sans', sans-serif;
    padding: 14px 32px;
    font-size: 16px;
    text-decoration: none;
    border-radius: 4px;
    display: inline-block;
    transition: all 0.3s ease;
    font-weight: 500;
    border: 2px solid transparent;
  }

  @media screen and (max-width: 749px) {
    .fh-hero-button-{{ ai_gen_id }} {
      padding: 12px 24px;
      font-size: 14px;
    }
  }

  .fh-hero-button-primary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_1_bg_color }};
    color: {{ block.settings.button_1_text_color }};
  }

  .fh-hero-button-primary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_1_bg_color | color_darken: 10 }};
  }

  .fh-hero-button-secondary-{{ ai_gen_id }} {
    background-color: transparent;
    color: {{ block.settings.button_2_text_color }};
    border-color: {{ block.settings.button_2_text_color }};
  }

  .fh-hero-button-secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_2_text_color }};
    color: {{ block.settings.button_2_bg_color }};
  }

  .fh-hero-mobile-only-{{ ai_gen_id }} {
    display: none;
  }

  .fh-hero-desktop-only-{{ ai_gen_id }} {
    display: block;
  }

  @media screen and (max-width: 749px) {
    .fh-hero-mobile-only-{{ ai_gen_id }} {
      display: block;
    }

    .fh-hero-desktop-only-{{ ai_gen_id }} {
      display: none;
    }
  }
{% endstyle %}

<fh-hero-{{ ai_gen_id }} class="fh-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="fh-hero-media-{{ ai_gen_id }}">
    {% if block.settings.media_type == 'image' %}
      {% if block.settings.image_desktop != blank %}
        <img
          src="{{ block.settings.image_desktop | image_url: width: 1920 }}"
          srcset="{{ block.settings.image_desktop | image_url: width: 750 }} 750w,
                  {{ block.settings.image_desktop | image_url: width: 1100 }} 1100w,
                  {{ block.settings.image_desktop | image_url: width: 1500 }} 1500w,
                  {{ block.settings.image_desktop | image_url: width: 1920 }} 1920w"
          sizes="100vw"
          alt="{{ block.settings.image_desktop.alt | escape }}"
          loading="eager"
          width="{{ block.settings.image_desktop.width }}"
          height="{{ block.settings.image_desktop.height }}"
          class="fh-hero-image-{{ ai_gen_id }} fh-hero-desktop-only-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="fh-hero-fallback-{{ ai_gen_id }} fh-hero-desktop-only-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
        </div>
      {% endif %}

      {% if block.settings.image_mobile != blank %}
        <img
          src="{{ block.settings.image_mobile | image_url: width: 1080 }}"
          srcset="{{ block.settings.image_mobile | image_url: width: 375 }} 375w,
                  {{ block.settings.image_mobile | image_url: width: 750 }} 750w,
                  {{ block.settings.image_mobile | image_url: width: 1080 }} 1080w"
          sizes="100vw"
          alt="{{ block.settings.image_mobile.alt | escape }}"
          loading="eager"
          width="{{ block.settings.image_mobile.width }}"
          height="{{ block.settings.image_mobile.height }}"
          class="fh-hero-image-{{ ai_gen_id }} fh-hero-mobile-only-{{ ai_gen_id }}"
        >
      {% elsif block.settings.image_desktop != blank %}
        <img
          src="{{ block.settings.image_desktop | image_url: width: 1080 }}"
          srcset="{{ block.settings.image_desktop | image_url: width: 375 }} 375w,
                  {{ block.settings.image_desktop | image_url: width: 750 }} 750w,
                  {{ block.settings.image_desktop | image_url: width: 1080 }} 1080w"
          sizes="100vw"
          alt="{{ block.settings.image_desktop.alt | escape }}"
          loading="eager"
          width="{{ block.settings.image_desktop.width }}"
          height="{{ block.settings.image_desktop.height }}"
          class="fh-hero-image-{{ ai_gen_id }} fh-hero-mobile-only-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="fh-hero-fallback-{{ ai_gen_id }} fh-hero-mobile-only-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
    {% elsif block.settings.media_type == 'video' %}
      {% if block.settings.video != blank %}
        {{
          block.settings.video
          | video_tag:
            image_size: '1920x',
            autoplay: true,
            loop: true,
            muted: true,
            controls: false,
            class: 'fh-hero-video-' | append: ai_gen_id
        }}
      {% elsif block.settings.video_url != blank %}
        {% if block.settings.video_url.type == 'youtube' %}
          <iframe
            src="https://www.youtube.com/embed/{{ block.settings.video_url.id }}?autoplay=1&mute=1&loop=1&playlist={{ block.settings.video_url.id }}&controls=0&showinfo=0&rel=0&modestbranding=1"
            class="fh-hero-video-{{ ai_gen_id }}"
            frameborder="0"
            allow="autoplay; encrypted-media"
            allowfullscreen
            title="Hero video"
          ></iframe>
        {% elsif block.settings.video_url.type == 'vimeo' %}
          <iframe
            src="https://player.vimeo.com/video/{{ block.settings.video_url.id }}?autoplay=1&muted=1&loop=1&background=1&controls=0"
            class="fh-hero-video-{{ ai_gen_id }}"
            frameborder="0"
            allow="autoplay; fullscreen"
            allowfullscreen
            title="Hero video"
          ></iframe>
        {% endif %}
      {% else %}
        <div class="fh-hero-fallback-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
    {% else %}
      <div class="fh-hero-fallback-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}

    {% if block.settings.show_overlay %}
      <div class="fh-hero-overlay-{{ ai_gen_id }}"></div>
    {% endif %}
  </div>

  <div class="fh-hero-content-wrapper-{{ ai_gen_id }}">
    <div class="fh-hero-content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h1 class="fh-hero-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <div class="fh-hero-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
      {% endif %}

      {% if block.settings.button_1_text != blank or block.settings.button_2_text != blank %}
        <div class="fh-hero-buttons-{{ ai_gen_id }}">
          {% if block.settings.button_1_text != blank %}
            <a
              href="{{ block.settings.button_1_link }}"
              class="fh-hero-button-{{ ai_gen_id }} fh-hero-button-primary-{{ ai_gen_id }}"
            >
              {{ block.settings.button_1_text }}
            </a>
          {% endif %}

          {% if block.settings.button_2_text != blank %}
            <a
              href="{{ block.settings.button_2_link }}"
              class="fh-hero-button-{{ ai_gen_id }} fh-hero-button-secondary-{{ ai_gen_id }}"
            >
              {{ block.settings.button_2_text }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</fh-hero-{{ ai_gen_id }}>

<script>
  (function() {
    class FhHero{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const video = this.querySelector('.fh-hero-video-{{ ai_gen_id }}');
        if (video && video.tagName === 'VIDEO') {
          video.play().catch(() => {});
        }
      }
    }

    customElements.define('fh-hero-{{ ai_gen_id }}', FhHero{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Hero FitoHeal",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Media de fondo"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Tipo de media",
      "options": [
        {
          "value": "image",
          "label": "Imagen"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Imagen desktop"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Imagen mobile"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (Shopify)"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Video URL (YouTube o Vimeo)",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "color",
      "id": "fallback_color",
      "label": "Color de fondo fallback",
      "default": "#2D6A4F"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Mostrar overlay",
      "default": true
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Opacidad del overlay",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Título",
      "default": "<p>Bienvenido a FitoHeal</p>"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color del título",
      "default": "#FAFDF8"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "<p>Descubre el poder de la naturaleza para tu bienestar</p>"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Color del subtítulo",
      "default": "#FAFDF8"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alineación del texto",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "vertical_position",
      "label": "Posición vertical",
      "options": [
        {
          "value": "top",
          "label": "Arriba"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "bottom",
          "label": "Abajo"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Botón 1"
    },
    {
      "type": "text",
      "id": "button_1_text",
      "label": "Texto del botón",
      "default": "Explorar productos"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Enlace del botón"
    },
    {
      "type": "color",
      "id": "button_1_bg_color",
      "label": "Color de fondo",
      "default": "#74C69D"
    },
    {
      "type": "color",
      "id": "button_1_text_color",
      "label": "Color del texto",
      "default": "#1B4332"
    },
    {
      "type": "header",
      "content": "Botón 2"
    },
    {
      "type": "text",
      "id": "button_2_text",
      "label": "Texto del botón",
      "default": "Saber más"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Enlace del botón"
    },
    {
      "type": "color",
      "id": "button_2_bg_color",
      "label": "Color de fondo hover",
      "default": "#FAFDF8"
    },
    {
      "type": "color",
      "id": "button_2_text_color",
      "label": "Color del texto",
      "default": "#FAFDF8"
    }
  ],
  "presets": [
    {
      "name": "Hero FitoHeal"
    }
  ]
}
{% endschema %}

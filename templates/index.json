        "faq_item_NMUmjw": {
          "type": "faq_item",
          "settings": {
            "question": "<strong>¿Qué hace diferente a Fitoheal?</strong>",
            "answer": "<p>Fitoheal no se enfoca solo en ingredientes. Sus fórmulas liposomales están pensadas para apoyar objetivos concretos como descanso, digestión, enfoque, metabolismo y bienestar físico.</p>"
          }
        },
        "faq_item_piUwNz": {
